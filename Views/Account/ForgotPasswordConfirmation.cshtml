@{
    ViewData["Title"] = "Kiểm tra email của bạn";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">

        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body px-4 py-5 px-sm-5 text-center">

                <div class="mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor"
                         class="bi bi-envelope-check text-success mb-3" viewBox="0 0 16 16">
                        <path d="M2 2a2 2 0 0 0-2 2v8.01A2 2 0 0 0 2 14h5.5a.5.5 0 0 0 0-1H2a1 1 0 0 1-.966-.741l5.64-3.471L8 9.583l7-4.29V8.5a.5.5 0 0 0 1 0V4a2 2 0 0 0-2-2H2Zm3.708 6.208L1 11.105V5.383l4.708 2.825ZM1 4.217V4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v.217l-7 4.29-7-4.29Z"/>
                        <path d="M16 12.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Zm-1.993-1.679a.5.5 0 0 0-.686.172l-1.17 1.95-.547-.547a.5.5 0 0 0-.708.708l.774.773a.75.75 0 0 0 1.174-.144l1.335-2.226a.5.5 0 0 0-.172-.686Z"/>
                    </svg>
                    <h2 class="h4 fw-bold">Kiểm tra email của bạn!</h2>
                </div>

                <div class="alert alert-success border-0 text-start" role="alert">
                    <p class="mb-2">
                        Nếu email bạn nhập đã được đăng ký, chúng tôi đã gửi <strong>link đặt lại mật khẩu</strong>
                        vào hộp thư của bạn.
                    </p>
                    <p class="mb-0 small text-muted">
                        ⏱ Link có hiệu lực trong <strong>30 phút</strong> và chỉ sử dụng được <strong>1 lần</strong>.
                        Nếu không thấy email, hãy kiểm tra thư mục Spam/Rác.
                    </p>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <a asp-area="Identity" asp-page="/Account/Login"
                       class="btn btn-primary btn-lg fw-semibold">
                        Đăng nhập
                    </a>
                    <a asp-action="ForgotPassword" asp-controller="Account"
                       class="btn btn-outline-secondary">
                        Gửi lại email
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>
