@model IReadOnlyList<Appointment>
@{
    ViewData["Title"] = "Lịch hẹn trong ngày";
    var selectedDate = (string)ViewBag.SelectedDate;
}
<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div><p class="text-uppercase text-secondary small mb-1">Vận hành salon</p><h1 class="h3 mb-0">Lịch hẹn trong ngày</h1></div>
 codex/sprint-4-todo
        <form method="get" class="d-flex align-items-end gap-2"><label class="form-label mb-0">Ngày<input class="form-control" type="date" name="date" value="@selectedDate" /></label><button class="btn btn-outline-secondary">Xem</button></form>

        <form method="get" class="d-flex align-items-end gap-2"><label class="form-label mb-0">Ngày<input class="form-control" type="date" name="date" value="@selectedDate" /></label>@if (ViewBag.SelectedStatus is string status) { <input type="hidden" name="status" value="@status" /> }<button class="btn btn-outline-secondary">Xem</button></form>
 develop
    </div>
    @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
    @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
    <div class="table-responsive bg-white border rounded-3"><table class="table align-middle mb-0">
        <thead><tr><th>Giờ</th><th>Khách hàng</th><th>Thợ</th><th>Dịch vụ</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
        @foreach (var appointment in Model)
        {
            <tr><td>@appointment.StartTime.ToString(@"hh\:mm")</td><td>@appointment.Customer.FullName<span class="d-block small text-secondary">@(User.IsInRole(UserRoles.Stylist) ? MaskPhone(appointment.Customer.Phone) : appointment.Customer.Phone)</span></td><td>@appointment.Stylist.FullName</td><td>@string.Join(", ", appointment.AppointmentServices.Select(item => item.Service.ServiceName))</td><td>@appointment.Status</td><td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@appointment.AppointmentId">Mở lịch</a>
                @if (appointment.Invoice is not null && appointment.Invoice.ClosedAt is null)
                {
                    var servicesComplete = appointment.AppointmentServices.Count > 0 && appointment.AppointmentServices.All(item => item.IsCompleted);
                    var canClose = appointment.Invoice.Status == "Paid" && servicesComplete;
                    var blockers = new List<string>();
                    if (!servicesComplete) blockers.Add("Thợ chưa hoàn tất dịch vụ");
                    if (appointment.Invoice.Status != "Paid") blockers.Add("Phiếu chưa thanh toán");
                    <form asp-controller="Invoices" asp-action="Close" method="post" class="d-inline ms-1">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@appointment.Invoice.InvoiceId" /><button class="btn btn-sm btn-outline-secondary" type="submit" disabled="@(!canClose)">Đóng lịch</button></form>
                    @if (!canClose) { <span class="d-block small text-secondary mt-1">@string.Join("; ", blockers)</span> }
                }
            </td></tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-secondary py-5">Không có lịch hẹn trong ngày này.</td></tr> }
        </tbody>
    </table></div>
</div>
@functions {
    string MaskPhone(string phone) => phone.Length < 5 ? "••••" : phone[..Math.Min(3, phone.Length)] + new string('•', Math.Max(0, phone.Length - 5)) + phone[^2..];
}
