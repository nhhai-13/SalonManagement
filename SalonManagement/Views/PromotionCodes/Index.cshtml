@{ ViewData["Title"] = "Mã giảm giá"; }
<main id="promotion-content" class="container py-4 d-none">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><span class="text-uppercase text-primary small fw-bold">Khuyến mãi</span><h1 class="h3 mb-1">Mã giảm giá</h1><p class="text-muted mb-0">Tạo mã giảm theo phần trăm hoặc số tiền; mã chỉ áp dụng khi còn hiệu lực.</p></div></div>
    <div class="row g-4"><section class="col-lg-5"><div class="card shadow-sm border-0"><div class="card-body p-4"><h2 class="h5">Tạo mã mới</h2><form id="promotion-form"><div class="mb-3"><label class="form-label" for="promotion-code">Mã giảm giá</label><input id="promotion-code" class="form-control text-uppercase" maxlength="64" required placeholder="SUMMER10" /></div><div class="mb-3"><label class="form-label" for="promotion-name">Tên chương trình</label><input id="promotion-name" class="form-control" maxlength="160" required placeholder="Khuyến mãi Hè 2026" /></div><div class="row g-2"><div class="col-sm-6"><label class="form-label" for="promotion-type">Kiểu giảm</label><select id="promotion-type" class="form-select"><option value="Percentage">Phần trăm (%)</option><option value="FixedAmount">Số tiền (đ)</option></select></div><div class="col-sm-6"><label class="form-label" for="promotion-value">Giá trị</label><input id="promotion-value" class="form-control" type="number" min="1" step="1" required /></div></div><div class="row g-2 mt-1"><div class="col-sm-6"><label class="form-label" for="promotion-start">Ngày bắt đầu</label><input id="promotion-start" class="form-control" type="date" required /></div><div class="col-sm-6"><label class="form-label" for="promotion-end">Ngày kết thúc</label><input id="promotion-end" class="form-control" type="date" required /></div></div><p id="promotion-message" class="small mt-3 mb-0 d-none" role="status"></p><button class="btn btn-primary w-100 mt-3" type="submit"><i class="bi bi-plus-circle"></i> Tạo mã giảm giá</button></form></div></div></section>
    <section class="col-lg-7"><div class="card shadow-sm border-0"><div class="card-body p-0"><div class="p-4 border-bottom"><h2 class="h5 mb-0">Danh sách mã</h2></div><div id="promotion-list" class="list-group list-group-flush"><div class="p-4 text-muted">Đang tải mã giảm giá…</div></div></div></div></section></div>
</main>
@section Scripts { <script src="~/js/auth.js" asp-append-version="true"></script><script src="~/js/promotion-codes.js" asp-append-version="true"></script><script>SalonAuth.requireSession({ endpoint: "/api/owner/session", contentId: "promotion-content" }).then(() => PromotionCodes.start());</script> }
