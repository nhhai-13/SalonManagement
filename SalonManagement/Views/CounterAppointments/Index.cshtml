@using SalonManagement.Models
@{
    ViewData["Title"] = "Đặt lịch tại quầy";
    var services = (IReadOnlyList<Service>)ViewBag.Services;
    var stylists = (IReadOnlyList<Stylist>)ViewBag.Stylists;
    var embedded = ViewData["Embed"] is true;
    if (embedded) { Layout = null; }
}
@if (embedded)
{
    <head><meta name="viewport" content="width=device-width, initial-scale=1" /><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" /><link rel="stylesheet" href="~/css/salon-design.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
}
<div class="container py-3 counter-appointment-page" style="max-width:760px">
    <div class="d-flex align-items-start justify-content-between gap-3 mb-3"><div><span class="text-uppercase text-muted small fw-semibold">Lễ tân</span><h1 class="h4 mb-1">Đặt lịch tại quầy &amp; nhận khách vãng lai</h1><p class="text-muted small mb-0">Tìm khách theo số điện thoại, sau đó chọn dịch vụ, thợ và thời gian.</p></div>@if (!embedded) { <a class="btn btn-outline-secondary btn-sm" href="/reception">Quay lại</a> }</div>
    <div id="message" class="alert d-none"></div>
    <div id="customer-history" class="alert alert-info d-none"></div>
    <section id="name-conflict" class="card border-warning mb-3 d-none" aria-live="polite"><div class="card-body"><h2 class="h6 text-warning-emphasis">Tên khác với hồ sơ khách</h2><p class="mb-2">Hồ sơ: <strong id="profile-name"></strong><br />Tên vừa nhập: <strong id="entered-name"></strong></p><div class="d-flex flex-wrap gap-2"><button type="button" class="btn btn-outline-secondary btn-sm" data-name-resolution="KeepProfile">Giữ tên hồ sơ</button><button type="button" class="btn btn-primary btn-sm" data-name-resolution="UpdateProfile">Cập nhật hồ sơ</button><button type="button" class="btn btn-outline-primary btn-sm" data-name-resolution="UseForThisAppointment">Chỉ dùng lịch này</button></div></div></section>
    <form id="counter-form" class="row g-3">
        <div class="col-12 position-relative"><label class="form-label" for="phone">Số điện thoại / tìm khách</label><div class="input-group"><span class="input-group-text"><i class="bi bi-telephone"></i></span><input id="phone" class="form-control" autocomplete="off" required /></div><div id="customer-suggestions" class="list-group position-absolute start-0 end-0 mx-2 d-none" style="z-index:10"></div></div>
        <div class="col-md-6"><label class="form-label" for="name">Tên khách</label><input id="name" class="form-control" required /></div>
        <div class="col-md-6"><label class="form-label" for="email">Email</label><input id="email" type="email" class="form-control" /></div>
        <div class="col-md-6"><label class="form-label" for="services">Dịch vụ</label><select id="services" class="form-select" multiple required size="4">@foreach (var service in services) { <option value="@service.ServiceId">@service.ServiceName · @service.Price.ToString("N0") đ</option> }</select></div>
        <div class="col-md-6"><label class="form-label" for="stylist">Thợ</label><select id="stylist" class="form-select" required><option value="">Chọn thợ</option>@foreach (var stylist in stylists) { <option value="@stylist.StylistId">@stylist.FullName</option> }</select></div>
        <div class="col-md-6"><label class="form-label" for="date">Ngày</label><input id="date" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
        <div class="col-md-6"><label class="form-label" for="time">Giờ bắt đầu</label><input id="time" type="time" step="900" class="form-control" required /></div>
        <div class="col-12"><div class="form-check border rounded p-2 ps-5"><input id="instant-start" class="form-check-input" type="checkbox" /><label class="form-check-label" for="instant-start"><strong>Khách làm ngay tại quầy</strong><br /><span class="small text-muted">Tạo lịch đã xác nhận từ nguồn tại quầy, không yêu cầu đặt trước 60 phút.</span></label></div></div>
        <div class="col-12 d-flex justify-content-end gap-2"><button class="btn btn-light" type="reset">Nhập lại</button><button class="btn btn-primary" type="submit"><i class="bi bi-lightning-charge"></i> Tạo lịch hẹn</button></div>
    </form>
</div>
<script src="~/js/auth.js" asp-append-version="true"></script>
<script>
    const phoneEl = document.getElementById('phone'), nameEl = document.getElementById('name'), emailEl = document.getElementById('email'), servicesEl = document.getElementById('services'), stylistEl = document.getElementById('stylist'), historyEl = document.getElementById('customer-history'), conflictEl = document.getElementById('name-conflict'), messageEl = document.getElementById('message'), suggestionsEl = document.getElementById('customer-suggestions');
    const embedded = @embedded.ToString().ToLowerInvariant();
    let lookupTimer;
    if (!document.getElementById('time').value) document.getElementById('time').value = new Date().toTimeString().slice(0, 5);
    const fetchWithSession = (url, options) => SalonAuth.authenticatedFetch(url, options);
    const escapeHtml = value => String(value ?? '').replace(/[&<>'"]/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char]));
    async function loadCustomer() {
        const response = await fetchWithSession(`/reception/counter-appointments/customer?phone=${encodeURIComponent(phoneEl.value)}`);
        const customer = await response.json().catch(() => ({}));
        if (!response.ok || !customer.found) { historyEl.classList.add('d-none'); return; }
        nameEl.value = customer.fullName; emailEl.value = customer.email || '';
        historyEl.innerHTML = `<strong><i class="bi bi-star-fill text-warning"></i> Khách quen: ${escapeHtml(customer.fullName)}</strong><br><span>Đã đến ${customer.visitCount} lần · Không đến ${customer.noShowCount} lần${customer.shopNotes ? ` · ${escapeHtml(customer.shopNotes)}` : ''}</span>${customer.noShowCount ? '<div class="text-danger mt-1">Cảnh báo: khách có lịch sử không đến.</div>' : ''}`;
        historyEl.classList.remove('d-none');
    }
    phoneEl.addEventListener('input', () => { clearTimeout(lookupTimer); const value = phoneEl.value.trim(); suggestionsEl.classList.add('d-none'); if (value.length < 2) return; lookupTimer = setTimeout(async () => { const response = await fetchWithSession(`/reception/counter-appointments/customers?query=${encodeURIComponent(value)}`); const rows = await response.json().catch(() => []); if (!response.ok || !rows.length) return; suggestionsEl.innerHTML = rows.map(row => `<button type="button" class="list-group-item list-group-item-action" data-customer-phone="${escapeHtml(row.phone)}"><strong>${escapeHtml(row.fullName)}</strong> <small class="text-muted">${escapeHtml(row.phone)}</small><br><small>Đã đến ${row.visitCount} lần · Không đến ${row.noShowCount} lần</small></button>`).join(''); suggestionsEl.classList.remove('d-none'); suggestionsEl.querySelectorAll('[data-customer-phone]').forEach(button => button.addEventListener('click', async () => { phoneEl.value = button.dataset.customerPhone; suggestionsEl.classList.add('d-none'); await loadCustomer(); })); }, 220); });
    phoneEl.addEventListener('change', loadCustomer);
    async function createAppointment(nameConflictResolution = null) { const body = { fullName: nameEl.value, phone: phoneEl.value, email: emailEl.value || null, serviceIds: [...servicesEl.selectedOptions].map(option => +option.value), stylistId: +stylistEl.value, date: document.getElementById('date').value, startTime: `${document.getElementById('time').value}:00`, nameConflictResolution, instantStart: document.getElementById('instant-start').checked }; const response = await fetchWithSession('/reception/counter-appointments/create', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }); const result = await response.json().catch(() => ({})); if (response.status === 409 && result.code === 'name_conflict') { document.getElementById('profile-name').textContent = result.profileName; document.getElementById('entered-name').textContent = result.enteredName; conflictEl.classList.remove('d-none'); return; } messageEl.textContent = result.error || result.message; messageEl.className = `alert ${response.ok ? 'alert-success' : 'alert-danger'}`; if (response.ok) { if (embedded && window.parent !== window) window.parent.postMessage({ type: 'counter-appointment-created' }, window.location.origin); else setTimeout(() => location.href = result.redirect, 500); } }
    document.getElementById('counter-form').addEventListener('submit', async event => { event.preventDefault(); conflictEl.classList.add('d-none'); await createAppointment(); });
    document.querySelectorAll('[data-name-resolution]').forEach(button => button.addEventListener('click', () => createAppointment(button.dataset.nameResolution)));
</script>
