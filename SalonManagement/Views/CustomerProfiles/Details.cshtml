@model SalonManagement.Models.CustomerProfileDetailsViewModel
@{ ViewData["Title"] = "Hồ sơ khách hàng"; }
<div class="container py-4" style="max-width:900px">
    <a class="btn btn-outline-secondary btn-sm mb-3" href="/reception/customer-search">Quay lại danh sách hồ sơ</a>
    <h1 class="h3">@Model.Customer.FullName</h1>
    <dl class="row"><dt class="col-sm-3">Số điện thoại</dt><dd class="col-sm-9">@Model.Customer.Phone</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@(Model.Customer.Email ?? "Chưa có")</dd></dl>
    <div class="row g-3 mb-4"><div class="col-sm-6"><div class="border rounded p-3 bg-light"><div class="text-muted small">Số lần đã đến</div><strong class="fs-3">@Model.VisitCount</strong></div></div><div class="col-sm-6"><div class="border rounded p-3 bg-light"><div class="text-muted small">Số lần không đến</div><strong class="fs-3">@Model.NoShowCount</strong></div></div></div>
    <section class="mb-4"><h2 class="h5">Ghi chú riêng của tiệm</h2><textarea id="shop-notes" class="form-control" maxlength="500" rows="3" placeholder="Ví dụ: thích thợ Minh, dị ứng thuốc nhuộm">@Model.ShopNotes</textarea><div class="d-flex justify-content-between mt-1"><small class="text-muted">Tối đa 500 ký tự. Chỉ Lễ tân có quyền sửa.</small><button id="save-shop-notes" type="button" class="btn btn-primary btn-sm">Lưu ghi chú</button></div><div id="shop-notes-message" class="small mt-2" role="status"></div></section>
    <h2 class="h5 mt-4">Lịch hẹn</h2>
    <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Ngày giờ</th><th>Dịch vụ</th><th>Thợ</th><th>Trạng thái</th></tr></thead><tbody>
    @foreach (var appointment in Model.Customer.Appointments.OrderByDescending(item => item.AppointmentDate).ThenByDescending(item => item.StartTime))
    { <tr><td>@appointment.AppointmentDate.ToString("dd/MM/yyyy") @appointment.StartTime.ToString(@"hh\:mm")–@appointment.EndTime.ToString(@"hh\:mm")</td><td>@string.Join(", ", appointment.AppointmentServices.Select(item => item.Service.ServiceName))</td><td>@appointment.Stylist.FullName</td><td>@appointment.Status<br /><small class="text-muted">@(appointment.BookingSource == "Online" ? "Đặt online" : appointment.BookingSource == "Counter" ? "Tại quầy" : "Dữ liệu cũ")</small>@if (appointment.NameConflictResolution is not null) { <br /><small class="@(appointment.NameConflictResolution == "PendingReceptionReview" ? "text-warning fw-semibold" : "text-muted")">@(appointment.NameConflictResolution switch { "KeepProfile" => "Đã chọn giữ tên hồ sơ", "UpdateProfile" => "Đã chọn cập nhật tên hồ sơ", "UseForThisAppointment" => "Chỉ dùng tên mới cho lịch này: " + appointment.CustomerNameOverride, "PendingReceptionReview" => "Tên khác hồ sơ – chờ Lễ tân chọn", _ => appointment.NameConflictResolution })</small> }</td></tr> }
    </tbody></table></div>
</div>
@section Scripts {<script>document.getElementById('save-shop-notes').addEventListener('click',async()=>{const button=document.getElementById('save-shop-notes'),message=document.getElementById('shop-notes-message');button.disabled=true;const response=await fetch('/reception/customers/@Model.Customer.CustomerId/shop-notes',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({notes:document.getElementById('shop-notes').value})});const body=await response.json();message.textContent=body.message||body.error||'Không thể lưu ghi chú.';message.className='small mt-2 '+(response.ok?'text-success':'text-danger');button.disabled=false})</script>}
