@model IEnumerable<SalonManagement.Models.AuditLog>

@{
    ViewData["Title"] = "Audit Logs";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string? fromDate = ViewBag.FromDate;
    string? toDate = ViewBag.ToDate;
    string? selectedUser = ViewBag.UserName;
    var userNames = ViewBag.UserNames as List<string> ?? new List<string>();
}

<div class="container py-4">

    <div class="sl-page-header mb-4">
        <h2 class="sl-page-title h2">Audit Logs</h2>
    </div>

    <div class="sl-card p-4 mb-4 shadow-sm">
        <!-- Bộ lọc -->
        <form method="get" asp-action="Index" class="row g-3">

            <div class="col-md-3">
                <label class="form-label fw-semibold">Từ ngày</label>
                <input type="date"
                       name="fromDate"
                       value="@fromDate"
                       class="form-control sl-input" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">Đến ngày</label>
                <input type="date"
                       name="toDate"
                       value="@toDate"
                       class="form-control sl-input" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">Tài khoản</label>

                <select name="userName" class="form-select sl-input">
                    <option value="">-- Tất cả tài khoản --</option>

                    @foreach (var user in userNames)
                    {
                        if (user == selectedUser)
                        {
                            <option value="@user" selected>@user</option>
                        }
                        else
                        {
                            <option value="@user">@user</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary sl-btn sl-btn-primary flex-grow-1">
                    Lọc
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary sl-btn">
                    Xóa
                </a>
            </div>

        </form>
    </div>

    <!-- Bảng Audit Log -->
    <div class="sl-card shadow-sm overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table sl-table mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Thời gian</th>
                        <th>Tài khoản</th>
                        <th>Hành động</th>
                        <th>Loại đối tượng</th>
                        <th>ID đối tượng</th>
                        <th>Thay đổi</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Không có dữ liệu
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var log in Model)
                        {
                            <tr>
                                <td class="fw-medium">@log.AuditLogId</td>

                                <td>
                                    @log.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(string.IsNullOrEmpty(log.UserName)
                                            ? "System"
                                            : log.UserName)
                                    </span>
                                </td>

                                <td>
                                    @log.Action
                                </td>

                                <td>
                                    @log.EntityType
                                </td>

                                <td>
                                    @log.EntityId
                                </td>

                                <td>
                                    <details>
                                        <summary class="text-primary cursor-pointer">Xem chi tiết</summary>
                                        <pre class="mt-2 p-2 bg-light rounded small"
                                             style="white-space: pre-wrap; max-width: 400px; font-family: monospace;">@log.Changes</pre>
                                    </details>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Phân trang -->
    <div class="d-flex justify-content-between align-items-center">
        <p class="text-muted small mb-0">
            Chỉ xem nhật ký hoạt động. Không thể chỉnh sửa hoặc xóa.
        </p>
        
        @if (totalPages > 1)
        {
            <nav aria-label="Audit log pagination">
                <ul class="pagination mb-0">
                    @if (currentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(currentPage - 1)"
                               asp-route-fromDate="@fromDate"
                               asp-route-toDate="@toDate"
                               asp-route-userName="@selectedUser">
                                Trước
                            </a>
                        </li>
                    }

                    <li class="page-item active">
                        <span class="page-link">
                            Trang @currentPage / @totalPages
                        </span>
                    </li>

                    @if (currentPage < totalPages)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(currentPage + 1)"
                               asp-route-fromDate="@fromDate"
                               asp-route-toDate="@toDate"
                               asp-route-userName="@selectedUser">
                                Sau
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>

</div>
