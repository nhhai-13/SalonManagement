@{ ViewData["Title"] = "Tra cứu lịch hẹn"; }
<div class="container py-4" style="max-width:600px; margin: 0 auto;">
    <div class="sl-card sl-lookup-card p-4">
        <div class="sl-eyebrow mb-2">Dịch vụ khách hàng</div>
        <h1 class="sl-page-title h3 mb-3">Tra cứu lịch hẹn</h1>
        <p class="text-muted mb-4">Nhập mã lịch hẹn 8 ký tự hoặc số điện thoại.</p>
        
        <form id="lookup-form">
            <div class="sl-input-wrap d-flex gap-2">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input id="lookup-query" class="form-control sl-input" placeholder="Mã lịch hẹn hoặc SĐT" required />
                    <button class="btn btn-primary sl-btn sl-btn-primary" type="submit">Tra cứu</button>
                </div>
            </div>
        </form>

        <div id="lookup-message" class="sl-alert mt-3"></div>
        <div id="lookup-list" class="mt-3"></div>
    </div>
</div>

@section Scripts {
    <script>const form=document.getElementById('lookup-form'),query=document.getElementById('lookup-query'),message=document.getElementById('lookup-message'),list=document.getElementById('lookup-list');form.addEventListener('submit',async e=>{e.preventDefault();const r=await fetch(`/appointments/lookup/search?query=${encodeURIComponent(query.value)}`),d=await r.json();list.replaceChildren();message.textContent=d.error||'';message.className=d.error?'alert alert-info mt-3':'mt-3';if(!d.error)list.replaceChildren(...d.appointments.map(a=>{const item=document.createElement('article');item.className='card mb-2 sl-appointment-item';item.innerHTML=`<div class="card-body"><strong>${a.reference}</strong><span class="sl-badge sl-badge-gray float-end">${a.status}</span><div class="mt-2">${a.services.join(', ')}</div><div>Thợ: ${a.stylistName}</div><div>${a.date} · ${a.startTime}–${a.endTime} · ${a.durationMinutes} phút</div></div>`;return item;}));});</script>
}
