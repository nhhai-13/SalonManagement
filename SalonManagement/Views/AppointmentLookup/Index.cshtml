@{ ViewData["Title"] = "Tra cứu lịch hẹn"; }
<div class="container py-4" style="max-width:600px"><h1 class="h3">Tra cứu lịch hẹn</h1><p class="text-muted">Nhập mã lịch hẹn 8 ký tự hoặc số điện thoại.</p><form id="lookup-form"><div class="input-group"><input id="lookup-query" class="form-control" required /><button class="btn btn-primary" type="submit">Tra cứu</button></div></form><div id="lookup-message" class="mt-3"></div><div id="lookup-list" class="mt-3"></div></div>
@section Scripts { <script>const form=document.getElementById('lookup-form'),query=document.getElementById('lookup-query'),message=document.getElementById('lookup-message'),list=document.getElementById('lookup-list');form.addEventListener('submit',async e=>{e.preventDefault();const r=await fetch(`/appointments/lookup/search?query=${encodeURIComponent(query.value)}`),d=await r.json();list.replaceChildren();message.textContent=d.error||'';message.className=d.error?'alert alert-info mt-3':'mt-3';if(!d.error)list.replaceChildren(...d.appointments.map(a=>{const item=document.createElement('article');item.className='card mb-2';item.innerHTML=`<div class="card-body"><strong>${a.reference}</strong><span class="badge text-bg-secondary float-end">${a.status}</span><div class="mt-2">${a.services.join(', ')}</div><div>Thợ: ${a.stylistName}</div><div>${a.date} · ${a.startTime}–${a.endTime} · ${a.durationMinutes} phút</div></div>`;return item;}));});</script> }
