@{ ViewData["Title"] = "Tra cứu lịch hẹn"; }
<div class="container py-4" style="max-width:600px; margin: 0 auto;">
    <div class="sl-card sl-lookup-card p-4">
        <div class="sl-eyebrow mb-2">Dịch vụ khách hàng</div>
        <h1 class="sl-page-title h3 mb-3">Tra cứu lịch hẹn</h1>
        <p class="text-muted mb-4">Nhập mã lịch hẹn 8 ký tự hoặc số điện thoại.</p>
        
        <form id="lookup-form">
            <div class="sl-input-wrap d-flex gap-2">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input id="lookup-query" class="form-control sl-input" placeholder="Mã lịch hẹn hoặc SĐT" required />
                    <button class="btn btn-primary sl-btn sl-btn-primary" type="submit">Tra cứu</button>
                </div>
            </div>
        </form>

        <div id="lookup-message" class="sl-alert mt-3"></div>
        <div id="lookup-list" class="mt-3"></div>
    </div>
</div>

@section Scripts {
    <script>
        const form = document.getElementById('lookup-form');
        const query = document.getElementById('lookup-query');
        const message = document.getElementById('lookup-message');
        const list = document.getElementById('lookup-list');
        const showMessage = (text, isError) => {
            message.textContent = text;
            message.className = `alert ${isError ? 'alert-danger' : 'alert-success'} mt-3`;
        };
        const addText = (parent, tag, text, className = '') => {
            const node = document.createElement(tag);
            node.textContent = text;
            if (className) node.className = className;
            parent.append(node);
        };
        form.addEventListener('submit', async event => {
            event.preventDefault();
            list.replaceChildren();
            try {
                const response = await fetch(`/appointments/lookup/search?query=${encodeURIComponent(query.value.trim())}`);
                const data = await response.json();
                if (!response.ok || data.error) return showMessage(data.error || 'Không thể tra cứu lịch hẹn. Vui lòng thử lại.', true);

                const appointments = data.appointments || [];
                showMessage(`Tìm thấy ${appointments.length} lịch hẹn.`, false);
                appointments.forEach(appointment => {
                    const item = document.createElement('article');
                    item.className = 'card mb-2 sl-appointment-item';
                    const body = document.createElement('div');
                    body.className = 'card-body';
                    const header = document.createElement('div');
                    addText(header, 'strong', appointment.reference);
                    addText(header, 'span', appointment.status, 'sl-badge sl-badge-gray float-end');
                    body.append(header);
                    addText(body, 'div', (appointment.services || []).join(', '), 'mt-2');
                    addText(body, 'div', `Thợ: ${appointment.stylistName}`);
                    addText(body, 'div', `${appointment.date} · ${appointment.startTime}–${appointment.endTime} · ${appointment.durationMinutes} phút`);
                    item.append(body);
                    list.append(item);
                });
            } catch {
                showMessage('Không thể kết nối đến hệ thống. Vui lòng thử lại.', true);
            }
        });
    </script>
}
