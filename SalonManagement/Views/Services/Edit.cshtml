@model SalonManagement.Models.Service
@{
    ViewData["Title"] = "Sửa dịch vụ";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Sửa dịch vụ</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="ServiceId" />
                        <input type="hidden" asp-for="CreatedAt" />

                        <div class="mb-3">
                            <label asp-for="ServiceName" class="form-label">
                                Tên dịch vụ <span class="text-danger">*</span>
                            </label>
                            <input asp-for="ServiceName" class="form-control" required />
                            <span asp-validation-for="ServiceName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ServiceGroupId" class="form-label">Nhóm dịch vụ</label>
                            <select asp-for="ServiceGroupId" class="form-select"
                                    asp-items="@(new SelectList(ViewBag.Groups, "ServiceGroupId", "GroupName"))">
                                <option value="">-- Chưa chọn nhóm --</option>
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DurationMinutes" class="form-label">
                                    Thời lượng (phút) <span class="text-danger">*</span>
                                </label>
                                <input asp-for="DurationMinutes" class="form-control"
                                       type="number" step="15" min="15" max="240" required />
                                <small class="text-muted">Bội số của 15, từ 15 đến 240 phút</small>
                                <span asp-validation-for="DurationMinutes" class="text-danger d-block"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label">
                                    Giá (VND) <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Price" class="form-control"
                                       type="number" min="1" max="20000000" required />
                                <small class="text-muted">Tối đa 20.000.000 đ</small>
                                <span asp-validation-for="Price" class="text-danger d-block"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Mô tả</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">Đang bán</label>
                        </div>

                        <div class="alert alert-info">
                            <small>
                                <strong>Lưu ý:</strong> Đổi thời lượng không làm thay đổi
                                thời lượng của các lịch hẹn đã đặt trước đó.
                            </small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">Cập nhật</button>
                            <a asp-action="Index" class="btn btn-secondary">Huỷ</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}