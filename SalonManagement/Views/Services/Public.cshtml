@model SalonManagement.Models.ViewModels.PublicServiceCatalog
@{ ViewData["Title"] = "Dịch vụ"; Layout = "_CatalogLayout"; }
<div class="sl-catalog-page">
    <header class="sl-catalog-page-header">
        <span class="sl-eyebrow">Luminol Salon &amp; Spa</span>
        <h1>Dịch vụ của salon</h1>
        <p>Chọn dịch vụ phù hợp, sau đó đặt lịch theo thời gian thuận tiện.</p>
    </header>
    
    <section class="sl-catalog-search-panel">
        <form class="sl-catalog-search" method="get" asp-controller="Services" asp-action="Public" role="search">
            <label for="service-search">Tìm dịch vụ</label>
            <div class="sl-catalog-search-controls">
                <div class="sl-catalog-search-input">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" id="service-search" name="search" value="@Model.Search"
                           placeholder="Ví dụ: cắt tóc, gội đầu" />
                </div>
                <button type="submit" class="sl-btn sl-btn-primary">Tìm kiếm</button>
                @if (!string.IsNullOrEmpty(Model.Search))
                {
                    <a asp-controller="Services" asp-action="Public" class="sl-btn sl-btn-outline">Xóa từ khóa</a>
                }
            </div>
        </form>
    </section>

    @if (!Model.HasServices)
    {
        <div class="sl-alert alert alert-info" role="status">
            @(string.IsNullOrEmpty(Model.Search)
                ? "Chưa có dịch vụ nào để hiển thị."
                : "Không tìm thấy dịch vụ phù hợp.")
        </div>
    }

    @if (Model.Groups.Count > 0)
    {
        <nav aria-label="Nhóm dịch vụ" class="sl-group-nav">
        @foreach (var group in Model.Groups)
        {
            <a href="#group-@(group.Id?.ToString() ?? "ungrouped")">@group.Name</a>
        }
        </nav>
    }

    @foreach (var group in Model.Groups)
    {
        var key = group.Id?.ToString() ?? "ungrouped";
        <section id="group-@key" aria-labelledby="heading-@key" class="sl-group-section">
            <h2 id="heading-@key" class="sl-catalog-group-title">@group.Name</h2>
            @if (group.Services.Count == 0)
            {
                <p class="text-muted">Nhóm này chưa có dịch vụ.</p>
            }
            <div class="sl-service-grid">
            @foreach (var service in group.Services)
            {
                <article class="sl-service-card">
                    <div class="sl-service-icon"><i class="bi bi-scissors" aria-hidden="true"></i></div>
                    <h3 class="sl-service-name">@service.ServiceName</h3>
                    <p class="sl-service-desc">@(string.IsNullOrWhiteSpace(service.Description) ? "Dịch vụ được thực hiện bởi đội ngũ chuyên viên của salon." : service.Description)</p>
                    <div class="sl-service-meta">
                        <span class="sl-service-duration"><i class="bi bi-clock" aria-hidden="true"></i> Thời lượng: @service.DurationMinutes phút</span>
                        <span class="sl-service-price">Giá: @service.Price.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) VND</span>
                    </div>
                </article>
            }
            </div>
        </section>
    }
</div>
