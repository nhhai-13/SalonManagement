@model SalonManagement.Models.ViewModels.PublicServiceCatalog
@{ ViewData["Title"] = "Dịch vụ"; }
<div class="container my-4">
    <h1>Dịch vụ của salon</h1>
    @if (!Model.HasServices)
    {
        <p role="status">Chưa có dịch vụ nào để hiển thị.</p>
    }
    @if (Model.Groups.Count > 0)
    {
        <nav aria-label="Nhóm dịch vụ" class="d-flex flex-wrap gap-2 mb-4">
        @foreach (var group in Model.Groups)
        {
            <a class="btn btn-outline-primary" href="#group-@(group.Id?.ToString() ?? "ungrouped")">@group.Name</a>
        }
        </nav>
    }
    @foreach (var group in Model.Groups)
    {
        var key = group.Id?.ToString() ?? "ungrouped";
        <section id="group-@key" aria-labelledby="heading-@key" class="mb-4">
            <h2 id="heading-@key">@group.Name</h2>
            @if (group.Services.Count == 0)
            {
                <p class="text-muted">Nhóm này chưa có dịch vụ.</p>
            }
            <div class="row g-3">
            @foreach (var service in group.Services)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="card h-100">
                        <div class="card-body">
                            <h3 class="h5">@service.ServiceName</h3>
                            @if (!string.IsNullOrWhiteSpace(service.Description)) { <p>@service.Description</p> }
                            <p>Thời lượng: @service.DurationMinutes phút</p>
                            <p>Giá: @service.Price.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) VND</p>
                        </div>
                    </article>
                </div>
            }
            </div>
        </section>
    }
</div>
