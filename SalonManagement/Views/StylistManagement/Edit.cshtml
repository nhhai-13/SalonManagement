@model SalonManagement.Models.ViewModels.EditStylistViewModel
@{
    ViewData["Title"] = "Sửa hồ sơ thợ";
}

<div class="container py-4" style="max-width:900px">
    <div class="sl-page-header d-flex justify-content-between align-items-center mb-3">
        <h1 class="sl-page-title h2">Sửa hồ sơ thợ</h1>
        <a asp-action="Index" class="sl-btn sl-btn-outline btn btn-outline-secondary">Quay lại</a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.StylistId" method="post" enctype="multipart/form-data" class="sl-card card shadow-sm" id="edit-stylist-form">
        <input asp-for="StylistId" type="hidden" />
        <div class="card-body row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-md-6"><label asp-for="FullName" class="form-label">Họ tên</label><input asp-for="FullName" class="form-control sl-input" autocomplete="name" /><span asp-validation-for="FullName" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Phone" class="form-label">Số điện thoại</label><input asp-for="Phone" class="form-control sl-input" type="tel" inputmode="numeric" autocomplete="tel" /><span asp-validation-for="Phone" class="text-danger"></span></div>
            <div class="col-12"><label asp-for="Description" class="form-label">Giới thiệu ngắn</label><textarea asp-for="Description" class="form-control sl-input" rows="3" maxlength="500"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
            <div class="col-12">
                <label asp-for="ProfileImage" class="form-label">Thay ảnh đại diện (không bắt buộc, JPG/PNG, tối đa 2MB)</label>
                <input asp-for="ProfileImage" class="form-control sl-input" type="file" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                <span asp-validation-for="ProfileImage" class="text-danger"></span><div id="profile-image-error" class="text-danger mt-1" role="alert"></div>
                <div class="mt-3">
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentProfileImagePath))
                    {
                        <img id="profile-image-preview" src="~/@Model.CurrentProfileImagePath" class="rounded-circle" alt="Ảnh hiện tại của @Model.FullName" width="120" height="120" style="object-fit:cover" />
                    }
                    else
                    {
                        <img id="profile-image-preview" class="rounded-circle d-none" alt="Xem trước ảnh đại diện" width="120" height="120" style="object-fit:cover" />
                    }
                </div>
            </div>
            <div class="col-12"><label class="form-check"><input asp-for="IsActive" class="form-check-input" /><span class="form-check-label">Đang làm việc</span></label></div>
            <fieldset class="col-12">
                <legend class="form-label fs-6">Dịch vụ đảm nhận</legend>
                @if (Model.AvailableServices.Count == 0)
                {
                    <p class="text-danger">Hiện chưa có dịch vụ để gán cho thợ.</p>
                }
                else
                {
                    <div class="row">
                    @foreach (var service in Model.AvailableServices)
                    {
                        <div class="col-sm-6 col-md-4 mb-2"><label class="form-check"><input class="form-check-input service-choice" type="checkbox" name="ServiceIds" value="@service.ServiceId" checked="@(Model.ServiceIds.Contains(service.ServiceId) ? "checked" : null)" /><span class="form-check-label">@service.ServiceName @(!service.IsActive ? "(đã ngừng cung cấp)" : "")</span></label></div>
                    }
                    </div>
                }
                <span asp-validation-for="ServiceIds" class="text-danger"></span><div id="service-selection-error" class="text-danger" role="alert"></div>
            </fieldset>
        </div>
        <div class="card-footer d-flex justify-content-end gap-2">
            <a asp-action="Index" class="sl-btn sl-btn-outline btn btn-outline-secondary">Hủy</a>
            <button type="submit" class="sl-btn sl-btn-primary btn btn-primary">Lưu thay đổi</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById("edit-stylist-form");
            const input = document.getElementById("ProfileImage");
            const preview = document.getElementById("profile-image-preview");
            const imageError = document.getElementById("profile-image-error");
            const serviceError = document.getElementById("service-selection-error");
            const validateImage = file => {
                if (!file) return "";
                const extension = file.name.split(".").pop().toLowerCase();
                const valid = ((extension === "jpg" || extension === "jpeg") && file.type === "image/jpeg") || (extension === "png" && file.type === "image/png");
                if (!valid) return "Ảnh đại diện chỉ được phép ở định dạng JPG hoặc PNG.";
                if (file.size > 2 * 1024 * 1024) return "Ảnh đại diện không được vượt quá 2MB.";
                return "";
            };
            input.addEventListener("change", () => {
                const file = input.files[0];
                imageError.textContent = validateImage(file);
                if (file && !imageError.textContent) { preview.src = URL.createObjectURL(file); preview.classList.remove("d-none"); }
            });
            form.addEventListener("submit", event => {
                imageError.textContent = validateImage(input.files[0]);
                const hasService = form.querySelector(".service-choice:checked") !== null;
                serviceError.textContent = hasService ? "" : "Vui lòng chọn ít nhất một dịch vụ cho thợ.";
                if (imageError.textContent || !hasService) event.preventDefault();
            });
        })();
    </script>
}
