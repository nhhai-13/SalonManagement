@model SalonManagement.Models.ViewModels.Reception.DailyScheduleViewModel
@{ ViewData["Title"] = "Lịch ngày"; var start = Model.OpensAt; var end = Model.ClosesAt; const double pixelsPerMinute = 1.6; }
<style>
.daily-grid{display:grid;grid-template-columns:64px repeat(var(--columns),minmax(220px,1fr));gap:12px;overflow:auto;max-height:calc(100vh - 260px)}.time-axis,.schedule-column{min-width:220px;position:relative}.time-axis{min-width:64px}.schedule-header{height:40px}.time-label{height:96px;font-size:.75rem;color:#6c757d}.schedule-body{position:relative}.schedule-slot{height:24px;border:1px solid #e9ecef}.outside-shift{background:#f1f3f5}.day-off{background:#f8d7da}.appointment-card{position:absolute;left:4px;right:4px;z-index:2;padding:4px 6px;background:#dbeafe;border-radius:4px;cursor:grab;overflow:hidden;font-size:.8rem}.appointment-card small{display:block}.status-pendingconfirmation{background:#fff3cd}.status-confirmed{background:#cfe2ff}.status-inprogress{background:#cff4fc}.status-completed{background:#d1e7dd}.dragging{opacity:.4}.selected{outline:3px solid #0d6efd}.preview-valid{background:#d1e7dd}.preview-invalid{background:#f8d7da}
</style>
<div class="container-fluid py-4" id="daily-schedule" data-date="@Model.Date.ToString("yyyy-MM-dd")">
<div id="service-overrun-alerts" class="alert alert-warning d-none" role="status" aria-live="polite"></div>
<div class="d-flex justify-content-between align-items-center mb-3"><a id="previous-day" class="btn btn-outline-secondary" href="?date=@Model.Date.AddDays(-1).ToString("yyyy-MM-dd")">← Hôm trước</a><h1 class="h3 mb-0">Lịch ngày @Model.Date.ToString("dd/MM/yyyy")</h1><label class="visually-hidden" for="schedule-date">Chọn ngày</label><input id="schedule-date" class="form-control w-auto" type="date" value="@Model.Date.ToString("yyyy-MM-dd")" /><a id="next-day" class="btn btn-outline-secondary" href="?date=@Model.Date.AddDays(1).ToString("yyyy-MM-dd")">Hôm sau →</a></div>
<div id="schedule-message" class="alert d-none" role="alert"></div><p class="text-muted">Kéo thẻ sang ô giờ/thợ mới. Hoặc chọn thẻ bằng Enter rồi chọn ô đích.</p>
<div class="daily-grid" style="--columns:@Math.Max(Model.Stylists.Count,1)"><aside class="time-axis"><div class="schedule-header"></div>@for(var time=start;time<end;time+=TimeSpan.FromHours(1)){<div class="time-label">@time.ToString(@"hh\:mm")</div>}</aside>
@foreach(var stylist in Model.Stylists){<section class="schedule-column"><h2 class="h6 schedule-header bg-white mb-0">@stylist.Name @(stylist.IsDayOff ? "(Nghỉ)" : "")</h2><div class="schedule-body">
@for(var time=start;time<end;time+=TimeSpan.FromMinutes(15)){var isWorking=!stylist.IsDayOff && stylist.Shifts.Any(shift=>shift.StartTime<=time && time<shift.EndTime);<div class="schedule-slot @(!isWorking ? (stylist.IsDayOff ? "day-off" : "outside-shift") : "")" data-stylist-id="@stylist.StylistId" data-start="@time.ToString(@"hh\:mm")"></div>}
@foreach(var appointment in Model.Appointments.Where(item=>item.StylistId==stylist.StylistId)){var top=(appointment.StartTime-start).TotalMinutes*pixelsPerMinute;var height=Math.Max(24,(appointment.EndTime-appointment.StartTime).TotalMinutes*pixelsPerMinute);<article class="appointment-card status-@appointment.Status.ToLowerInvariant()" draggable="true" tabindex="0" role="button" data-appointment-id="@appointment.AppointmentId" data-stylist-id="@appointment.StylistId" data-start="@appointment.StartTime.ToString(@"hh\:mm")" style="top:@top.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)px;height:@height.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)px"><strong>@appointment.CustomerName</strong><small>@appointment.Services</small><small>@appointment.StartTime.ToString(@"hh\:mm")–@appointment.EndTime.ToString(@"hh\:mm") · @appointment.Status</small></article>}</div></section>}
</div></div>
@section Scripts {
<script src="~/js/auth.js" asp-append-version="true"></script>
<script src="~/js/appointment-reschedule-dragdrop.js" asp-append-version="true"></script>
<script>
async function refreshServiceOverrunAlerts() {
    const box = document.getElementById('service-overrun-alerts');
    try {
        const response = await SalonAuth.authenticatedFetch(`/api/reception/service-overruns?date=${encodeURIComponent(document.getElementById('daily-schedule').dataset.date)}`);
        if (!response.ok) return;
        const items = await response.json();
        box.replaceChildren();
        if (!items.length) { box.classList.add('d-none'); return; }
        box.classList.remove('d-none');
        const heading = document.createElement('strong'); heading.textContent = 'Cảnh báo lịch tiếp theo có thể bị trễ:'; box.append(heading);
        for (const item of items) { const line = document.createElement('div'); line.textContent = `#${item.appointmentId} · ${item.customerName} với ${item.stylistName}: ${item.actualMinutes}/${item.expectedMinutes} phút`; box.append(line); }
    } catch { /* Keep the calendar usable if alert polling is temporarily unavailable. */ }
}
refreshServiceOverrunAlerts();
setInterval(refreshServiceOverrunAlerts, 60000);
const scheduleGrid = document.querySelector('.daily-grid');
const savedScroll = sessionStorage.getItem('reception-schedule-scroll');
if (savedScroll !== null) { scheduleGrid.scrollTop = Number(savedScroll); sessionStorage.removeItem('reception-schedule-scroll'); }
else {
    const today = new Date();
    const todayLocal = `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;
    if (document.getElementById('daily-schedule').dataset.date === todayLocal) {
        const currentTime = today.getHours() * 60 + today.getMinutes();
        const opening = @((int)Model.OpensAt.TotalMinutes);
        scheduleGrid.scrollTop = Math.max(0, (currentTime - opening) * 1.6 - 120);
    }
}
function keepScheduleScroll() { sessionStorage.setItem('reception-schedule-scroll', String(scheduleGrid.scrollTop)); }
document.getElementById('previous-day').addEventListener('click', keepScheduleScroll);
document.getElementById('next-day').addEventListener('click', keepScheduleScroll);
document.getElementById('schedule-date').addEventListener('change', event => {
    keepScheduleScroll(); location.href = `?date=${encodeURIComponent(event.target.value)}`;
});
</script>
}
