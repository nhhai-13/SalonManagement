@model SalonManagement.Models.ViewModels.Reception.DailyScheduleViewModel
@{ ViewData["Title"] = "Lịch ngày"; var start = Model.OpensAt; var end = Model.ClosesAt; const double pixelsPerMinute = 1.6; }
<style>
.daily-grid{display:grid;grid-template-columns:64px repeat(var(--columns),minmax(220px,1fr));gap:12px;overflow:auto}.time-axis,.schedule-column{min-width:220px;position:relative}.time-axis{min-width:64px}.schedule-header{height:40px}.time-label{height:96px;font-size:.75rem;color:#6c757d}.schedule-body{position:relative}.schedule-slot{height:24px;border:1px solid #e9ecef}.appointment-card{position:absolute;left:4px;right:4px;z-index:2;padding:4px 6px;background:#dbeafe;border-radius:4px;cursor:grab;overflow:hidden;font-size:.8rem}.appointment-card small{display:block}.status-pendingconfirmation{background:#fff3cd}.status-confirmed{background:#cfe2ff}.status-inprogress{background:#cff4fc}.status-completed{background:#d1e7dd}.dragging{opacity:.4}.selected{outline:3px solid #0d6efd}.preview-valid{background:#d1e7dd}.preview-invalid{background:#f8d7da}
</style>
<div class="container-fluid py-4" id="daily-schedule">
<div class="d-flex justify-content-between mb-3"><a class="btn btn-outline-secondary" href="?date=@Model.Date.AddDays(-1).ToString("yyyy-MM-dd")">← Hôm trước</a><h1 class="h3">Lịch ngày @Model.Date.ToString("dd/MM/yyyy")</h1><a class="btn btn-outline-secondary" href="?date=@Model.Date.AddDays(1).ToString("yyyy-MM-dd")">Hôm sau →</a></div>
<div id="schedule-message" class="alert d-none" role="alert"></div><p class="text-muted">Kéo thẻ sang ô giờ/thợ mới. Hoặc chọn thẻ bằng Enter rồi chọn ô đích.</p>
<div class="daily-grid" style="--columns:@Math.Max(Model.Stylists.Count,1)"><aside class="time-axis"><div class="schedule-header"></div>@for(var time=start;time<end;time+=TimeSpan.FromHours(1)){<div class="time-label">@time.ToString(@"hh\:mm")</div>}</aside>
@foreach(var stylist in Model.Stylists){<section class="schedule-column"><h2 class="h6 schedule-header bg-white mb-0">@stylist.Name</h2><div class="schedule-body">
@for(var time=start;time<end;time+=TimeSpan.FromMinutes(15)){<div class="schedule-slot @(time < stylist.StartTime || time >= stylist.EndTime ? "outside-shift" : "")" data-stylist-id="@stylist.StylistId" data-start="@time.ToString(@"hh\:mm")"></div>}
@foreach(var appointment in Model.Appointments.Where(item=>item.StylistId==stylist.StylistId)){var top=(appointment.StartTime-start).TotalMinutes*pixelsPerMinute;var height=Math.Max(24,(appointment.EndTime-appointment.StartTime).TotalMinutes*pixelsPerMinute);<article class="appointment-card status-@appointment.Status.ToLowerInvariant()" draggable="true" tabindex="0" role="button" data-appointment-id="@appointment.AppointmentId" data-stylist-id="@appointment.StylistId" data-start="@appointment.StartTime.ToString(@"hh\:mm")" style="top:@top.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)px;height:@height.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)px"><strong>@appointment.CustomerName</strong><small>@appointment.Services</small><small>@appointment.StartTime.ToString(@"hh\:mm")–@appointment.EndTime.ToString(@"hh\:mm") · @appointment.Status</small></article>}</div></section>}
</div></div>
@section Scripts { <script src="~/js/appointment-reschedule-dragdrop.js" asp-append-version="true"></script> }
