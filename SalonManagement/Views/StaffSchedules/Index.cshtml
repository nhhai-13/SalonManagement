@model SalonManagement.Controllers.StaffScheduleWeekViewModel
@using SalonManagement.Models
@{
    ViewData["Title"] = "Lịch nhân viên";
    var dates = Enumerable.Range(0, 7).Select(offset => Model.WeekStart.AddDays(offset)).ToArray();
    string RoleLabel(string role) => role == UserRoles.Stylist ? "Thợ" : "Lễ tân";
}

<section class="sl-body">
    <header class="sl-page-heading d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <span class="sl-eyebrow">Vận hành salon</span>
            <h1>Lịch làm việc nhân viên</h1>
            <p>Ca làm của toàn bộ Lễ tân và Thợ trong tuần @Model.WeekStart.ToString("dd/MM") – @Model.WeekStart.AddDays(6).ToString("dd/MM/yyyy").</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" href="/management/staff-schedules?weekStart=@Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd")">← Tuần trước</a>
            <a class="btn btn-outline-primary" href="/management/staff-schedules?weekStart=@Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd")">Tuần sau →</a>
        </div>
    </header>

    <div class="sl-card p-0 overflow-auto">
        <table class="table table-bordered align-middle mb-0" style="min-width:1120px">
            <thead>
                <tr>
                    <th>Nhân viên</th>
                    @foreach (var date in dates)
                    {
                        <th class="text-center">@date.ToString("ddd", new System.Globalization.CultureInfo("vi-VN"))<small class="d-block text-muted">@date.ToString("dd/MM")</small></th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var person in Model.Staff)
            {
                <tr>
                    <td style="min-width:205px"><strong>@person.FullName</strong><small class="d-block text-muted">@RoleLabel(person.Role) · @person.Email</small></td>
                    @foreach (var date in dates)
                    {
                        var dayShifts = Model.Shifts.Where(shift => shift.UserId == person.UserId && shift.WorkDate.Date == date.Date).OrderBy(shift => shift.StartTime).ToArray();
                        <td class="text-center">
                            @if (dayShifts.Length == 0)
                            {
                                <span class="text-muted small">Nghỉ</span>
                            }
                            else
                            {
                                @foreach (var shift in dayShifts)
                                {
                                    <div><span class="badge text-bg-success">@shift.StartTime.ToString(@"hh\:mm")–@shift.EndTime.ToString(@"hh\:mm")</span></div>
                                    @if (!string.IsNullOrWhiteSpace(shift.Notes)) { <small class="text-muted">@shift.Notes</small> }
                                }
                            }
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
