@model (string Name, DateTime Date, IReadOnlyList<SalonManagement.Models.Appointment> Appointments)
@{ ViewData["Title"]="Lịch làm việc"; }
<div class="container py-4"><div class="d-flex justify-content-between"><a href="?date=@Model.Date.AddDays(-1).ToString("yyyy-MM-dd")">← Hôm trước</a><h1 class="h3">Lịch của @Model.Name · @Model.Date.ToString("dd/MM/yyyy")</h1><a href="?date=@Model.Date.AddDays(1).ToString("yyyy-MM-dd")">Hôm sau →</a></div><div id="stylist-notifications" class="alert alert-info d-none mt-3" role="status"></div><input class="form-control w-auto my-3" type="date" value="@Model.Date.ToString("yyyy-MM-dd")" onchange="location='?date='+this.value"/><div class="list-group">@foreach(var a in Model.Appointments){var standard=a.AppointmentServices.Sum(x=>x.DurationMinutes);var actual=a.ActualStartedAt.HasValue&&a.ActualCompletedAt.HasValue?(int?)(a.ActualCompletedAt.Value-a.ActualStartedAt.Value).TotalMinutes:null;<article class="list-group-item"><strong>@a.StartTime.ToString(@"hh\:mm")–@a.EndTime.ToString(@"hh\:mm") · @a.Customer.FullName</strong><br/><small>@string.Join(", ",a.AppointmentServices.Select(x=>x.Service.ServiceName)) · @standard phút · @a.Status</small><br/><small>SĐT: @a.Customer.Phone[..Math.Min(3,a.Customer.Phone.Length)]****@a.Customer.Phone[Math.Max(3,a.Customer.Phone.Length-3)..] · @a.Notes</small>@if(actual.HasValue){<div class="text-muted">Bắt đầu: @a.ActualStartedAt!.Value.ToString("HH:mm") · Hoàn tất: @a.ActualCompletedAt!.Value.ToString("HH:mm") · Thực tế: @actual phút (@(actual-standard >= 0 ? "+" : "")@(actual-standard) phút)</div>}@if(a.Status=="Arrived"){<button class="btn btn-success btn-sm ms-2" onclick="changeState(@a.AppointmentId,'start')">Bắt đầu</button>}@if(a.Status=="InProgress"){<button class="btn btn-primary btn-sm ms-2" onclick="changeState(@a.AppointmentId,'complete')">Hoàn tất</button>}</article>}</div></div><script>fetch('/api/stylist/notifications').then(r=>r.ok?r.json():null).then(x=>{if(!x||!x.unread)return;const el=document.getElementById('stylist-notifications');el.textContent=`Bạn có ${x.unread} thông báo mới: ${x.items.filter(i=>!i.readAt).map(i=>i.message).join(' · ')}`;el.classList.remove('d-none')})</script>
@section Scripts {<script>async function changeState(id,action){const r=await fetch(`/stylist/schedule/${id}/${action}`,{method:'POST'});if(r.ok)location.reload();else alert((await r.json().catch(()=>({error:'Không thể cập nhật lịch.'}))).error)}</script>}
