@model SalonManagement.Models.ViewModels.StylistWeeklyScheduleViewModel
@{ ViewData["Title"] = "Ca làm & lịch nghỉ"; }
<div class="container py-4 stylist-week-page" style="max-width:1200px">
    <header class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><span class="stylist-command-eyebrow">S2-01 · S2-02</span><h1 class="h3 mb-1">Ca làm tuần của @Model.StylistName</h1><p class="text-muted mb-0">Xem ca được phân công và gửi yêu cầu nghỉ/đổi ca cho lễ tân.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary btn-sm" href="/stylist/week-schedule?weekStart=@Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd")">← Tuần trước</a><a class="btn btn-outline-secondary btn-sm" href="/stylist/week-schedule?weekStart=@Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd")">Tuần sau →</a><button id="stylist-leave-open" class="btn btn-primary btn-sm" type="button"><i class="bi bi-calendar-plus"></i> Đăng ký xin nghỉ / đổi ca</button></div></header>
    <div class="stylist-week-grid">@foreach (var day in Model.Days) { <article class="stylist-week-day"><header><strong>@(day.Date.DayOfWeek switch { DayOfWeek.Monday => "Thứ Hai", DayOfWeek.Tuesday => "Thứ Ba", DayOfWeek.Wednesday => "Thứ Tư", DayOfWeek.Thursday => "Thứ Năm", DayOfWeek.Friday => "Thứ Sáu", DayOfWeek.Saturday => "Thứ Bảy", _ => "Chủ Nhật" })</strong><small>@day.Date.ToString("dd/MM")</small></header>@if (day.ApprovedTimeOffs.Any()) { <div class="stylist-day-off"><i class="bi bi-calendar-x"></i> Nghỉ: @string.Join(", ", day.ApprovedTimeOffs.Select(item => item.Reason ?? "Đã duyệt"))</div> } else if (day.Shifts.Any()) { foreach (var shift in day.Shifts) { <div class="stylist-week-shift"><strong>@shift.StartTime.ToString(@"hh\:mm")–@shift.EndTime.ToString(@"hh\:mm")</strong><span>@(string.IsNullOrWhiteSpace(shift.Notes) ? "Ca làm đã phân công" : "Nghỉ giữa ca: " + shift.Notes)</span></div> } } else { <p class="text-muted small mb-0">Chưa có ca làm.</p> }</article> }</div>
    @if (Model.LeaveRequests.Any()) { <section class="card border-0 shadow-sm mt-4"><div class="card-body"><h2 class="h6">Yêu cầu đã gửi trong tuần</h2><ul class="mb-0">@foreach (var request in Model.LeaveRequests) { <li>@request.OffDate.ToString("dd/MM") · @request.Reason <span class="badge text-bg-warning">@request.Status</span></li> }</ul></div></section> }
</div>
<dialog id="stylist-leave-dialog" class="stylist-notification-dialog"><section><header><h2>Đăng ký xin nghỉ / đổi ca</h2><button class="btn-close" type="button" data-leave-close aria-label="Đóng"></button></header><form id="stylist-leave-form" class="mt-3"><label class="form-label" for="leave-date">Ngày</label><input id="leave-date" class="form-control" type="date" required /><div class="form-check mt-3"><input id="leave-full-day" class="form-check-input" type="checkbox" checked /><label class="form-check-label" for="leave-full-day">Nghỉ cả ngày</label></div><div id="leave-time-range" class="row g-2 mt-1 d-none"><div class="col"><label class="form-label" for="leave-start">Từ</label><input id="leave-start" class="form-control" type="time" /></div><div class="col"><label class="form-label" for="leave-end">Đến</label><input id="leave-end" class="form-control" type="time" /></div></div><label class="form-label mt-3" for="leave-reason">Lý do</label><textarea id="leave-reason" class="form-control" maxlength="500" rows="3" required></textarea><p id="leave-message" class="small mt-2 mb-0"></p><button class="btn btn-primary w-100 mt-3" type="submit">Gửi yêu cầu cho lễ tân</button></form></section></dialog>
@section Scripts { <script src="~/js/auth.js" asp-append-version="true"></script><script>const dialog=document.getElementById('stylist-leave-dialog'),full=document.getElementById('leave-full-day'),range=document.getElementById('leave-time-range');document.getElementById('stylist-leave-open').onclick=()=>dialog.showModal();document.querySelector('[data-leave-close]').onclick=()=>dialog.close();full.onchange=()=>range.classList.toggle('d-none',full.checked);document.getElementById('stylist-leave-form').onsubmit=async event=>{event.preventDefault();const response=await SalonAuth.authenticatedFetch('/api/stylist/leave-requests',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({offDate:document.getElementById('leave-date').value,isFullDay:full.checked,startTime:document.getElementById('leave-start').value||null,endTime:document.getElementById('leave-end').value||null,reason:document.getElementById('leave-reason').value})});const result=await response.json().catch(()=>({}));const message=document.getElementById('leave-message');message.textContent=result.error||result.message;message.className='small mt-2 mb-0 '+(response.ok?'text-success':'text-danger');if(response.ok)setTimeout(()=>location.reload(),600)};</script> }
