@model SalonManagement.Models.ReceptionDailyScheduleViewModel
@{
    ViewData["Title"] = "Lịch hẹn trong ngày";
    var rows = Enumerable.Range(0, Math.Max(0, (int)((Model.ClosingTime - Model.OpeningTime).TotalMinutes / 15) + 1))
        .Select(index => Model.OpeningTime.Add(TimeSpan.FromMinutes(index * 15))).ToList();
}
<div class="container-fluid py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div><h1 class="h3 mb-1">Lịch hẹn trong ngày</h1><p class="text-muted mb-0">Theo dõi lịch của từng thợ và xử lý khách đến tại quầy.</p></div>
        <form method="get" class="d-flex gap-2"><input class="form-control" type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" /><button class="btn btn-outline-primary">Xem lịch</button></form>
    </div>
    @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
    <div class="table-responsive border rounded bg-white">
        <table class="table table-bordered align-top mb-0">
            <thead class="table-light"><tr><th style="min-width:85px">Giờ</th>@foreach (var stylist in Model.Stylists) { <th style="min-width:220px">@stylist.StylistName</th> }</tr></thead>
            <tbody>
            @foreach (var time in rows)
            {
                <tr><th class="text-muted small">@time.ToString(@"hh\:mm")</th>
                @foreach (var stylist in Model.Stylists)
                {
                    var starts = stylist.Appointments.Where(item => item.StartTime == time).ToList();
                    var worksAtTime = stylist.WorkingRanges.Any(range => range.StartTime <= time && time < range.EndTime);
                    <td class="p-1 @(worksAtTime ? "" : "table-secondary")">@if (!worksAtTime) { <span class="visually-hidden">Ngoài ca làm việc</span> }@foreach (var appointment in starts) {
                        <article class="border rounded p-2 mb-1 bg-light"><strong>@appointment.CustomerName</strong><div class="small">@appointment.Services</div><div class="small text-muted">@appointment.StartTime.ToString(@"hh\:mm")–@appointment.EndTime.ToString(@"hh\:mm") · @appointment.Status</div>
                        @if (appointment.IsLate) { <div class="small text-danger">Đến muộn @appointment.LateMinutes phút</div> }
                        @if (appointment.Status == "Confirmed") { <form method="post" action="/reception/daily-schedule/@appointment.AppointmentId/check-in" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" /><button class="btn btn-success btn-sm mt-1">Check-in</button></form><form method="post" action="/reception/daily-schedule/@appointment.AppointmentId/no-show" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" /><button class="btn btn-outline-danger btn-sm mt-1">Không đến</button></form> }
                        @if (appointment.Status == "NoShow") { <form method="post" action="/reception/daily-schedule/@appointment.AppointmentId/undo-no-show" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" /><button class="btn btn-outline-secondary btn-sm mt-1">Hoàn tác</button></form> }
                        </article>
                    }</td>
                }
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
