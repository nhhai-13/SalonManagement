@{
    ViewData["Title"] = "Điều phối lịch nghỉ";
}

<main id="schedule-coordination-page" class="d-none py-4" aria-labelledby="page-title">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <span class="text-uppercase text-muted small fw-semibold">Điều phối lịch nghỉ</span>
            <h1 id="page-title" class="h2 mb-1">Lịch hẹn cần xử lý</h1>
            <p class="text-muted mb-0">Chọn thợ và ngày nghỉ để xem lịch cần xử lý cùng phương án thay thế.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" href="/reception/schedule-coordination/follow-ups">Danh sách cần gọi khách</a>
            <button class="btn btn-outline-danger" id="logout" type="button">Đăng xuất</button>
        </div>
    </div>

    <section class="card shadow-sm mb-4" aria-label="Bộ lọc lịch hẹn">
        <div class="card-body">
            <form id="schedule-coordination-filter" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" for="stylist-id">Thợ nghỉ</label>
                    <select class="form-select" id="stylist-id" name="stylistId" required>
                        <option value="">Đang tải danh sách thợ...</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="day-off">Ngày nghỉ</label>
                    <input class="form-control" id="day-off" name="date" type="date" required />
                </div>
                <div class="col-md-3 d-grid">
                    <button class="btn btn-primary" id="load-appointments" type="submit" disabled>Xem lịch cần xử lý</button>
                </div>
            </form>
        </div>
    </section>

    <div id="schedule-error" class="alert alert-danger d-none" role="alert"></div>
    <div id="schedule-loading" class="alert alert-info d-none" role="status">Đang tải lịch hẹn...</div>
    <div id="schedule-empty" class="alert alert-light border d-none" role="status">Không có lịch hẹn chưa hoàn tất phù hợp với thợ và ngày đã chọn.</div>

    <section id="schedule-results" class="card shadow-sm d-none" aria-labelledby="schedule-results-title">
        <div class="card-header bg-white d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h2 id="schedule-results-title" class="h5 mb-0">Danh sách lịch hẹn</h2>
            <span class="badge text-bg-primary" id="schedule-count" aria-live="polite">0 lịch cần xử lý</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Chọn</th>
                        <th scope="col">Khách hàng</th>
                        <th scope="col">Dịch vụ</th>
                        <th scope="col">Bắt đầu</th>
                        <th scope="col">Thời lượng</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Liên hệ</th>
                        <th scope="col">Gợi ý</th>
                        <th scope="col">Chọn thợ và giờ mới</th>
                        <th scope="col">Khách đã đồng ý</th>
                        <th scope="col">Kết quả</th>
                    </tr>
                </thead>
                <tbody id="schedule-appointments"></tbody>
            </table>
        </div>
    </section>

    <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
        <span id="transfer-selected-count" class="text-muted" aria-live="polite">Chưa chọn lịch</span>
        <button class="btn btn-outline-primary" id="preview-transfers" type="button" disabled>Kiểm tra phương án đã chọn</button>
    </div>

    <section id="transfer-preview" class="card border-primary mt-3 d-none" aria-labelledby="transfer-preview-title">
        <div class="card-body">
            <h2 id="transfer-preview-title" class="h5">Xác nhận chuyển lịch</h2>
            <p id="transfer-preview-summary" class="mb-2"></p>
            <ul id="transfer-preview-list" class="mb-3"></ul>
            <div class="d-flex gap-2">
                <button class="btn btn-primary" id="confirm-transfers" type="button" disabled>Xác nhận chuyển các lịch hợp lệ</button>
                <button class="btn btn-outline-secondary" id="cancel-transfer-preview" type="button">Quay lại chỉnh phương án</button>
            </div>
        </div>
    </section>

    <section id="transfer-results" class="card mt-3 d-none" aria-labelledby="transfer-results-title">
        <div class="card-body">
            <h2 id="transfer-results-title" class="h5">Kết quả chuyển lịch</h2>
            <p id="transfer-results-summary" class="mb-2"></p>
            <ul id="transfer-results-list" class="mb-0"></ul>
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script src="~/js/schedule-coordination.js" asp-append-version="true"></script>
    <script>ScheduleCoordinationPage.initialize();</script>
}
