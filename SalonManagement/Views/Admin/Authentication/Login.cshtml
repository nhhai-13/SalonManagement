@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_AuthLayout";
}

<div class="sl-auth-page">
  <div class="sl-auth-showcase">
    <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Về trang chủ">
        <span><strong>Luminol</strong> <small>Salon &amp; Spa</small></span>
    </a>
    <div class="showcase-copy">
        <span class="sl-eyebrow">Không gian nhân viên</span>
        <h1>Vẻ đẹp được tạo nên từ những trải nghiệm tinh tế.</h1>
        <p>Quản lý hoạt động salon trong một không gian duy nhất.</p>
    </div>
    <div class="showcase-footer">
        <span>Chăm sóc khách hàng</span>
        <span class="divider" aria-hidden="true"> | </span>
        <span>Vận hành hiệu quả</span>
    </div>
  </div>
  <div class="sl-auth-panel">
    <a class="sl-auth-logo-mobile brand" href="/">Luminol Salon &amp; Spa</a>
    <div class="sl-auth-card">
      <div class="sl-auth-heading">
        <span class="sl-eyebrow">Cổng nhân viên</span>
        <h2>Đăng nhập</h2>
        <p>Nhập thông tin tài khoản để tiếp tục.</p>
      </div>

      <form id="login-form" novalidate>
        <div id="login-error" class="alert alert-danger d-none" role="alert" aria-live="polite">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v5m0 3h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            <span class="ms-1"></span>
        </div>

        <div class="sl-form-group mb-3">
          <label for="email" class="sl-label">Địa chỉ email</label>
          <div class="sl-input-wrap">
            <input id="email" name="email" type="email" class="sl-input form-control" placeholder="admin@luminol.vn" autocomplete="username" autofocus required />
          </div>
        </div>

        <div class="sl-form-group mb-3">
          <div class="d-flex justify-content-between align-items-center mb-1">
              <label for="password" class="sl-label mb-0">Mật khẩu</label>
              <a asp-controller="Account" asp-action="ForgotPassword" class="small text-decoration-none text-primary fw-medium">Quên mật khẩu?</a>
          </div>
          <div class="sl-input-wrap">
            <input id="password" name="password" type="password" class="sl-input form-control" placeholder="Nhập mật khẩu" autocomplete="current-password" required />
          </div>
        </div>

        <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" id="remember">
            <label class="form-check-label small" for="remember">Ghi nhớ đăng nhập trên thiết bị này</label>
        </div>

        <div class="d-grid">
            <button id="login-submit" type="submit" class="sl-auth-submit btn btn-primary btn-lg fw-semibold">
                <span class="button-label">Đăng nhập</span>
            </button>
        </div>
      </form>

      <div class="mt-4 text-center">
        <p class="text-muted small mb-1">
            Bạn chưa có tài khoản? Hãy đăng ký
            <a href="/reception/register" class="text-decoration-none">Lễ tân</a> hoặc
            <a href="/stylist/register" class="text-decoration-none">Thợ</a>.
        </p>
        <p class="text-muted small mb-0">Bạn gặp khó khăn? <a href="mailto:support@luminol.vn" class="text-decoration-none">Liên hệ hỗ trợ</a></p>
      </div>
      
    </div>
    
    <div class="text-center mt-3">
        <p class="text-muted small">© @DateTime.Now.Year Luminol Salon. Bảo lưu mọi quyền.</p>
    </div>
  </div>
</div>

@section Scripts {
    <script>SalonAuth.bindLoginForm();</script>
}
