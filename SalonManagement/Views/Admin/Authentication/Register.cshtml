@{
    var portal = ViewData["Portal"]?.ToString() ?? "reception";
    var portalTitle = portal == "stylist" ? "Thợ" : "Lễ tân";
    ViewData["Title"] = $"Đăng ký tài khoản {portalTitle.ToLower()}";
    Layout = "_AuthLayout";
}

<main class="auth-shell">
    <section class="auth-showcase" aria-label="Giới thiệu Luminol Salon">
        <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">L</span><span><strong>Luminol</strong><small>Salon &amp; Spa</small></span></a>
        <div class="showcase-copy">
            <span class="eyebrow">Gia nhập đội ngũ</span>
            <h1>Cùng tạo nên những trải nghiệm làm đẹp tinh tế.</h1>
            <p>Tạo tài khoản @portalTitle.ToLower() để truy cập khu vực làm việc của bạn.</p>
        </div>
        <div class="showcase-footer"><span>Đội ngũ chuyên nghiệp</span><span class="divider"></span><span>Phục vụ tận tâm</span></div>
    </section>

    <section class="auth-panel">
        <div class="mobile-brand"><span class="brand-mark">L</span><span><strong>Luminol</strong><small>Salon &amp; Spa</small></span></div>
        <div class="login-card">
            <div class="login-heading"><span class="eyebrow">Bước 1/2 · Tài khoản @portalTitle.ToLower()</span><h2>Đăng ký bằng email</h2><p>Chúng tôi sẽ gửi mã xác thực 6 chữ số đến email của bạn. Sau khi xác minh, Admin hoặc Chủ tiệm sẽ cấp quyền @portalTitle.ToLower() cho tài khoản.</p></div>
            <form id="register-form" data-role="@portal" data-login="/@portal/login" novalidate>
                <div id="register-error" class="login-alert d-none" role="alert"><span></span></div>
                <div class="field-group"><label for="full-name">Họ và tên</label><div class="input-wrap"><input id="full-name" type="text" autocomplete="name" placeholder="Nguyễn Minh Anh" required maxlength="120" /></div><span class="field-error">Vui lòng nhập họ và tên.</span></div>
                <div class="field-group"><label for="email">Địa chỉ email</label><div class="input-wrap"><input id="email" type="email" autocomplete="username" placeholder="ban@luminol.vn" required /></div><span class="field-error">Vui lòng nhập email hợp lệ.</span></div>
                <div class="field-group"><label for="password">Mật khẩu</label><div class="input-wrap"><input id="password" type="password" autocomplete="new-password" placeholder="Ít nhất 8 ký tự, có chữ thường và số" required minlength="8" /></div><span class="field-error">Mật khẩu chưa đáp ứng yêu cầu.</span></div>
                <div class="field-group"><label for="confirm-password">Xác nhận mật khẩu</label><div class="input-wrap"><input id="confirm-password" type="password" autocomplete="new-password" placeholder="Nhập lại mật khẩu" required /></div><span class="field-error">Mật khẩu xác nhận không khớp.</span></div>
                <button id="register-submit" class="login-button" type="submit"><span class="button-label">Gửi mã xác thực</span><span class="button-spinner"></span></button>
            </form>
            <p class="support-note">Đã có tài khoản? <a href="/@portal/login">Đăng nhập</a></p>
        </div>
    </section>
</main>

@section Scripts { <script>SalonAuth.bindRegisterForm();</script> }
