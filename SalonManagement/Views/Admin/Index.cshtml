@{ ViewData["Title"] = "Quản trị hệ thống"; }

<div id="admin-content" class="sl-body d-none">
    <header class="sl-hero-card sl-hero-admin">
        <div>
            <span class="sl-hero-kicker">Không gian quản trị · Hệ thống</span>
            <h1>Trung tâm quản trị</h1>
            <p>Quản lý tài khoản, quyền truy cập và nhật ký thay đổi của hệ thống.</p>
        </div>
        <div class="sl-hero-meta sl-hero-account" aria-label="Thông tin phiên đăng nhập">
            <span class="sl-hero-role">Quản trị viên</span>
            <strong data-session-email></strong>
        </div>
    </header>

    <section id="admin-tools" class="sl-card d-none">
        <div id="staff-accounts" class="sl-card-header admin-card-heading">
            <div><span class="sl-eyebrow">S1-02 · Quản lý tài khoản</span><h2 class="sl-card-title">Cấp tài khoản nhân viên</h2><p class="sl-card-subtitle">Tạo tài khoản đúng vai trò. Chỉ quản trị viên được thực hiện.</p></div>
            <span class="sl-badge sl-badge-success">Đang hoạt động</span>
        </div>
        <div class="sl-card-body">
            <div id="staff-account-message" class="alert d-none" role="alert"></div>
            <form id="staff-account-form" class="sl-form-grid admin-account-form">
                <div><label class="sl-label" for="staff-email">Email nhân viên</label><input class="sl-input" id="staff-email" name="email" type="email" placeholder="nhanvien@salon.local" autocomplete="off" required /></div>
                <div><label class="sl-label" for="staff-role">Vai trò</label><select class="sl-select" id="staff-role" name="role" required><option value="Receptionist">Lễ tân</option><option value="Stylist">Thợ</option><option value="Owner">Chủ tiệm</option><option value="Admin">Quản trị</option></select></div>
                <div><label class="sl-label" for="staff-name">Họ tên</label><input class="sl-input" id="staff-name" name="fullName" maxlength="120" required /></div>
                <div><label class="sl-label" for="staff-phone">Số điện thoại</label><input class="sl-input" id="staff-phone" name="phoneNumber" pattern="0[0-9]{9}" required /></div>
                <div><label class="sl-label" for="staff-active">Trạng thái</label><select class="sl-select" id="staff-active" name="isActive"><option value="true">Đang hoạt động</option><option value="false">Ngừng hoạt động</option></select></div>
                <p class="sl-form-hint admin-account-hint">Mật khẩu tạm được hệ thống sinh và gửi qua email. Người dùng phải đổi mật khẩu ở lần đăng nhập đầu tiên.</p>
                <div class="sl-form-wide"><button class="sl-btn sl-btn-primary" type="submit"><i class="bi bi-person-plus"></i>Tạo tài khoản</button></div>
            </form>
        </div>

        <dialog id="staff-edit-dialog" class="rounded border p-4">
            <form id="staff-edit-form">
                <h2 class="h4">Sửa tài khoản</h2>
                <input name="id" type="hidden" />
                <label class="form-label" for="edit-full-name">Họ tên</label><input id="edit-full-name" name="fullName" class="form-control mb-2" required maxlength="120" />
                <label class="form-label" for="edit-email">Email</label><input id="edit-email" name="email" type="email" class="form-control mb-2" required />
                <label class="form-label" for="edit-phone">Số điện thoại</label><input id="edit-phone" name="phoneNumber" class="form-control mb-2" pattern="0[0-9]{9}" required />
                <label class="form-label" for="edit-role">Vai trò</label><select id="edit-role" name="role" class="form-select mb-3"><option>Admin</option><option>Owner</option><option>Receptionist</option><option>Stylist</option></select>
                <p id="staff-edit-error" class="text-danger" role="alert"></p>
                <button type="submit" class="btn btn-primary">Lưu</button><button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('staff-edit-dialog').close()">Huỷ</button>
            </form>
        </dialog>
        <div class="sl-card-body admin-list-section">
            <div class="admin-list-heading">
                <div><h2 class="sl-card-title">Danh sách tài khoản</h2><p class="sl-card-subtitle">Tìm kiếm, lọc và thay đổi trạng thái tài khoản.</p></div>
                <button id="staff-refresh" class="sl-btn sl-btn-ghost sl-btn-sm" type="button"><i class="bi bi-arrow-clockwise"></i>Làm mới</button>
            </div>
            <form id="staff-filter-form" class="admin-filter-form">
                <input id="staff-search" class="sl-input" placeholder="Tìm theo email" />
                <select id="staff-filter-role" class="sl-select"><option value="">Tất cả vai trò</option><option>Admin</option><option>Owner</option><option value="Receptionist">Lễ tân</option><option value="Stylist">Thợ</option></select>
                <select id="staff-filter-status" class="sl-select"><option value="">Tất cả trạng thái</option><option value="true">Đang hoạt động</option><option value="false">Ngừng hoạt động</option></select>
                <button class="sl-btn sl-btn-outline" type="submit"><i class="bi bi-search"></i><span>Lọc</span></button>
            </form>
            <div class="sl-table-wrap">
                <table class="sl-table">
                    <thead><tr><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
                    <tbody id="staff-account-list"><tr><td colspan="4" class="sl-table-empty">Đang tải...</td></tr></tbody>
                </table>
            </div>
        </div>
    </section>

</div>

@section Scripts { <script src="~/js/auth.js" asp-append-version="true"></script><script>SalonAuth.requireSession();</script> }
