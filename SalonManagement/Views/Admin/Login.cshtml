@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_AuthLayout";
}

<main class="auth-shell">
    <section class="auth-showcase" aria-label="Giới thiệu Luminol Salon">
        <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Về trang chủ">
            <span class="brand-mark" aria-hidden="true">L</span>
            <span>
                <strong>Luminol</strong>
                <small>Salon &amp; Spa</small>
            </span>
        </a>

        <div class="showcase-copy">
            <span class="eyebrow">Không gian nhân viên</span>
            <h1>Vẻ đẹp được tạo nên từ những trải nghiệm tinh tế.</h1>
            <p>Quản lý hoạt động salon trong một không gian duy nhất.</p>
        </div>

        <div class="showcase-footer">
            <span>Chăm sóc khách hàng</span>
            <span class="divider" aria-hidden="true"></span>
            <span>Vận hành hiệu quả</span>
        </div>
    </section>

    <section class="auth-panel">
        <div class="mobile-brand">
            <span class="brand-mark" aria-hidden="true">L</span>
            <span><strong>Luminol</strong><small>Salon &amp; Spa</small></span>
        </div>

        <div class="login-card">
            <div class="login-heading">
                <span class="eyebrow">Cổng nhân viên</span>
                <h2>Đăng nhập</h2>
                <p>Nhập thông tin tài khoản để tiếp tục.</p>
            </div>

            <form id="login-form" novalidate>
                <div id="login-error" class="login-alert d-none" role="alert" aria-live="polite">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v5m0 3h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                    <span></span>
                </div>

                <div class="field-group">
                    <label for="email">Địa chỉ email</label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.75 10.34 12a2.83 2.83 0 0 0 3.32 0L21 6.75M5.25 19.5h13.5A2.25 2.25 0 0 0 21 17.25V6.75a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6.75v10.5a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>
                        <input id="email" name="email" type="email" placeholder="admin@luminol.vn" autocomplete="username" autofocus required />
                    </div>
                    <span class="field-error">Vui lòng nhập email hợp lệ.</span>
                </div>

                <div class="field-group">
                    <div class="label-row">
                        <label for="password">Mật khẩu</label>
                        <a asp-controller="Account" asp-action="ForgotPassword">Quên mật khẩu?</a>
                    </div>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.5 10.5V6.75a4.5 4.5 0 0 0-9 0v3.75m-.75 10.125h10.5a2.25 2.25 0 0 0 2.25-2.25v-5.625a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v5.625a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>
                        <input id="password" name="password" type="password" placeholder="Nhập mật khẩu" autocomplete="current-password" required />
                        <button id="toggle-password" class="password-toggle" type="button" aria-label="Hiện mật khẩu" aria-pressed="false">
                            <svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.25 12s3.5-6 9.75-6 9.75 6 9.75 6-3.5 6-9.75 6S2.25 12 2.25 12Z"/><circle cx="12" cy="12" r="2.75"/></svg>
                            <svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 3 18 18M10.6 6.1A10.8 10.8 0 0 1 12 6c6.25 0 9.75 6 9.75 6a16 16 0 0 1-2.1 2.75M6.25 7.25C3.6 9.05 2.25 12 2.25 12S5.75 18 12 18c1.35 0 2.55-.28 3.62-.73M9.88 9.88a3 3 0 0 0 4.24 4.24"/></svg>
                        </button>
                    </div>
                    <span class="field-error">Vui lòng nhập mật khẩu.</span>
                </div>

                <label class="remember-option">
                    <input id="remember" type="checkbox" />
                    <span>Ghi nhớ đăng nhập trên thiết bị này</span>
                </label>

                <button id="login-submit" class="login-button" type="submit">
                    <span class="button-label">Đăng nhập</span>
                    <span class="button-spinner" aria-hidden="true"></span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
                </button>
            </form>

            <p class="support-note">Bạn gặp khó khăn? <a href="mailto:support@luminol.vn">Liên hệ hỗ trợ</a></p>
        </div>

        <p class="copyright">© @DateTime.Now.Year Luminol Salon. Bảo lưu mọi quyền.</p>
    </section>
</main>

@section Scripts {
    <script>SalonAuth.bindLoginForm();</script>
}
