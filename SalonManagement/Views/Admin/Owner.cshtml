@{ ViewData["Title"] = "Khu vực chủ tiệm"; }

<div id="owner-content" class="sl-body d-none">
    <header class="sl-hero-card sl-hero-owner">
        <div>
            <span class="sl-hero-kicker">Không gian quản trị · Chủ tiệm</span>
            <h1>Khu vực chủ tiệm</h1>
            <p>Thiết lập danh mục và vận hành nền tảng để salon sẵn sàng phục vụ khách hàng.</p>
        </div>
        <div class="sl-hero-meta owner-hero-account" aria-label="Thông tin phiên đăng nhập">
            <span class="sl-hero-role">Chủ tiệm</span>
            <div class="owner-hero-user">
                <span class="owner-hero-avatar" aria-hidden="true"><i class="bi bi-person"></i></span>
                <div>
                    <span class="owner-hero-user-label">Tài khoản đang hoạt động</span>
                    <strong data-session-email></strong>
                </div>
            </div>
        </div>
    </header>

    <section class="sl-module-grid" aria-label="Chức năng chủ tiệm Sprint 1">
        <article class="sl-module-card"><span class="portal-module-icon"><i class="bi bi-scissors"></i></span><span class="portal-status portal-status-ready">Sẵn sàng</span><small>S1-05</small><h2>Danh mục dịch vụ</h2><p>Khai báo tên, nhóm, thời lượng, giá, mô tả và trạng thái đang bán.</p><a class="btn btn-primary" asp-controller="Services" asp-action="Index">Quản lý dịch vụ</a></article>
        <article class="sl-module-card"><span class="portal-module-icon"><i class="bi bi-collection"></i></span><span class="portal-status portal-status-ready">Sẵn sàng</span><small>S1-06</small><h2>Nhóm dịch vụ</h2><p>Thêm, sửa, xoá nhóm và sắp xếp thứ tự hiển thị trên trang công khai.</p><a class="btn btn-outline-primary" asp-controller="ServiceGroups" asp-action="Index">Quản lý nhóm</a></article>
        <article class="sl-module-card"><span class="portal-module-icon"><i class="bi bi-person-badge"></i></span><span class="portal-status portal-status-ready">Sẵn sàng</span><small>S1-07</small><h2>Hồ sơ thợ</h2><p>Quản lý ảnh đại diện, mô tả, dịch vụ đảm nhận và trạng thái làm việc của thợ.</p><a class="btn btn-primary" asp-controller="StylistManagement" asp-action="Index">Quản lý hồ sơ thợ</a></article>
        <article class="sl-module-card"><span class="portal-module-icon"><i class="bi bi-calendar-week"></i></span><span class="portal-status portal-status-ready">Sẵn sàng</span><small>S1-08</small><h2>Giờ hoạt động</h2><p>Cấu hình giờ mở, giờ đóng hoặc ngày nghỉ cho từng ngày trong tuần.</p><a class="btn btn-primary" href="/owner/business-hours">Thiết lập giờ mở cửa</a></article>
        <article class="sl-module-card"><span class="portal-module-icon"><i class="bi bi-calendar2-week"></i></span><span class="portal-status portal-status-ready">Sẵn sàng</span><small>S2-01</small><h2>Lịch làm việc</h2><p>Xếp nhiều ca làm trong ngày cho từng thợ theo tuần.</p><a class="btn btn-primary" asp-controller="WorkSchedules" asp-action="Index">Xếp lịch làm việc</a></article>
        <article class="sl-module-card"><span class="portal-module-icon"><i class="bi bi-calendar-x"></i></span><span class="portal-status portal-status-ready">Sẵn sàng</span><small>S2-02</small><h2>Ngày nghỉ salon</h2><p>Thiết lập khoảng nghỉ và kiểm tra các lịch hẹn bị ảnh hưởng trước khi lưu.</p><a class="btn btn-primary" href="/owner/holidays">Quản lý ngày nghỉ</a></article>
    </section>

    <section class="sl-info-note"><i class="bi bi-shield-check"></i><div><strong>Bảo mật tài khoản</strong><p>Owner được đổi mật khẩu nhưng không được quản trị tài khoản, vai trò hoặc audit log.</p><a asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a></div></section>
</div>

@section Scripts { <script src="~/js/auth.js" asp-append-version="true"></script><script>SalonAuth.requireSession({ endpoint: "/api/owner/session", contentId: "owner-content" });</script> }
