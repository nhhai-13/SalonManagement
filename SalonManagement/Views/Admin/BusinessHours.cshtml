@{
    ViewData["Title"] = "Giờ hoạt động";
}

<div id="hours-page" class="portal-page d-none">
    <div class="portal-page-heading">
        <div><span class="portal-kicker">S1-08 · Chủ tiệm</span><h1>Giờ hoạt động</h1><p>Cấu hình riêng từng ngày; ngày đóng cửa không cần nhập giờ.</p></div>
        <div><a class="btn btn-outline-secondary" href="/owner">Về khu vực chủ tiệm</a><span class="portal-timezone"><i class="bi bi-globe-asia-australia"></i> Asia/Ho_Chi_Minh</span></div>
    </div>
    <form id="hours-form" class="portal-panel">
        <div id="hours-list"></div>
        <div id="hours-result" class="alert d-none" role="alert"></div>
        <button class="btn btn-primary" type="submit"><i class="bi bi-check2-circle me-2"></i>Lưu cấu hình</button>
    </form>
</div>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script src="~/js/business-hours.js" asp-append-version="true"></script>
    <script>BusinessHoursPage.initialize();</script>
}
