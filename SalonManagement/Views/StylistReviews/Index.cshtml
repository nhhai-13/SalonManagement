@model IReadOnlyList<SalonManagement.Controllers.Owner.StylistReviewSummary>
@{
    ViewData["Title"] = "Đánh giá thợ";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="text-uppercase text-secondary small mb-1">Báo cáo chất lượng</p>
            <h1 class="h2 mb-1">Đánh giá của khách theo thợ</h1>
            <p class="text-muted mb-0">
                Chỉ hiển thị điểm trung bình khi thợ có <strong>ít nhất 5 lượt đánh giá</strong> để đảm bảo độ tin cậy.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-controller="StylistManagement" asp-action="Index">
                <i class="bi bi-people me-1"></i>Hồ sơ thợ
            </a>
            <a class="btn btn-outline-primary" asp-controller="OwnerReports" asp-action="Index">
                <i class="bi bi-graph-up me-1"></i>Báo cáo vận hành
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Thợ làm tóc</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Số lượt đánh giá</th>
                            <th class="text-center">Điểm trung bình</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold">@item.FullName</div>
                                    <small class="text-muted">Mã thợ: #@item.StylistId</small>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">Đang làm việc</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Tạm ngưng</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="fw-semibold">@item.ReviewCount</span> lượt
                                </td>
                                <td class="text-center">
                                    @if (item.HasSufficientReviews && item.AverageRating.HasValue)
                                    {
                                        <span class="badge bg-warning-subtle text-dark fs-6 px-3 py-2">
                                            <i class="bi bi-star-fill text-warning me-1"></i>@item.AverageRating.Value.ToString("0.0") / 5
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border px-3 py-2">
                                            <i class="bi bi-info-circle me-1"></i>@item.RatingDisplay
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.StylistId">
                                        <i class="bi bi-card-text me-1"></i>Xem góp ý
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    Chưa có dữ liệu thợ trong hệ thống.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
