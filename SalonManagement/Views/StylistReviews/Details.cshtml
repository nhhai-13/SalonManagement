@model SalonManagement.Controllers.Owner.StylistReviewDetailsViewModel
@{
    ViewData["Title"] = $"Đánh giá: {Model.FullName}";
}

<div class="container py-4">
    <div class="mb-3">
        <a class="text-decoration-none text-muted" asp-action="Index">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách thợ
        </a>
    </div>

    <!-- STYLIST HEADER CARD -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; font-size: 1.5rem;">
                        <i class="bi bi-person-badge"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h1 class="h3 fw-bold mb-0">@Model.FullName</h1>
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">Đang làm việc</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Tạm ngưng</span>
                            }
                        </div>
                        <small class="text-muted">Mã định danh thợ: #@Model.StylistId</small>
                    </div>
                </div>

                <div class="text-end">
                    @if (Model.HasSufficientReviews && Model.AverageRating.HasValue)
                    {
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-2 bg-warning-subtle rounded-3">
                            <i class="bi bi-star-fill text-warning fs-4"></i>
                            <div>
                                <span class="fs-4 fw-bold text-dark">@Model.AverageRating.Value.ToString("0.0")</span>
                                <span class="text-muted small">/ 5 sao</span>
                            </div>
                        </div>
                        <div class="text-muted small mt-1">Tổng cộng @Model.ReviewCount lượt đánh giá</div>
                    }
                    else
                    {
                        <div class="badge bg-light text-secondary border fs-6 px-3 py-2">
                            <i class="bi bi-info-circle me-1"></i>@Model.RatingDisplay
                        </div>
                        <div class="text-muted small mt-1">Cần tối thiểu 5 lượt để mở khóa điểm trung bình</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- RECENT REVIEWS SECTION -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
            <h2 class="h5 fw-bold mb-0">Lịch sử đánh giá &amp; góp ý gần đây</h2>
        </div>
        <div class="card-body p-4 pt-2">
            @if (Model.RecentReviews.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-chat-square-text display-4 d-block mb-3 text-secondary opacity-50"></i>
                    <p class="mb-0">Thợ này chưa nhận được đánh giá nào từ khách hàng.</p>
                </div>
            }
            else
            {
                <div class="vstack gap-3">
                    @foreach (var review in Model.RecentReviews)
                    {
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="text-warning">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= review.Rating)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-muted"></i>
                                            }
                                        }
                                        <span class="fw-bold ms-1 text-dark">@review.Rating / 5</span>
                                    </div>
                                    <div class="small text-muted mt-1">
                                        Khách hàng: <strong>@review.CustomerName</strong> · Mã lịch: <span class="font-monospace">@review.BookingReference</span>
                                    </div>
                                </div>
                                <small class="text-secondary">
                                    <i class="bi bi-clock me-1"></i>@review.SubmittedAt.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <div class="mt-2 pt-2 border-top text-dark">
                                    <i class="bi bi-chat-quote text-secondary me-1"></i>"@review.Comment"
                                </div>
                            }
                            else
                            {
                                <div class="mt-2 pt-2 border-top text-muted small fst-italic">
                                    (Khách không để lại góp ý văn bản)
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
