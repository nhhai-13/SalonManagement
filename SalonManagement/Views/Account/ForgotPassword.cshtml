@model SalonManagement.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">

        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body px-4 py-4 px-sm-5">

                <div class="text-center mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor"
                         class="bi bi-envelope-at text-warning mb-2" viewBox="0 0 16 16">
                        <path d="M2 2a2 2 0 0 0-2 2v8.01A2 2 0 0 0 2 14h5.5a.5.5 0 0 0 0-1H2a1 1 0 0 1-.966-.741l5.64-3.471L8 9.583l7-4.29V8.5a.5.5 0 0 0 1 0V4a2 2 0 0 0-2-2H2Zm3.708 6.208L1 11.105V5.383l4.708 2.825ZM1 4.217V4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v.217l-7 4.29-7-4.29Z"/>
                        <path d="M14.5 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm.354-5.354a.5.5 0 0 1 0 .708l-1 1a.5.5 0 0 1-.707-.708l.146-.146H12.5a.5.5 0 0 1 0-1h.793l-.147-.146a.5.5 0 0 1 .708-.708l1 1Z"/>
                    </svg>
                    <h2 class="h4 fw-bold mb-0">Quên mật khẩu</h2>
                    <p class="text-muted small mt-1">
                        Nhập email đã đăng ký — chúng tôi sẽ gửi link đặt lại mật khẩu cho bạn.
                    </p>
                </div>

                @{
                    var modelErrors = ViewData.ModelState[string.Empty]?.Errors
                        .Select(e => e.ErrorMessage)
                        .Where(m => !string.IsNullOrWhiteSpace(m))
                        .ToList() ?? new List<string>();

                    var allErrors = ViewData.ModelState.Values
                        .SelectMany(v => v.Errors)
                        .Select(e => e.ErrorMessage)
                        .Where(m => !string.IsNullOrWhiteSpace(m))
                        .Distinct()
                        .ToList();

                    var displayErrors = modelErrors.Count > 0 ? modelErrors : allErrors;

                    var customError = ViewData["ErrorMessage"]?.ToString() ?? TempData["ErrorMessage"]?.ToString();
                    if (!string.IsNullOrEmpty(customError) && !displayErrors.Contains(customError))
                    {
                        displayErrors.Add(customError);
                    }

                    var successMessage = ViewData["SuccessMessage"]?.ToString() ?? TempData["SuccessMessage"]?.ToString();
                }

                @if (displayErrors.Count > 0)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @if (displayErrors.Count == 1)
                        {
                            <span>@displayErrors[0]</span>
                        }
                        else
                        {
                            <ul class="mb-0 ps-3">
                                @foreach (var err in displayErrors)
                                {
                                    <li>@err</li>
                                }
                            </ul>
                        }
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <span>@successMessage</span>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                    </div>
                }

                <form asp-action="ForgotPassword" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                     class="bi bi-envelope" viewBox="0 0 16 16">
                                    <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"/>
                                </svg>
                            </span>
                            <input asp-for="Email" class="form-control"
                                   type="email" placeholder="example@email.com"
                                   autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="alert alert-info small py-2 mb-4" role="alert">
                        <strong>Lưu ý:</strong> Bạn chỉ có thể yêu cầu tối đa <strong>3 lần</strong> trong vòng 1 giờ.
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-warning btn-lg fw-semibold text-white">
                            Gửi link đặt lại mật khẩu
                        </button>
                    </div>
                </form>

                <hr class="my-4" />
                <div class="text-center">
                    <a asp-area="Identity" asp-page="/Account/Login"
                       class="text-muted small text-decoration-none">
                        ← Quay lại đăng nhập
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
