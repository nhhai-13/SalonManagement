@model SalonManagement.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">

        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body px-4 py-4 px-sm-5">

                <div class="text-center mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor"
                         class="bi bi-shield-lock text-primary mb-2" viewBox="0 0 16 16">
                        <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.543 9.188a11.384 11.384 0 0 0 2.943 2.479.52.52 0 0 0 .556 0 11.384 11.384 0 0 0 2.943-2.479c1.817-1.998 3.097-5.031 2.543-9.188a.48.48 0 0 0-.328-.39c-.98-.31-2.002-.567-2.837-.856C9.552 1.29 8.77 1 8 1c-.77 0-1.552.29-2.662.59z"/>
                        <path d="M9.5 6.5a1.5 1.5 0 0 1-1 1.415V8a.5.5 0 0 1-1 0v-.085A1.5 1.5 0 1 1 9.5 6.5z"/>
                    </svg>
                    <h2 class="h4 fw-bold mb-0">Đổi mật khẩu</h2>
                    <p class="text-muted small mt-1">Cập nhật mật khẩu tài khoản của bạn</p>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <asp-validation-summary asp-validation-group="" class="mb-0" />
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-action="ChangePassword" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="CurrentPassword" class="form-control"
                                   placeholder="Nhập mật khẩu hiện tại"
                                   autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input asp-for="NewPassword" class="form-control"
                                   placeholder="Tối thiểu 8 ký tự, gồm chữ và số"
                                   autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <div class="form-text">Mật khẩu phải có ít nhất 8 ký tự, gồm cả chữ cái và chữ số.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control"
                                   placeholder="Nhập lại mật khẩu mới"
                                   autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold">
                            Đổi mật khẩu
                        </button>
                    </div>
                </form>

                <hr class="my-4" />
                <div class="text-center">
                    <a asp-area="" asp-controller="Home" asp-action="Index"
                       class="text-muted small text-decoration-none">
                        ← Quay về trang chủ
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
