@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">

        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body px-4 py-5 px-sm-5 text-center">

                <div class="mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor"
                         class="bi bi-patch-check-fill text-success mb-3" viewBox="0 0 16 16">
                        <path d="M10.067.87a2.89 2.89 0 0 0-4.134 0l-.622.638-.89-.011a2.89 2.89 0 0 0-2.924 2.924l.01.89-.636.622a2.89 2.89 0 0 0 0 4.134l.637.622-.011.89a2.89 2.89 0 0 0 2.924 2.924l.89-.01.622.636a2.89 2.89 0 0 0 4.134 0l.622-.637.89.011a2.89 2.89 0 0 0 2.924-2.924l-.01-.89.636-.622a2.89 2.89 0 0 0 0-4.134l-.637-.622.011-.89a2.89 2.89 0 0 0-2.924-2.924l-.89.01-.622-.636zm.287 5.984-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7 8.793l2.646-2.647a.5.5 0 0 1 .708.708z"/>
                    </svg>
                    <h2 class="h4 fw-bold text-success">Mật khẩu đã được đặt lại!</h2>
                </div>

                <div class="alert alert-success border-0 text-start" role="alert">
                    <p class="mb-2">
                        Mật khẩu của bạn đã được cập nhật thành công.
                    </p>
                    <p class="mb-0 small">
                        🔒 Tất cả các phiên đăng nhập cũ đã bị <strong>hủy</strong> để bảo vệ tài khoản.
                        Vui lòng đăng nhập lại bằng mật khẩu mới.
                    </p>
                </div>

                <div class="d-grid mt-4">
                    <a asp-area="Identity" asp-page="/Account/Login"
                       class="btn btn-primary btn-lg fw-semibold">
                        Đăng nhập ngay
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>
