@{ ViewData["Title"] = "Trang tổng quan vận hành"; }
<main id="owner-operations-content" class="container-fluid d-none py-3 owner-operations" aria-live="polite">
    <header class="owner-operations-header"><div><span class="stylist-command-eyebrow">Quản lý tiệm</span><h1>Trang tổng quan vận hành hôm nay</h1><p id="owner-operations-date">Đang tải tình hình vận hành…</p></div><div><span id="owner-refresh-countdown" class="owner-refresh-countdown">Tự làm mới sau: 60s</span><button id="owner-refresh-now" class="btn btn-primary" type="button"><i class="bi bi-arrow-clockwise"></i> Làm mới ngay</button></div></header>
    <div id="owner-operations-error" class="alert alert-danger d-none" role="alert"></div>
    <section class="owner-operations-kpis"><article class="revenue"><span>Doanh thu đã thu trong ngày</span><strong id="owner-today-revenue">—</strong><small>Chỉ gồm phiếu đã thanh toán</small></article><article class="staff"><span>Số thợ đang làm việc theo ca</span><strong id="owner-stylists-on-duty">—</strong><small id="owner-staff-caption">Đang tải lịch ca…</small></article></section>
    <h2 class="owner-status-title">Lịch hẹn hôm nay theo trạng thái <small>Bấm một nhóm để mở danh sách</small></h2>
    <section id="owner-status-grid" class="owner-status-grid" aria-label="Sáu trạng thái lịch hẹn"></section>
    <section id="owner-drilldown" class="owner-drilldown d-none"><header><strong id="owner-drilldown-title">Danh sách lịch hẹn</strong><button id="owner-drilldown-close" type="button" class="btn-close" aria-label="Đóng"></button></header><div class="table-responsive"><table class="table"><thead><tr><th>Giờ hẹn</th><th>Khách hàng</th><th>Dịch vụ đăng ký</th><th>Thợ phụ trách</th><th id="owner-drilldown-action-head">Trạng thái</th></tr></thead><tbody id="owner-drilldown-rows"></tbody></table></div></section>
</main>
@section Scripts { <script src="~/js/auth.js" asp-append-version="true"></script><script src="~/js/owner-operations-dashboard.js" asp-append-version="true"></script><script>SalonAuth.requireSession({ endpoint: "/api/owner/session", contentId: "owner-operations-content" }).then(() => OwnerOperationsDashboard.start());</script> }
