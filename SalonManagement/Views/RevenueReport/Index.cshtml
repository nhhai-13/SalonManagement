@{ ViewData["Title"] = "Báo cáo doanh thu"; }

<main id="revenue-report-content" class="container-fluid d-none py-3 revenue-report" aria-live="polite">
    <header class="revenue-report-header"><div><span class="stylist-command-eyebrow">Quản lý tiệm · S4-07</span><h1>Báo cáo doanh thu theo Thợ &amp; Dịch vụ</h1><p>Chỉ tổng hợp phiếu đã thanh toán để số liệu doanh thu được khóa sổ chính xác.</p></div><a id="revenue-export" class="btn btn-success" href="#"><i class="bi bi-download"></i> Xuất tệp CSV (UTF-8)</a></header>
    <section class="revenue-filter" aria-label="Bộ lọc khoảng ngày"><label>Từ ngày <input id="revenue-from" class="form-control" type="date" /></label><label>Đến ngày <input id="revenue-to" class="form-control" type="date" /></label><button class="btn btn-primary" id="revenue-apply" type="button">Xem báo cáo</button><div class="btn-group" role="group"><button class="btn btn-outline-secondary btn-sm" type="button" data-revenue-preset="current">Tháng này</button><button class="btn btn-outline-secondary btn-sm" type="button" data-revenue-preset="previous">Tháng trước</button><button class="btn btn-outline-secondary btn-sm" type="button" data-revenue-preset="30days">30 ngày qua</button></div><span class="revenue-lock"><i class="bi bi-lock-fill"></i> Đã khóa sổ: chỉ tính phiếu đã thanh toán</span></section>
    <div id="revenue-report-error" class="alert alert-danger d-none mt-3" role="alert"></div>
    <section class="revenue-kpis" aria-label="Chỉ số doanh thu"><article><span>Tổng doanh thu thực thu</span><strong id="revenue-total">—</strong><small>Khớp với các phiếu đã thanh toán</small></article><article><span>Tổng lượt hoàn tất</span><strong id="revenue-count">—</strong><small>Phiếu thanh toán trong kỳ</small></article><article><span>Doanh thu trung bình / lượt</span><strong id="revenue-average">—</strong><small>Tổng thực thu / tổng lượt</small></article></section>
    <section class="revenue-tables"><article><header><i class="bi bi-person-workspace"></i> Doanh thu theo Thợ</header><div class="table-responsive"><table class="table"><thead><tr><th>Thợ / Kỹ thuật viên</th><th class="text-end">Số lượt</th><th class="text-end">Tổng doanh thu</th><th class="text-end">TB / lượt</th></tr></thead><tbody id="revenue-by-stylist"></tbody></table></div></article><article><header><i class="bi bi-scissors"></i> Doanh thu theo Dịch vụ <small>· giảm dần theo tổng tiền</small></header><div class="table-responsive"><table class="table"><thead><tr><th>Tên dịch vụ</th><th class="text-end">Số lượt</th><th class="text-end">Tổng tiền ↓</th><th class="text-end">Tỷ trọng</th></tr></thead><tbody id="revenue-by-service"></tbody></table></div></article></section>
</main>

@section Scripts { <script src="~/js/auth.js" asp-append-version="true"></script><script src="~/js/revenue-report.js" asp-append-version="true"></script><script>SalonAuth.requireSession({ endpoint: "/api/owner/session", contentId: "revenue-report-content" }).then(() => RevenueReport.start());</script> }
