@model SalonManagement.Models.DeskBookingRequest
@{ ViewData["Title"] = "Đặt lịch tại quầy"; List<SalonManagement.Models.Stylist> stylists = ViewBag.Stylists; List<SalonManagement.Models.Service> services = ViewBag.Services; }
<h1>Đặt lịch tại quầy</h1>
<form asp-action="Create" method="post" class="card card-body" style="max-width:680px">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<label asp-for="FullName">Tên khách</label><input asp-for="FullName" class="form-control mb-2" required maxlength="150" />
<label asp-for="Phone">Số điện thoại</label><input asp-for="Phone" class="form-control mb-2" type="tel" pattern="0[0-9]{9}" required />
<p id="booking-warning" role="status" class="text-danger"></p>
<label class="mb-2"><input asp-for="AcknowledgeNoShow" /> Tôi đã xem cảnh báo khách không đến (nếu có).</label>
<label asp-for="StylistId">Thợ phụ trách</label><select asp-for="StylistId" class="form-select mb-2" required><option value="">Chọn thợ</option>@foreach (var stylist in stylists) { <option value="@stylist.StylistId">@stylist.FullName</option> }</select>
<label asp-for="ServiceId">Dịch vụ</label><select asp-for="ServiceId" class="form-select mb-2" required><option value="">Chọn dịch vụ</option>@foreach (var service in services) { <option value="@service.ServiceId">@service.ServiceName (@service.DurationMinutes phút)</option> }</select>
<label asp-for="StartsAt">Ngày giờ hẹn</label><input asp-for="StartsAt" type="datetime-local" class="form-control mb-2" required />
<p>Thời lượng tính theo dịch vụ. Lịch không đến không giữ khung giờ; hệ thống kiểm tra ca làm và trùng lịch khi lưu.</p>
<button class="btn btn-primary">Đặt lịch</button><a asp-action="Index" class="mt-2">Về lịch ngày</a>
</form>
@section Scripts {
<script>
const phone = document.getElementById('Phone');
let requestNumber = 0;
async function checkWarning() {
    const current = ++requestNumber;
    document.getElementById('AcknowledgeNoShow').checked = false;
    const output = document.getElementById('booking-warning');
    if (!phone.checkValidity()) { output.textContent = ''; return; }
    try {
        const response = await fetch('@Url.Action("CustomerWarning")?phone=' + encodeURIComponent(phone.value));
        const result = await response.json();
        if (current === requestNumber) output.textContent = result.message || 'Không thể kiểm tra khách.';
    } catch { if (current === requestNumber) output.textContent = 'Không thể kiểm tra. Hệ thống sẽ kiểm tra lại khi lưu.'; }
}
phone.addEventListener('input', checkWarning);
if (phone.value) checkWarning();
</script>
}
