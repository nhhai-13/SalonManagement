@using SalonManagement.Models
@using SalonManagement.Services
@model List<Appointment>
@{
    ViewData["Title"] = "Khách không đến";
    DateTime day = ViewBag.Day;
    DateTimeOffset now = ViewBag.Now;
    Dictionary<string, int> counts = ViewBag.NoShowCounts;
    string Label(string status) => status switch { "Pending" => "Chờ xác nhận", "Confirmed" => "Đã xác nhận", "Arrived" => "Đã đến", "NoShow" => "Không đến", "Cancelled" => "Đã huỷ", "Completed" => "Hoàn tất", _ => status };
}
<div class="attendance-page">
@await Html.PartialAsync("_AttendanceStyles")
<div class="attendance-heading"><div><span class="attendance-kicker">LUMINOL · LỄ TÂN</span><h1>Khách không đến</h1></div><span class="attendance-total">@Model.Count lịch hẹn</span></div>
<p><a class="btn btn-primary" asp-action="Create">Đặt lịch tại quầy</a></p>
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
<form method="get" class="attendance-toolbar"><label for="date">Ngày xem lịch</label> <input class="form-control" type="date" id="date" name="date" value="@day.ToString("yyyy-MM-dd")" required /> <button class="btn btn-primary">Xem lịch</button></form>
<form id="customer-warning" class="attendance-warning">
<label for="phone">Kiểm tra khách trước khi đặt lịch</label>
<input class="form-control" id="phone" name="phone" type="tel" maxlength="20" required placeholder="Số điện thoại" />
<button class="btn btn-outline-primary">Kiểm tra</button><p id="warning-result" role="status"></p>
</form>
<section class="card card-body my-3" aria-labelledby="customer-search-heading">
<h2 id="customer-search-heading" class="h5">Hồ sơ khách hàng</h2>
<label for="customer-search">Tìm theo tên hoặc số điện thoại</label>
<input id="customer-search" class="form-control" type="search" minlength="2" autocomplete="off" />
<div id="customer-search-results" class="mt-2" aria-live="polite"></div>
</section>

@if (Model.Count == 0) { <div class="attendance-empty"><h2>Chưa có lịch hẹn</h2><p>Chọn ngày khác để xem lịch của khách.</p></div> }
@foreach (var a in Model) {
    <article class="card attendance-card mb-3"><div class="card-body">
        <h2 class="h5">@a.StartTime.ToString(@"hh\:mm") – @a.EndTime.ToString(@"hh\:mm") · @a.Customer.FullName</h2>
        <p>@a.Customer.Phone · Thợ: @a.Stylist.FullName · <strong class="attendance-status attendance-status-@a.Status.ToLowerInvariant()">@Label(a.Status)</strong></p>
        @if (a.CheckedInAt.HasValue) { <p>Giờ đến: @a.CheckedInAt.Value.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm 'ngày' dd/MM/yyyy")</p> }
        @if (a.LateMinutes > 0) { <p class="text-danger">Đến muộn @a.LateMinutes phút</p> }
        @if (counts.GetValueOrDefault(a.Customer.Phone) > 0) { <p class="text-danger">Cảnh báo: khách đã không đến @counts[a.Customer.Phone] lần.</p> }
        <form asp-action="Change" method="post" class="d-flex flex-wrap gap-2">
            <input type="hidden" name="id" value="@a.AppointmentId" /><input type="hidden" name="date" value="@day.ToString("yyyy-MM-dd")" />
            <button class="btn btn-outline-danger" name="operation" value="no-show" disabled="@(!NoShowService.CanMarkNoShow(a, now))">Không đến</button>
            @if (a.Status == AppointmentStatuses.NoShow) { <button class="btn btn-outline-secondary" name="operation" value="undo-no-show" disabled="@(!NoShowService.CanUndo(a, now))">Hoàn tác không đến</button> }
        </form>
    </div></article>
}
</div>
@section Scripts {
<script src="~/js/auth.js" asp-append-version="true"></script>
<script>
document.getElementById('customer-warning').addEventListener('submit', async e => {
    e.preventDefault();
    const output = document.getElementById('warning-result');
    try {
        const response = await fetch('@Url.Action("CustomerWarning", "NoShows")?phone=' + encodeURIComponent(document.getElementById('phone').value));
        const data = await response.json();
        output.textContent = data.message || 'Không thể kiểm tra khách.';
    } catch { output.textContent = 'Không thể kết nối. Vui lòng thử lại.'; }
});
let customerSearchTimer;
document.getElementById('customer-search').addEventListener('input', event => {
    clearTimeout(customerSearchTimer);
    customerSearchTimer = setTimeout(() => searchCustomers(event.target.value), 250);
});
async function searchCustomers(query) {
    const results = document.getElementById('customer-search-results');
    results.replaceChildren();
    if (query.trim().length < 2) return;
    try {
        const response = await SalonAuth.authenticatedFetch('/api/reception/customers?query=' + encodeURIComponent(query));
        if (!response.ok) throw new Error();
        const customers = await response.json();
        if (!customers.length) { results.textContent = 'Không tìm thấy hồ sơ phù hợp.'; return; }
        for (const customer of customers) {
            const row = document.createElement('article'); row.className = 'border rounded p-2 mb-2';
            const title = document.createElement('strong'); title.textContent = `${customer.fullName} · ${customer.phone}`;
            const counts = document.createElement('p'); counts.className = 'mb-1'; counts.textContent = `${customer.totalVisits} lần hoàn tất · ${customer.noShowCount} lần không đến${customer.email ? ` · ${customer.email}` : ''}`;
            const notes = document.createElement('p'); notes.className = 'mb-0'; notes.textContent = customer.notes || 'Chưa có ghi chú riêng.';
            row.append(title, counts, notes); results.append(row);
        }
    } catch { results.textContent = 'Không thể tìm hồ sơ lúc này. Vui lòng thử lại.'; }
}
setTimeout(() => { if (!document.querySelector('input:focus')) location.reload(); }, 30000);
</script>
}
