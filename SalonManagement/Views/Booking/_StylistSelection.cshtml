<section id="stylist-selection" class="card p-3 my-4" hidden
         data-stylists-url="@Url.Action("Stylists", "StylistAvailability")"
         data-slots-url="@Url.Action("Slots", "StylistAvailability")"
         data-assignment-url="@Url.Action("Assignment", "StylistAvailability")">
    <h2 class="h4">Choose a stylist and time</h2>
    <p>Choose a specific stylist or “Any stylist” to see available times for all your selected services.</p>
    <p id="stylist-message" role="status" aria-live="polite"></p>
    <div id="stylist-options" class="d-flex flex-wrap gap-2" role="group" aria-label="Available stylists"></div>
    <label for="booking-date" class="form-label mt-3">Appointment date</label>
    <input id="booking-date" type="date" class="form-control" />
    <p id="slot-message" role="status" aria-live="polite" class="mt-3"></p>
    <div id="slot-options" class="d-flex flex-wrap gap-2" role="group" aria-label="Available times"></div>
    <input type="hidden" id="selected-stylist" name="stylistId" />
    <input type="hidden" id="selected-slot" name="startTime" />
    <button type="button" id="confirm-stylist-selection" class="btn btn-primary mt-3" disabled>Confirm selection</button>
    <div id="assignment-confirmation" class="border rounded p-3 mt-3" hidden aria-live="polite">
        <h3 class="h5">Selection summary</h3>
        <p id="assignment-message" role="status"></p>
        <p id="assignment-detail"></p>
        <p class="text-muted mb-0">This selection does not reserve a time or create an appointment.</p>
    </div>
    <noscript>Enable JavaScript to choose a stylist and view available times.</noscript>
</section>
