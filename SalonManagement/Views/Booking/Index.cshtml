@model IReadOnlyList<SalonManagement.Models.Service>
@{ ViewData["Title"] = "Chọn khung giờ"; }
<div class="container py-4"><h1 class="h2">Đặt lịch</h1><p class="text-muted">Chọn dịch vụ và ngày để xem khung giờ trống.</p><div class="card shadow-sm"><div class="card-body"><div class="mb-3"><label class="form-label">Dịch vụ</label>@foreach (var service in Model) { <div class="form-check"><input class="form-check-input service-choice" type="checkbox" value="@service.ServiceId" id="service-@service.ServiceId" /><label class="form-check-label" for="service-@service.ServiceId">@service.ServiceName (@service.DurationMinutes phút)</label></div> }</div><label class="form-label" for="booking-date">Ngày hẹn</label><input id="booking-date" class="form-control" type="date" min="@ViewData["BookingMinDate"]" /><div id="slot-message" class="text-muted mt-3"></div><div id="slot-list" class="d-flex flex-wrap gap-2 mt-2"></div></div></div></div>
@section Scripts { <script>const date=document.getElementById('booking-date'), list=document.getElementById('slot-list'), message=document.getElementById('slot-message'); async function load(){const ids=[...document.querySelectorAll('.service-choice:checked')].map(x=>x.value); if(!date.value||!ids.length){list.replaceChildren();message.textContent='Chọn ngày và ít nhất một dịch vụ.';return;} const r=await fetch(`/booking/slots?date=${date.value}&serviceIds=${ids.join('&serviceIds=')}`);const d=await r.json(); if(!r.ok){message.textContent=d.message;return;} message.textContent=`Tổng thời lượng: ${d.totalDurationMinutes} phút.`;list.replaceChildren(...d.slots.map(s=>{const b=document.createElement('button');b.className='btn btn-outline-primary';b.type='button';b.textContent=s;return b;}));} date.addEventListener('change',load);document.querySelectorAll('.service-choice').forEach(x=>x.addEventListener('change',load));</script> }
