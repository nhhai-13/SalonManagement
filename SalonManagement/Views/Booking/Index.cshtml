@model IReadOnlyList<SalonManagement.Models.Service>
@{ ViewData["Title"] = "Chọn khung giờ"; }
<div class="container py-4"><h1 class="h2">Đặt lịch</h1><p class="text-muted">Chọn dịch vụ và ngày để xem khung giờ trống.</p><div class="card shadow-sm"><div class="card-body"><div class="mb-3"><label class="form-label">Dịch vụ</label>@foreach (var service in Model) { <div class="form-check"><input class="form-check-input service-choice" type="checkbox" value="@service.ServiceId" id="service-@service.ServiceId" /><label class="form-check-label" for="service-@service.ServiceId">@service.ServiceName (@service.DurationMinutes phút)</label></div> }</div><label class="form-label" for="booking-date">Ngày hẹn</label><input id="booking-date" class="form-control" type="date" min="@ViewData["BookingMinDate"]" /><div id="slot-message" class="text-muted mt-3"></div><div id="slot-list" class="d-flex flex-wrap gap-2 mt-2"></div><div id="no-slots" class="alert alert-info mt-3 d-none" role="status"><div>Không còn khung giờ trống trong ngày đã chọn.</div><div id="suggestion-message" class="small mt-2"></div><div id="suggestion-list" class="d-flex flex-wrap gap-2 mt-2"></div></div><form id="booking-form" class="mt-4 d-none"><h2 class="h5">Thông tin khách</h2><div class="mb-3"><label class="form-label" for="customer-name">Họ tên</label><input id="customer-name" class="form-control" required /></div><div class="mb-3"><label class="form-label" for="customer-phone">Số điện thoại</label><input id="customer-phone" class="form-control" inputmode="numeric" required /></div><button id="confirm-booking" class="btn btn-primary w-100" type="submit">Chốt lịch</button></form><div id="booking-result" class="mt-4"></div></div></div></div>
@section Scripts { <script>const date=document.getElementById('booking-date'), list=document.getElementById('slot-list'), message=document.getElementById('slot-message'), noSlots=document.getElementById('no-slots'), suggestionMessage=document.getElementById('suggestion-message'), suggestionList=document.getElementById('suggestion-list'), form=document.getElementById('booking-form'), result=document.getElementById('booking-result'), confirm=document.getElementById('confirm-booking');let selectedTime='';const ids=()=>[...document.querySelectorAll('.service-choice:checked')].map(x=>Number(x.value));function clearEmpty(){noSlots.classList.add('d-none');suggestionList.replaceChildren();} async function load(){selectedTime='';form.classList.add('d-none');result.replaceChildren();clearEmpty();if(!date.value||!ids().length){list.replaceChildren();message.textContent='Chọn ngày và ít nhất một dịch vụ.';return;}const r=await fetch(`/booking/slots?date=${date.value}&serviceIds=${ids().join('&serviceIds=')}`),d=await r.json();if(!r.ok){list.replaceChildren();message.textContent=d.message;return;}message.textContent=`Tổng thời lượng: ${d.totalDurationMinutes} phút.`;list.replaceChildren(...d.slots.map(s=>{const b=document.createElement('button');b.className='btn btn-outline-primary';b.type='button';b.textContent=s;b.addEventListener('click',()=>{selectedTime=s;form.classList.remove('d-none');});return b;}));if(!d.slots.length){noSlots.classList.remove('d-none');suggestionMessage.textContent=d.suggestions.length?'Bạn có thể chọn một trong các ngày còn chỗ:':'Chưa tìm thấy ngày còn chỗ trong 14 ngày tới.';suggestionList.replaceChildren(...d.suggestions.map(item=>{const b=document.createElement('button');b.className='btn btn-primary';b.type='button';b.textContent=`${item.label} · sớm nhất ${item.earliestSlot}`;b.addEventListener('click',()=>{date.value=item.date;load();});return b;}));}}form.addEventListener('submit',async event=>{event.preventDefault();confirm.disabled=true;confirm.textContent='Đang xử lý…';const r=await fetch('/booking/confirm',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({date:date.value,startTime:selectedTime,serviceIds:ids(),fullName:document.getElementById('customer-name').value,phone:document.getElementById('customer-phone').value})}),d=await r.json();confirm.disabled=false;confirm.textContent='Chốt lịch';if(!r.ok){result.textContent=d.message;result.className='alert alert-danger mt-4';return;}form.classList.add('d-none');result.className='alert alert-success mt-4';result.innerHTML=`<strong>Mã tra cứu: ${d.reference}</strong><br>${d.services.join(', ')} · ${d.stylistName}<br>${d.date}, ${d.startTime}–${d.endTime}`;load();});date.addEventListener('change',load);document.querySelectorAll('.service-choice').forEach(x=>x.addEventListener('change',load));</script> }
