@model IReadOnlyList<SalonManagement.Controllers.AccessRequestsController.PendingAccessRequest>
@using SalonManagement.Models
@{
    ViewData["Title"] = "Yêu cầu cấp quyền";
    string RoleLabel(string role) => role == UserRoles.Stylist ? "Thợ" : "Lễ tân";
}

<section class="sl-body">
    <header class="sl-page-heading">
        <div>
            <span class="sl-eyebrow">Quyền truy cập nhân viên</span>
            <h1>Yêu cầu cấp quyền</h1>
            <p>Các tài khoản dưới đây đã xác minh email và đang chờ được cấp quyền truy cập.</p>
        </div>
    </header>

    @if (TempData["AccessRequestSuccess"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["AccessRequestError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="sl-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tài khoản</th>
                        <th>Quyền yêu cầu</th>
                        <th>Thời điểm xác minh</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-5">Không có yêu cầu cấp quyền đang chờ.</td></tr>
                }
                else
                {
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>
                                <strong>@(string.IsNullOrWhiteSpace(request.FullName) ? request.Email : request.FullName)</strong>
                                <small class="d-block text-muted">@request.Email</small>
                                @if (!string.IsNullOrWhiteSpace(request.PhoneNumber))
                                {
                                    <small class="d-block text-muted">@request.PhoneNumber</small>
                                }
                            </td>
                            <td><span class="badge text-bg-primary">@RoleLabel(request.RequestedRole)</span></td>
                            <td>@(request.RequestedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                            <td class="text-end">
                                <form method="post" action="/management/access-requests/@request.Id/approve" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-success" type="submit" onclick="return confirm('Cấp quyền @RoleLabel(request.RequestedRole) cho @request.Email?');">
                                        <i class="bi bi-check2-circle"></i> Cấp quyền @RoleLabel(request.RequestedRole)
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
