@model IReadOnlyList<SalonManagement.Controllers.AccessRequestsController.PendingAccessRequest>
@using SalonManagement.Models
@{
    ViewData["Title"] = "Yêu cầu cấp quyền";
    string RoleLabel(string role) => role == UserRoles.Stylist ? "Thợ" : "Lễ tân";
}

<section class="sl-body">
    <header class="sl-page-heading">
        <div>
            <span class="sl-eyebrow">Quyền truy cập nhân viên</span>
            <h1>Yêu cầu cấp quyền</h1>
            <p>Các tài khoản dưới đây đã xác minh email và đang chờ được cấp quyền truy cập.</p>
        </div>
    </header>

    @if (TempData["AccessRequestSuccess"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["AccessRequestError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="sl-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tài khoản</th>
                        <th>Quyền yêu cầu</th>
                        <th>Thời điểm xác minh</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-5">Không có yêu cầu cấp quyền đang chờ.</td></tr>
                }
                else
                {
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>
                                <strong>@(string.IsNullOrWhiteSpace(request.FullName) ? request.Email : request.FullName)</strong>
                                <small class="d-block text-muted">@request.Email</small>
                                @if (!string.IsNullOrWhiteSpace(request.PhoneNumber))
                                {
                                    <small class="d-block text-muted">@request.PhoneNumber</small>
                                }
                            </td>
                            <td><span class="badge text-bg-primary">@RoleLabel(request.RequestedRole)</span></td>
                            <td>@(request.RequestedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                            <td class="text-end">
                                <form method="post" action="/management/access-requests/@request.Id/approve" class="d-inline" data-access-approval-form>
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-success" type="button"
                                            data-access-approval-trigger
                                            data-access-name="@(string.IsNullOrWhiteSpace(request.FullName) ? request.Email : request.FullName)"
                                            data-access-email="@request.Email"
                                            data-access-role="@RoleLabel(request.RequestedRole)">
                                        <i class="bi bi-check2-circle"></i> Cấp quyền @RoleLabel(request.RequestedRole)
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</section>

<dialog id="access-approval-dialog" class="access-approval-dialog" aria-labelledby="access-approval-title" aria-describedby="access-approval-description">
    <form method="dialog" class="access-approval-card">
        <header>
            <div class="access-approval-icon" aria-hidden="true"><i class="bi bi-person-check-fill"></i></div>
            <div>
                <span class="access-approval-eyebrow">Xác nhận cấp quyền</span>
                <h2 id="access-approval-title">Cấp quyền truy cập nhân viên</h2>
            </div>
            <button class="btn-close" value="cancel" aria-label="Đóng"></button>
        </header>
        <div class="access-approval-body">
            <p id="access-approval-description">Bạn sắp cấp quyền <strong data-access-approval-role>—</strong> cho tài khoản bên dưới.</p>
            <section class="access-approval-account" aria-label="Tài khoản được cấp quyền">
                <span class="access-approval-avatar" aria-hidden="true"><i class="bi bi-person"></i></span>
                <div>
                    <strong data-access-approval-name>—</strong>
                    <span data-access-approval-email>—</span>
                </div>
            </section>
            <div class="access-approval-notice">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                <div>
                    <strong>Quyền sẽ có hiệu lực ngay</strong>
                    <span>Người dùng có thể đăng nhập và sử dụng các chức năng dành cho <span data-access-approval-role>—</span> ngay sau khi xác nhận.</span>
                </div>
            </div>
        </div>
        <footer>
            <button class="btn btn-light border" value="cancel">Hủy</button>
            <button id="access-approval-confirm" type="button" class="btn btn-success"><i class="bi bi-check2-circle"></i> Xác nhận cấp quyền</button>
        </footer>
    </form>
</dialog>

@section Scripts {
<script>
    (() => {
        const dialog = document.getElementById('access-approval-dialog');
        if (!dialog) return;

        let selectedForm;
        const setText = (selector, value) => dialog.querySelectorAll(selector)
            .forEach(element => element.textContent = value || '—');

        document.querySelectorAll('[data-access-approval-trigger]').forEach(button => button.addEventListener('click', () => {
            selectedForm = button.closest('[data-access-approval-form]');
            setText('[data-access-approval-name]', button.dataset.accessName);
            setText('[data-access-approval-email]', button.dataset.accessEmail);
            setText('[data-access-approval-role]', button.dataset.accessRole);
            dialog.showModal();
        }));

        dialog.querySelector('#access-approval-confirm')?.addEventListener('click', () => {
            if (!selectedForm) return;
            dialog.close();
            selectedForm.requestSubmit();
        });

        dialog.addEventListener('close', () => { selectedForm = undefined; });
    })();
</script>
}
