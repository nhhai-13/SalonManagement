@{ ViewData["Title"] = "Ngày nghỉ"; var stylists = ViewBag.Stylists; }

<div id="time-off-page" class="container py-4 d-none">
    <div class="sl-page-header mb-4">
        <div><h1 class="sl-page-title h2 mb-1">Ngày nghỉ</h1><p class="text-muted mb-0">Khai báo ngày nghỉ của tiệm hoặc từng thợ.</p></div>
    </div>
    <div id="time-off-result" class="alert d-none" role="alert"></div>
    <div class="row g-4">
        <div class="col-lg-6"><section class="sl-card p-4 h-100"><h2 class="h5">Nghỉ toàn tiệm</h2><p class="text-muted small">Không nhận lịch trong khoảng ngày đã chọn.</p><form id="shop-holiday-form"><div class="row g-3"><div class="col-sm-6"><label class="form-label">Từ ngày</label><input class="form-control" name="fromDate" type="date" required></div><div class="col-sm-6"><label class="form-label">Đến ngày</label><input class="form-control" name="toDate" type="date" required></div><div class="col-12"><label class="form-label">Lý do</label><input class="form-control" name="reason" maxlength="250" placeholder="Ví dụ: Nghỉ lễ" required></div></div><button class="sl-btn sl-btn-primary mt-3" type="submit">Thêm ngày nghỉ</button></form><hr><h3 class="h6">Danh sách ngày nghỉ</h3><ul id="shop-holiday-list" class="list-group list-group-flush"></ul></section></div>
        <div class="col-lg-6"><section class="sl-card p-4 h-100"><h2 class="h5">Nghỉ của thợ</h2><p class="text-muted small">Có thể khai báo cả ngày hoặc một khoảng giờ trong ngày.</p><form id="stylist-time-off-form"><div class="row g-3"><div class="col-12"><label class="form-label">Thợ</label><select class="form-select" name="stylistId" required><option value="">-- Chọn thợ --</option>@foreach (var stylist in stylists) { <option value="@stylist.StylistId">@stylist.FullName</option> }</select></div><div class="col-sm-6"><label class="form-label">Ngày nghỉ</label><input class="form-control" name="offDate" type="date" required></div><div class="col-sm-6 d-flex align-items-end"><div class="form-check mb-2"><input id="full-day" class="form-check-input" name="isFullDay" type="checkbox" checked><label class="form-check-label" for="full-day">Nghỉ cả ngày</label></div></div><div class="col-sm-6"><label class="form-label">Từ giờ</label><input class="form-control" name="startTime" type="time" disabled></div><div class="col-sm-6"><label class="form-label">Đến giờ</label><input class="form-control" name="endTime" type="time" disabled></div><div class="col-12"><label class="form-label">Lý do</label><input class="form-control" name="reason" maxlength="250" placeholder="Ví dụ: Việc cá nhân" required></div><div class="col-12"><label class="form-label">Người thay thế</label><select class="form-select" name="replacementStylistId"><option value="">-- Chọn khi cần chuyển lịch hẹn --</option>@foreach (var stylist in stylists) { <option value="@stylist.StylistId">@stylist.FullName</option> }</select><div class="form-text">Nếu có lịch hẹn bị ảnh hưởng, các lịch đó sẽ được chuyển sang người thay thế sau khi hệ thống kiểm tra điều kiện.</div></div></div><button class="sl-btn sl-btn-primary mt-3" type="submit">Thêm lịch nghỉ</button></form><hr><h3 class="h6">Lịch nghỉ của thợ đã chọn</h3><ul id="stylist-time-off-list" class="list-group list-group-flush"><li class="list-group-item text-muted">Chọn thợ để xem lịch nghỉ.</li></ul></section></div>
    </div>
</div>

@section Scripts { <script src="~/js/auth.js" asp-append-version="true"></script><script src="~/js/time-off.js" asp-append-version="true"></script><script>SalonAuth.requireSession({ endpoint: "/api/owner/session", contentId: "time-off-page" }); TimeOffPage.initialize();</script> }
