@{
    ViewData["Title"] = "Cảm ơn bạn đã đánh giá";
}

<div class="container py-5" style="max-width: 680px">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5 text-center">
            <div class="mb-3">
                <i class="bi bi-heart-fill text-danger" style="font-size: 3.5rem;"></i>
            </div>
            <h1 class="h3 fw-bold mb-3">Cảm ơn bạn đã gửi đánh giá!</h1>
            <p class="text-secondary mb-4">
                Ý kiến và góp ý của bạn là động lực rất lớn giúp đội ngũ thợ và Salon ngày một hoàn thiện chất lượng dịch vụ, mang lại trải nghiệm tốt nhất cho quý khách.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a href="/appointments/lookup" class="btn btn-outline-primary">
                    <i class="bi bi-search me-1"></i>Tra cứu lịch hẹn khác
                </a>
                <a href="/" class="btn btn-primary">
                    <i class="bi bi-house me-1"></i>Về trang chủ
                </a>
            </div>
        </div>
    </div>
</div>
