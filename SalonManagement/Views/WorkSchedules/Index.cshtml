@model SalonManagement.Models.ViewModels.WeeklyWorkScheduleViewModel
@{
    ViewData["Title"] = "Lịch làm việc theo tuần";
    var days = Enumerable.Range(0, 7).Select(offset => Model.WeekStart.AddDays(offset)).ToList();
    var dayNames = new[] { "Thứ Hai", "Thứ Ba", "Thứ Tư", "Thứ Năm", "Thứ Sáu", "Thứ Bảy", "Chủ Nhật" };
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div><h1 class="h2 mb-1">Lịch làm việc</h1><p class="text-muted mb-0">Xếp nhiều ca trong ngày cho từng thợ.</p></div>
        <form method="get" class="d-flex align-items-end gap-2">
            <input type="hidden" name="weekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
            <div><label class="form-label mb-1" for="stylistId">Chọn thợ</label><select id="stylistId" name="stylistId" class="form-select" onchange="this.form.submit()"><option value="">-- Chọn thợ --</option>@foreach (var stylist in Model.Stylists) { <option value="@stylist.StylistId" selected="@(stylist.StylistId == Model.StylistId)">@stylist.FullName</option> }</select></div>
        </form>
    </div>

    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <a class="btn btn-outline-secondary" asp-route-stylistId="@Model.StylistId" asp-route-weekStart="@Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd")">← Tuần trước</a>
        <strong>@Model.WeekStart.ToString("dd/MM/yyyy") – @Model.WeekEnd.ToString("dd/MM/yyyy")</strong>
        <a class="btn btn-outline-secondary" asp-route-stylistId="@Model.StylistId" asp-route-weekStart="@Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd")">Tuần sau →</a>
    </div>

    @if (Model.StylistId is null) { <div class="alert alert-info">Hãy tạo hồ sơ thợ đang làm việc để bắt đầu xếp ca.</div> }
    else { <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3">
        @for (var index = 0; index < days.Count; index++)
        {
            var day = days[index]; var shifts = Model.Schedules.Where(s => s.WorkDate.Date == day.Date).ToList();
            <div class="col"><section class="card h-100 shadow-sm"><div class="card-header bg-white"><strong>@dayNames[index]</strong><div class="small text-muted">@day.ToString("dd/MM/yyyy")</div></div><div class="card-body">
                @if (shifts.Count == 0) { <p class="text-muted small">Chưa có ca làm.</p> }
                @foreach (var shift in shifts) { <article class="border rounded p-2 mb-2"><strong>@shift.StartTime.ToString(@"hh\:mm") – @shift.EndTime.ToString(@"hh\:mm")</strong>@if (!string.IsNullOrWhiteSpace(shift.Notes)) { <div class="small text-muted mt-1">Nghỉ giữa ca: @shift.Notes</div> }<button class="btn btn-sm btn-outline-primary w-100 mt-2" type="button" data-bs-toggle="modal" data-bs-target="#editShiftModal" data-id="@shift.WorkScheduleId" data-start="@shift.StartTime.ToString(@"hh\:mm")" data-end="@shift.EndTime.ToString(@"hh\:mm")" data-notes="@shift.Notes">Sửa ca</button></article> }
                <button class="btn btn-sm btn-primary w-100" type="button" data-bs-toggle="modal" data-bs-target="#addShiftModal" data-date="@day.ToString("yyyy-MM-dd")">Thêm ca</button>
            </div></section></div>
        }
    </div> }
</div>

@if (Model.StylistId is not null)
{
<div class="modal fade" id="addShiftModal" tabindex="-1" aria-labelledby="addShiftTitle" aria-hidden="true"><div class="modal-dialog"><form class="modal-content" asp-action="Create" method="post"><div class="modal-header"><h2 class="modal-title fs-5" id="addShiftTitle">Thêm ca làm</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body"><input type="hidden" name="StylistId" value="@Model.StylistId" /><div class="mb-3"><label for="workDate" class="form-label">Ngày làm</label><input id="workDate" name="WorkDate" class="form-control" type="date" required /></div><div class="row"><div class="col"><label for="startTime" class="form-label">Giờ bắt đầu</label><input id="startTime" name="StartTime" class="form-control" type="time" required /></div><div class="col"><label for="endTime" class="form-label">Giờ kết thúc</label><input id="endTime" name="EndTime" class="form-control" type="time" required /></div></div><div class="mt-3"><label for="notes" class="form-label">Ghi chú nghỉ giữa ca</label><textarea id="notes" name="Notes" class="form-control" maxlength="500" rows="3" placeholder="Ví dụ: nghỉ 12:00–13:00"></textarea></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary" type="submit">Lưu ca làm</button></div></form></div></div>
<div class="modal fade" id="editShiftModal" tabindex="-1" aria-labelledby="editShiftTitle" aria-hidden="true"><div class="modal-dialog"><form class="modal-content" method="post"><div class="modal-header"><h2 class="modal-title fs-5" id="editShiftTitle">Sửa ca làm</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body"><input id="editShiftId" name="WorkScheduleId" type="hidden" /><div class="row"><div class="col"><label for="editStartTime" class="form-label">Giờ bắt đầu</label><input id="editStartTime" name="StartTime" class="form-control" type="time" required /></div><div class="col"><label for="editEndTime" class="form-label">Giờ kết thúc</label><input id="editEndTime" name="EndTime" class="form-control" type="time" required /></div></div><div class="mt-3"><label for="editNotes" class="form-label">Ghi chú nghỉ giữa ca</label><textarea id="editNotes" name="Notes" class="form-control" maxlength="500" rows="3"></textarea></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary" type="submit">Lưu thay đổi</button></div></form></div></div>
}

@section Scripts { <script>document.getElementById('addShiftModal')?.addEventListener('show.bs.modal', event => document.getElementById('workDate').value = event.relatedTarget.getAttribute('data-date')); document.getElementById('editShiftModal')?.addEventListener('show.bs.modal', event => { const button = event.relatedTarget; const form = event.currentTarget.querySelector('form'); form.action = '@Url.Action("Edit", "WorkSchedules")/' + button.dataset.id; document.getElementById('editShiftId').value = button.dataset.id; document.getElementById('editStartTime').value = button.dataset.start; document.getElementById('editEndTime').value = button.dataset.end; document.getElementById('editNotes').value = button.dataset.notes || ''; });</script> }
