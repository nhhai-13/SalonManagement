@using System.Text.Json
@model SalonManagement.Models.ViewModels.WeeklyWorkScheduleViewModel
@{
    ViewData["Title"] = "Lịch làm việc theo tuần";
    var days = Enumerable.Range(0, 7).Select(offset => Model.WeekStart.AddDays(offset)).ToList();
    var dayNames = new[] { "Thứ Hai", "Thứ Ba", "Thứ Tư", "Thứ Năm", "Thứ Sáu", "Thứ Bảy", "Chủ Nhật" };
    var blockedAppointments = TempData["BlockedAppointments"] is string blockedJson
        ? JsonSerializer.Deserialize<List<SalonManagement.Models.ViewModels.BlockedAppointmentViewModel>>(blockedJson) ?? []
        : [];
}

<div class="container py-4">
    <div class="sl-page-header d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h1 class="sl-page-title h2 mb-1">Lịch làm việc</h1>
            <p class="text-muted mb-0">Xếp nhiều ca trong ngày cho từng thợ.</p>
        </div>
        <form method="get" class="d-flex align-items-end gap-2">
            <input type="hidden" name="weekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
            <div>
                <label class="form-label mb-1" for="stylistId">Chọn thợ</label>
                <select id="stylistId" name="stylistId" class="form-select sl-input" onchange="this.form.submit()">
                    <option value="">-- Chọn thợ --</option>
                    @foreach (var stylist in Model.Stylists) { <option value="@stylist.StylistId" selected="@(stylist.StylistId == Model.StylistId)">@stylist.FullName</option> }
                </select>
            </div>
        </form>
    </div>

    @if (TempData["Success"] is string success) { <div class="sl-alert sl-alert-success alert alert-success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="sl-alert sl-alert-danger alert alert-danger" role="alert">@error</div> }
    @if (blockedAppointments.Count > 0) { 
        <section class="sl-alert sl-alert-warning alert alert-warning">
            <strong>Lịch hẹn liên quan</strong>
            <ul class="mb-0 mt-2">
                @foreach (var appointment in blockedAppointments) { 
                    <li><strong>@appointment.StartTime.ToString(@"hh\:mm")–@appointment.EndTime.ToString(@"hh\:mm")</strong> · @appointment.CustomerName · @string.Join(", ", appointment.ServiceNames)</li> 
                }
            </ul>
        </section> 
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <a class="sl-btn sl-btn-outline btn btn-outline-secondary" asp-route-stylistId="@Model.StylistId" asp-route-weekStart="@Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd")">← Tuần trước</a>
        <strong>@Model.WeekStart.ToString("dd/MM/yyyy") – @Model.WeekEnd.ToString("dd/MM/yyyy")</strong>
        <div class="d-flex gap-2">
            @if (Model.StylistId is not null) { 
                <button class="sl-btn sl-btn-outline sl-btn-primary btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#copyWeekModal">Sao chép sang tuần sau</button> 
            }
            <a class="sl-btn sl-btn-outline btn btn-outline-secondary" asp-route-stylistId="@Model.StylistId" asp-route-weekStart="@Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd")">Tuần sau →</a>
        </div>
    </div>

    @if (Model.StylistId is null) { 
        <div class="sl-alert sl-alert-info alert alert-info">Hãy tạo hồ sơ thợ đang làm việc để bắt đầu xếp ca.</div> 
    }
    else { 
        <div class="sl-week-scroll" tabindex="0" aria-label="Lịch làm việc bảy ngày trong tuần">
        <div class="sl-week-grid">
        @for (var index = 0; index < days.Count; index++)
        {
            var day = days[index]; var shifts = Model.Schedules.Where(s => s.WorkDate.Date == day.Date).ToList(); var hours = Model.BusinessHours[day.DayOfWeek];
            <div class="sl-week-day">
                <section class="sl-day-card card h-100 shadow-sm">
                    <div class="sl-day-header card-header bg-white">
                        <strong>@dayNames[index]</strong>
                        <div class="small text-muted">@day.ToString("dd/MM/yyyy")</div>
                        <div class="small @(hours.IsClosed ? "text-danger" : "text-success")">@(hours.IsClosed ? "Tiệm đóng cửa" : $"Giờ hoạt động: {hours.OpensAt:HH\\:mm}–{hours.ClosesAt:HH\\:mm}")</div>
                    </div>
                    <div class="sl-day-body card-body">
                        @if (shifts.Count == 0) { <p class="text-muted small">Chưa có ca làm.</p> }
                        @foreach (var shift in shifts) { 
                            <article class="sl-shift border rounded p-2 mb-2">
                                <strong class="sl-shift-time">@shift.StartTime.ToString(@"hh\:mm") – @shift.EndTime.ToString(@"hh\:mm")</strong>
                                @if (!string.IsNullOrWhiteSpace(shift.Notes)) { <div class="small text-muted mt-1">Nghỉ giữa ca: @shift.Notes</div> }
                                <div class="d-flex gap-2 mt-2">
                                    <button class="sl-btn sl-btn-outline sl-btn-sm btn btn-sm btn-outline-primary flex-grow-1" type="button" data-bs-toggle="modal" data-bs-target="#editShiftModal" data-id="@shift.WorkScheduleId" data-start="@shift.StartTime.ToString(@"hh\:mm")" data-end="@shift.EndTime.ToString(@"hh\:mm")" data-notes="@shift.Notes">Sửa ca</button>
                                    <button class="sl-btn sl-btn-danger sl-btn-sm btn btn-sm btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#deleteShiftModal" data-id="@shift.WorkScheduleId">Xóa ca</button>
                                </div>
                            </article> 
                        }
                        @if (!hours.IsClosed) { 
                            <button class="sl-btn sl-btn-primary sl-btn-sm btn btn-sm btn-primary w-100" type="button" data-bs-toggle="modal" data-bs-target="#addShiftModal" data-date="@day.ToString("yyyy-MM-dd")">Thêm ca</button> 
                        } else { 
                            <span class="small text-muted">Không thể xếp ca vào ngày tiệm đóng cửa.</span> 
                        }
                    </div>
                </section>
            </div>
        }
        </div>
        </div>
    }
</div>

@if (Model.StylistId is not null)
{
<div class="sl-modal modal fade" id="addShiftModal" tabindex="-1" aria-labelledby="addShiftTitle" aria-hidden="true"><div class="modal-dialog"><form class="modal-content" asp-action="Create" method="post"><div class="modal-header"><h2 class="modal-title fs-5" id="addShiftTitle">Thêm ca làm</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body"><input type="hidden" name="StylistId" value="@Model.StylistId" /><div class="mb-3"><label for="workDate" class="form-label">Ngày làm</label><input id="workDate" name="WorkDate" class="form-control" type="date" required /></div><div class="row"><div class="col"><label for="startTime" class="form-label">Giờ bắt đầu</label><input id="startTime" name="StartTime" class="form-control" type="time" required /></div><div class="col"><label for="endTime" class="form-label">Giờ kết thúc</label><input id="endTime" name="EndTime" class="form-control" type="time" required /></div></div><div class="mt-3"><label for="notes" class="form-label">Ghi chú nghỉ giữa ca</label><textarea id="notes" name="Notes" class="form-control" maxlength="500" rows="3" placeholder="Ví dụ: nghỉ 12:00–13:00"></textarea></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary" type="submit">Lưu ca làm</button></div></form></div></div>
<div class="sl-modal modal fade" id="editShiftModal" tabindex="-1" aria-labelledby="editShiftTitle" aria-hidden="true"><div class="modal-dialog"><form class="modal-content" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="modal-title fs-5" id="editShiftTitle">Sửa ca làm</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body"><input id="editShiftId" name="WorkScheduleId" type="hidden" /><div class="row"><div class="col"><label for="editStartTime" class="form-label">Giờ bắt đầu</label><input id="editStartTime" name="StartTime" class="form-control" type="time" required /></div><div class="col"><label for="editEndTime" class="form-label">Giờ kết thúc</label><input id="editEndTime" name="EndTime" class="form-control" type="time" required /></div></div><div class="mt-3"><label for="editNotes" class="form-label">Ghi chú nghỉ giữa ca</label><textarea id="editNotes" name="Notes" class="form-control" maxlength="500" rows="3"></textarea></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary" type="submit">Lưu thay đổi</button></div></form></div></div>
<div class="sl-modal modal fade" id="deleteShiftModal" tabindex="-1" aria-labelledby="deleteShiftTitle" aria-hidden="true"><div class="modal-dialog"><form class="modal-content" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="modal-title fs-5" id="deleteShiftTitle">Xác nhận xóa ca</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body"><p id="deletePreviewMessage">Đang kiểm tra lịch hẹn liên quan…</p><ul id="deletePreviewList" class="small mb-0"></ul></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button><button id="confirmDeleteShift" class="btn btn-danger" type="submit">Xóa ca</button></div></form></div></div>
<div class="sl-modal modal fade" id="copyWeekModal" tabindex="-1" aria-labelledby="copyWeekTitle" aria-hidden="true"><div class="modal-dialog"><form class="modal-content" asp-action="CopyWeek" method="post"><div class="modal-header"><h2 class="modal-title fs-5" id="copyWeekTitle">Sao chép lịch sang tuần sau</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body"><input type="hidden" name="StylistId" value="@Model.StylistId" /><input type="hidden" name="SourceWeekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" /><p id="copyPreviewMessage" class="mb-3">Đang kiểm tra ca của tuần kế tiếp…</p><p class="small text-muted">Nếu ngày đích đã có ca, hãy chọn cách xử lý:</p><div class="form-check"><input class="form-check-input" type="radio" name="ConflictResolution" value="Skip" id="skipConflicts" checked /><label class="form-check-label" for="skipConflicts">Bỏ qua ngày đã có ca, giữ nguyên lịch hiện tại.</label></div><div class="form-check mt-2"><input class="form-check-input" type="radio" name="ConflictResolution" value="Overwrite" id="overwriteConflicts" /><label class="form-check-label" for="overwriteConflicts">Ghi đè: xóa các ca cũ của ngày đích rồi sao chép lại.</label></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary" type="submit">Sao chép tuần</button></div></form></div></div>
}

@section Scripts { <script>document.getElementById('addShiftModal')?.addEventListener('show.bs.modal', event => document.getElementById('workDate').value = event.relatedTarget.getAttribute('data-date')); document.getElementById('editShiftModal')?.addEventListener('show.bs.modal', event => { const button = event.relatedTarget; const form = event.currentTarget.querySelector('form'); form.action = '@Url.Action("Edit", "WorkSchedules")/' + button.dataset.id; document.getElementById('editShiftId').value = button.dataset.id; document.getElementById('editStartTime').value = button.dataset.start; document.getElementById('editEndTime').value = button.dataset.end; document.getElementById('editNotes').value = button.dataset.notes || ''; }); document.getElementById('copyWeekModal')?.addEventListener('show.bs.modal', async () => { const message = document.getElementById('copyPreviewMessage'); message.textContent = 'Đang kiểm tra ca của tuần kế tiếp…'; const url = '@Url.Action("CopyPreview", "WorkSchedules")?stylistId=@Model.StylistId&weekStart=@Model.WeekStart.ToString("yyyy-MM-dd")'; const preview = await fetch(url).then(response => response.json()); message.textContent = preview.conflictDays.length === 0 ? 'Tuần kế tiếp chưa có ca trùng ngày; các ca sẽ được sao chép.' : `Tuần kế tiếp có ${preview.conflictDays.length} ngày đã có ca (${preview.conflictDays.map(day => new Date(day.date).toLocaleDateString('vi-VN')).join(', ')}).`; }); document.getElementById('deleteShiftModal')?.addEventListener('show.bs.modal', async event => { const button = event.relatedTarget; const modal = event.currentTarget; const form = modal.querySelector('form'); const message = document.getElementById('deletePreviewMessage'); const list = document.getElementById('deletePreviewList'); const confirm = document.getElementById('confirmDeleteShift'); form.action = '@Url.Action("Delete", "WorkSchedules")/' + button.dataset.id + '/delete'; message.textContent = 'Đang kiểm tra lịch hẹn liên quan…'; list.replaceChildren(); confirm.disabled = true; const preview = await fetch('@Url.Action("DeletePreview", "WorkSchedules")/' + button.dataset.id + '/delete-preview').then(response => response.json()); if (preview.relatedAppointments.length === 0) { message.textContent = 'Ca này chưa có lịch hẹn liên quan. Bạn có chắc muốn xóa?'; confirm.disabled = false; } else { message.textContent = `Không thể xóa: có ${preview.relatedAppointments.length} lịch hẹn liên quan.`; preview.relatedAppointments.forEach(appointment => { const item = document.createElement('li'); item.textContent = `${appointment.startTime.substring(0, 5)}–${appointment.endTime.substring(0, 5)} · ${appointment.customerName} · ${appointment.serviceNames.join(', ')}`; list.appendChild(item); }); } });</script> }
