@{ ViewData["Title"] = "Phân tích khung giờ cao điểm"; }
<style>
    .peak-report-header h1 { margin:.15rem 0; font-size:1.75rem; }.peak-report-header p { color:#64748b; margin:0 0 1rem; }.peak-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; margin:1rem 0; }.peak-kpis article { padding:1rem; border:1px solid #dbe5f0; border-left:5px solid #2563eb; border-radius:.7rem; background:#fff; }.peak-kpis article.noshow { border-left-color:#ef4444; }.peak-kpis article.cancel { border-left-color:#f59e0b; }.peak-kpis span,.peak-kpis small { display:block; color:#64748b; font-size:.8rem; }.peak-kpis span { font-weight:800; text-transform:uppercase; }.peak-kpis strong { display:block; margin:.25rem 0; color:#2563eb; font-size:1.45rem; }.peak-kpis .noshow strong { color:#dc2626; }.peak-kpis .cancel strong { color:#d97706; }.peak-chart-panel { overflow:hidden; border:1px solid #dbe5f0; border-radius:.75rem; background:#fff; }.peak-chart-panel header { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.8rem 1rem; color:#fff; background:#1e293b; }.peak-chart-panel header > div { font-size:.78rem; }.peak-legend { display:inline-block; width:13px; height:13px; margin-left:1rem; border-radius:3px; vertical-align:-2px; }.peak-legend.weekday,.peak-bar.weekday { background:#3b82f6; }.peak-legend.weekend,.peak-bar.weekend { background:#ec4899; }.peak-y-label { display:flex; justify-content:space-between; padding:.7rem 1rem 0 1.3rem; color:#94a3b8; font-size:.75rem; }.peak-chart { display:grid; grid-template-columns:repeat(7,minmax(70px,1fr)); gap:.8rem; min-height:300px; margin:0 1rem; padding:1rem 1rem 0; border-bottom:2px solid #cbd5e1; background:repeating-linear-gradient(to bottom,transparent 0,transparent 74px,#e8eef7 75px); }.peak-slot { display:flex; min-width:0; flex-direction:column; justify-content:flex-end; align-items:center; gap:.45rem; }.peak-bars { display:flex; align-items:flex-end; justify-content:center; gap:6px; width:100%; height:245px; }.peak-bar { position:relative; width:min(34%,28px); min-height:2px; border-radius:5px 5px 0 0; }.peak-bar b { position:absolute; top:-1.3rem; left:50%; color:#334155; font-size:.7rem; transform:translateX(-50%); }.peak-slot > span { color:#475569; font-size:.78rem; font-weight:700; }.peak-chart-panel footer { margin:.8rem 1rem; padding:.75rem; border:1px solid #f59e0b; border-radius:.5rem; background:#fff6d6; color:#9a4f05; font-size:.85rem; } @@media (max-width:900px) { .peak-kpis { grid-template-columns:1fr; }.peak-chart { overflow-x:auto; } }
</style>
<main id="peak-report-content" class="container-fluid d-none py-3 peak-report" aria-live="polite">
    <header class="peak-report-header"><div><span class="stylist-command-eyebrow">Quản lý tiệm</span><h1>Phân tích khung giờ cao điểm &amp; Tỉ lệ khách không đến</h1><p>So sánh mật độ lịch hẹn theo giờ để chủ động điều phối nhân sự cuối tuần.</p></div></header>
    <section class="revenue-filter" aria-label="Bộ lọc thời gian"><label>Từ ngày <input id="peak-from" class="form-control" type="date" /></label><label>Đến ngày <input id="peak-to" class="form-control" type="date" /></label><button id="peak-apply" type="button" class="btn btn-primary">Xem báo cáo</button><div class="btn-group"><button type="button" class="btn btn-outline-secondary btn-sm" data-peak-preset="current">Tháng này</button><button type="button" class="btn btn-outline-secondary btn-sm" data-peak-preset="previous">Tháng trước</button><button type="button" class="btn btn-outline-secondary btn-sm" data-peak-preset="30days">30 ngày qua</button></div></section>
    <div id="peak-error" class="alert alert-danger d-none mt-3" role="alert"></div>
    <section class="peak-kpis"><article><span>Tổng số lịch hẹn trong khoảng</span><strong id="peak-total">—</strong><small>Toàn bộ lịch hẹn phát sinh trong kỳ</small></article><article class="noshow"><span>Tỉ lệ khách không đến (No-show)</span><strong id="peak-noshow">—</strong><small>Định dạng một chữ số thập phân</small></article><article class="cancel"><span>Tỉ lệ khách hủy lịch</span><strong id="peak-cancel">—</strong><small>Định dạng một chữ số thập phân</small></article></section>
    <section class="peak-chart-panel"><header><strong><i class="bi bi-bar-chart-line"></i> Phân bố lượt hẹn theo khung giờ</strong><div><span class="peak-legend weekday"></span> Ngày thường (T2–T6) <span class="peak-legend weekend"></span> Cuối tuần (T7, CN)</div></header><div class="peak-y-label"><span id="peak-axis-max">0</span><span>0</span></div><div id="peak-chart" class="peak-chart" aria-label="Biểu đồ cột so sánh lượt hẹn"></div><footer id="peak-recommendation"><i class="bi bi-lightbulb"></i> Đang phân tích dữ liệu…</footer></section>
</main>
@section Scripts { <script src="~/js/auth.js" asp-append-version="true"></script><script src="~/js/peak-hours-report.js" asp-append-version="true"></script><script>SalonAuth.requireSession({ endpoint: "/api/owner/session", contentId: "peak-report-content" }).then(() => PeakHoursReport.start());</script> }
