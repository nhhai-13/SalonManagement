@{
    ViewData["Title"] = "Cổng làm việc thợ";
}

<main id="stylist-command-content" class="container-fluid d-none py-3 stylist-command" aria-live="polite">
    <header class="stylist-command-header">
        <div><span class="stylist-command-eyebrow">Không gian thợ · <span data-stylist-date>Đang tải…</span></span><h1>Cổng làm việc Thợ làm tóc</h1><p>Xin chào <strong id="stylist-name" data-stylist-name>…</strong> · Theo dõi ca, phục vụ khách và ghi chú kỹ thuật.</p></div>
        <div class="stylist-command-tools"><button id="stylist-notification-toggle" class="stylist-bell" type="button" aria-label="Thông báo"><i class="bi bi-bell"></i><span id="stylist-notification-count" class="d-none">0</span></button><a class="btn btn-outline-primary btn-sm" href="/stylist/week-schedule"><i class="bi bi-calendar-week"></i> Ca làm tuần</a></div>
    </header>
    <section class="stylist-kpis" aria-label="Chỉ số ca làm">
        <article class="stylist-kpi shift"><span>Ca làm hôm nay</span><strong id="stylist-shift-time">—</strong><small id="stylist-break-note">Chưa có ca được phân công</small></article>
        <article class="stylist-kpi service"><span>Đang phục vụ</span><strong id="stylist-kpi-service">0</strong><small>khách trên ghế</small></article>
        <article class="stylist-kpi waiting"><span>Lịch sắp tới</span><strong id="stylist-kpi-waiting">0</strong><small>khách chờ lượt</small></article>
        <article class="stylist-kpi completed"><span>Hoàn thành ca</span><strong id="stylist-kpi-completed">0</strong><small>lượt phục vụ</small></article>
    </section>
    <div id="stylist-command-error" class="alert alert-danger d-none" role="alert"></div>
    <section class="stylist-command-grid">
        <article class="stylist-current-panel"><header><div><span><i class="bi bi-person-workspace"></i> Khách đang trên ghế của bạn</span><h2>Phục vụ hiện tại</h2></div><strong id="stylist-current-timer">00:00:00</strong></header><div id="stylist-current-appointment" class="stylist-current-body"><div class="stylist-empty"><i class="bi bi-cup-hot"></i> Hiện chưa có khách đang phục vụ.</div></div></article>
        <article class="stylist-upcoming-panel"><header><span><i class="bi bi-list-check"></i> Danh sách lượt hẹn sắp tới của tôi</span><a href="/stylist/schedule">Xem toàn bộ</a></header><div id="stylist-upcoming-list" class="stylist-upcoming-list"><div class="stylist-empty">Đang tải lịch hẹn…</div></div></article>
    </section>
</main>

<div id="stylist-technical-drawer" class="stylist-technical-drawer" aria-hidden="true">
    <button type="button" class="stylist-drawer-backdrop" data-stylist-drawer-close aria-label="Đóng"></button>
    <aside class="stylist-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="stylist-technical-title">
        <header>
            <div>
                <span class="stylist-command-eyebrow">S4-03 · Nội bộ</span>
                <h2 id="stylist-technical-title">Lịch sử dịch vụ &amp; ghi chú kỹ thuật</h2>
            </div>
            <button type="button" class="btn-close" data-stylist-drawer-close aria-label="Đóng"></button>
        </header>
        <div class="stylist-drawer-body">
            <div class="stylist-technical-customer">
                <span>Khách đang phục vụ</span>
                <strong id="stylist-technical-customer-name">Đang tải…</strong>
                <small id="stylist-technical-phone"></small>
                <span id="stylist-technical-new-customer" class="stylist-new-customer-badge d-none"><i class="bi bi-stars"></i> Khách mới</span>
            </div>
            <p class="stylist-internal-badge"><i class="bi bi-lock-fill"></i> Ghi chú nội bộ · Chỉ Thợ, Lễ tân và Chủ tiệm xem được.</p>
            <label class="form-label" for="stylist-technical-notes">Ghi chú kỹ thuật lượt hôm nay <span>(tối đa 500 ký tự)</span></label>
            <textarea id="stylist-technical-notes" class="form-control" maxlength="500" rows="5" placeholder="Nhập công thức màu, nồng độ oxy, thời gian ủ hoặc lưu ý da đầu…"></textarea>
            <div class="stylist-technical-note-actions">
                <small id="stylist-technical-count" class="text-muted">0 / 500 ký tự</small>
                <button id="stylist-technical-save" class="btn btn-primary btn-sm" type="button"><i class="bi bi-save"></i> Lưu ghi chú</button>
            </div>
            <hr />
            <h3>10 lượt dịch vụ gần nhất của khách</h3>
            <div id="stylist-technical-history" class="stylist-technical-history"><div class="text-muted small">Đang tải…</div></div>
        </div>
    </div>

    <section class="card sl-card border-0 shadow-sm mt-4" aria-labelledby="my-appointments-heading">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                <h2 id="my-appointments-heading" class="h4 mb-0">Lịch hẹn của tôi</h2>
                <label for="stylist-date" class="visually-hidden">Ngày xem lịch</label>
                <input id="stylist-date" type="date" class="form-control w-auto" />
                <button id="stylist-refresh" class="btn btn-outline-primary" type="button">Tải lịch</button>
            </div>
            <div id="stylist-alert" class="alert d-none" role="status"></div>
            <div id="stylist-appointments" class="d-grid gap-3"></div>
        </div>
    </section>
</div>
<dialog id="stylist-notification-dialog" class="stylist-notification-dialog"><section><header><h2>Thông báo lịch hẹn</h2><button class="btn-close" type="button" data-stylist-notification-close aria-label="Đóng"></button></header><div id="stylist-notification-list"></div></section></dialog>
<dialog id="stylist-appointment-detail-dialog" class="stylist-appointment-detail-dialog"><section><header><div><span class="stylist-command-eyebrow">Chi tiết lịch hẹn</span><h2 id="stylist-appointment-detail-title">Lịch hẹn của khách</h2></div><button class="btn-close" type="button" data-stylist-detail-close aria-label="Đóng"></button></header><div class="stylist-detail-body"><p id="stylist-appointment-detail-source" class="stylist-detail-source d-none"></p><dl><dt>Mã lịch hẹn</dt><dd id="stylist-appointment-detail-reference">—</dd><dt>Khách hàng</dt><dd id="stylist-appointment-detail-customer">—</dd><dt>Dịch vụ</dt><dd id="stylist-appointment-detail-services">—</dd><dt>Giờ hẹn</dt><dd id="stylist-appointment-detail-time">—</dd><dt>Trạng thái</dt><dd id="stylist-appointment-detail-status">—</dd></dl><div id="stylist-appointment-detail-note" class="stylist-customer-note d-none"></div><div class="stylist-detail-actions"><button id="stylist-appointment-detail-start" class="btn btn-primary d-none" type="button"><i class="bi bi-play-fill"></i> Bắt đầu phục vụ ngay</button><button id="stylist-appointment-detail-technical" class="btn btn-outline-primary" type="button"><i class="bi bi-journal-text"></i> Lịch sử &amp; ghi chú KT</button></div></div></section></dialog>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script>
    SalonAuth.requireSession({ endpoint: "/api/portal/stylist/session", contentId: "stylist-content" }).then(loadStylistAppointments);
    const dateInput = document.getElementById('stylist-date');
    dateInput.value = new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    document.getElementById('stylist-refresh').addEventListener('click', loadStylistAppointments);
    dateInput.addEventListener('change', loadStylistAppointments);
    async function loadStylistAppointments() {
        const response = await SalonAuth.authenticatedFetch(`/api/stylist/work/appointments?date=${encodeURIComponent(dateInput.value)}`);
        const output = document.getElementById('stylist-appointments');
        const alert = document.getElementById('stylist-alert');
        output.replaceChildren();
        if (!response.ok) { alert.textContent = 'Không tải được lịch hẹn. Vui lòng thử lại.'; alert.className = 'alert alert-danger'; return; }
        const appointments = await response.json();
        alert.textContent = appointments.length ? '' : 'Ngày này chưa có lịch hẹn.';
        alert.className = appointments.length ? 'alert d-none' : 'alert alert-info';
        for (const item of appointments) {
            const card = document.createElement('article'); card.className = 'border rounded p-3';
            const title = document.createElement('h3'); title.className = 'h6'; title.textContent = `${item.startTime.slice(0,5)}–${item.endTime.slice(0,5)} · ${item.customerPhone}`;
            const services = document.createElement('p'); services.className = 'mb-1'; services.textContent = `${item.services.join(', ')} · ${item.expectedDurationMinutes} phút`;
            const note = document.createElement('p'); note.className = 'text-muted mb-2'; note.textContent = item.customerNote || 'Khách không để lại ghi chú.';
            const state = document.createElement('p'); state.className = 'mb-2'; state.textContent = `Trạng thái: ${item.status}`;
            card.append(title, services, note, state);
            if (item.status === 'Arrived') card.append(actionButton('Bắt đầu', `/api/stylist/work/appointments/${item.appointmentId}/start`));
            if (item.status === 'InProgress') card.append(actionButton('Hoàn tất', `/api/stylist/work/appointments/${item.appointmentId}/complete`));
            if (item.actualDurationMinutes != null) {
                const duration = document.createElement('p'); duration.className = item.actualDurationMinutes > item.expectedDurationMinutes + 20 ? 'text-danger fw-bold' : 'text-success';
                duration.textContent = `Thời gian thực tế: ${item.actualDurationMinutes} phút (dự kiến ${item.expectedDurationMinutes} phút)`;
                card.append(duration);
            }
            output.append(card);
        }
    }
    function actionButton(label, url) {
        const button = document.createElement('button'); button.type = 'button'; button.className = 'btn btn-primary'; button.textContent = label;
        button.addEventListener('click', async () => {
            button.disabled = true;
            const response = await SalonAuth.authenticatedFetch(url, { method: 'POST' });
            if (!response.ok) { button.disabled = false; document.getElementById('stylist-alert').textContent = (await response.json().catch(() => ({}))).message || 'Không thể cập nhật lịch.'; document.getElementById('stylist-alert').className = 'alert alert-danger'; return; }
            const result = await response.json();
            if (result.alertReception) { document.getElementById('stylist-alert').textContent = 'Cảnh báo: thời gian phục vụ vượt quá dự kiến hơn 20 phút; lễ tân cần kiểm tra các lịch tiếp theo.'; document.getElementById('stylist-alert').className = 'alert alert-warning'; }
            await loadStylistAppointments();
        });
        return button;
    }
    </script>
}
