@{
    ViewData["Title"] = "Không gian thợ";
}

<div id="stylist-content" class="container d-none py-4">
    <div class="sl-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-5 border-bottom pb-4">
        <div>
            <span class="sl-eyebrow text-uppercase text-muted small fw-semibold">Không gian làm việc</span>
            <h1 class="sl-page-title h2 mb-1 mt-1 text-primary-dark">Thợ làm tóc</h1>
            <p class="text-muted mb-0">Xin chào <strong data-session-email class="text-dark"></strong></p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm sl-card border-0 hover-lift">
                <div class="card-body p-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-calendar3 fs-1 text-primary"></i>
                    </div>
                    <h2 class="h5 mt-3 text-dark fw-bold">Lịch làm việc</h2>
                    <p class="text-muted mb-0">Xem ca làm và lịch phục vụ được phân công.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm sl-card border-0 hover-lift">
                <div class="card-body p-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-scissors fs-1 text-primary"></i>
                    </div>
                    <h2 class="h5 mt-3 text-dark fw-bold">Lịch hẹn của tôi</h2>
                    <p class="text-muted mb-0">Theo dõi các khách hàng cần phục vụ trong ngày.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm sl-card border-0 hover-lift">
                <div class="card-body p-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-clock-history fs-1 text-primary"></i>
                    </div>
                    <h2 class="h5 mt-3 text-dark fw-bold">Lịch sử phục vụ</h2>
                    <p class="text-muted mb-0">Xem lại các dịch vụ đã hoàn thành.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script>SalonAuth.requireSession({ endpoint: "/api/portal/stylist/session", contentId: "stylist-content" });</script>
}
