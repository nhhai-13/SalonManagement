@{
    ViewData["Title"] = "Lễ tân - Lịch hẹn & Vận hành";
}

<div id="reception-content" class="d-none py-3">
    <!-- Top Bar -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 border-bottom pb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary px-2 py-1"><i class="bi bi-person-badge me-1"></i>Lễ tân</span>
                <span class="text-muted small">Xin chào <strong data-session-email></strong></span>
            </div>
            <h1 class="h3 mb-0 mt-1 fw-bold text-dark">Quản lý Lịch hẹn &amp; Vận hành</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/booking" target="_blank" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-box-arrow-up-right me-1"></i>Trang đặt lịch khách
            </a>
            <button id="logout" class="btn btn-outline-danger btn-sm" type="button">
                <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
            </button>
        </div>
        <div class="reception-operations-tools">
            <form method="get" action="/reception/customer-search" class="reception-quick-search">
                <label class="visually-hidden" for="reception-customer-search">Tìm hồ sơ khách</label>
                <i class="bi bi-search" aria-hidden="true"></i><input id="reception-customer-search" name="q" placeholder="Tìm nhanh SĐT / khách…" />
            </form>
            <button id="reception-counter-booking" class="btn btn-primary btn-sm" type="button"><i class="bi bi-plus-lg"></i> Đặt lịch quầy</button>
        </div>
    </header>

    <!-- Calendar Navigation & Controls Bar -->
    <div class="card shadow-sm border-0 mb-3 bg-white">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2">
                    <button id="btn-prev-day" class="btn btn-outline-secondary btn-sm" title="Ngày hôm trước">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <input id="calendar-date-input" type="date" class="form-control form-control-sm" style="width: 160px;" />
                    <button id="btn-next-day" class="btn btn-outline-secondary btn-sm" title="Ngày tiếp theo">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    <button id="btn-today" class="btn btn-light btn-sm border fw-semibold">
                        Hôm nay
                    </button>
                    <button id="btn-refresh-calendar" class="btn btn-light btn-sm border" title="Tải lại">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="fs-5 fw-bold text-primary" id="calendar-current-date-display">
                        --/--/----
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading Indicator -->
    <div id="calendar-loading" class="text-center py-4 d-none">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Đang tải lịch hẹn...</span>
        </div>
        <p class="text-muted small mt-2">Đang tải lịch làm việc và lịch hẹn...</p>
    </div>

    <!-- Calendar Schedule Grid -->
    <div id="calendar-grid-container" class="position-relative">
        <!-- Rendered by reception-calendar.js -->
    </div>
</div>

<!-- Modal: Sửa lịch / Đổi thợ / Dời giờ (S3-04) -->
<div class="modal fade" id="rescheduleModal" tabindex="-1" aria-labelledby="reschedule-modal-title" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light border-bottom">
                <div>
                    <h5 class="modal-title fw-bold text-dark" id="reschedule-modal-title">
                        <i class="bi bi-calendar-event text-primary me-2"></i>Điều chỉnh lịch hẹn
                    </h5>
                    <small class="text-muted">Đổi thợ phụ trách hoặc dời giờ bắt đầu cho khách hàng</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="reschedule-form" novalidate>
                <input type="hidden" id="reschedule-appointment-id" />

                <div class="modal-body p-4">
                    <!-- Validation Alert Box (Hiển thị lỗi F33, Trùng lịch, Ngoài ca) -->
                    <div id="reschedule-validation-alert" class="alert alert-danger d-none border-0 shadow-sm mb-3" role="alert">
                        <div id="reschedule-validation-message" class="small"></div>
                    </div>

                    <!-- Thông tin hiện tại của lịch hẹn -->
                    <div class="bg-light p-3 rounded-3 mb-3 border">
                        <div class="row g-2">
                            <div class="col-12 col-md-6">
                                <span class="text-muted small d-block">Khách hàng:</span>
                                <strong id="reschedule-customer-name" class="text-dark">--</strong>
                                <span class="text-muted small ms-1">(<span id="reschedule-customer-phone">--</span>)</span>
                            </div>
                            <div class="col-12 col-md-6">
                                <span class="text-muted small d-block">Thợ hiện tại:</span>
                                <strong id="reschedule-current-stylist" class="text-dark">--</strong>
                            </div>
                            <div class="col-12 col-md-6">
                                <span class="text-muted small d-block">Giờ hiện tại:</span>
                                <span id="reschedule-current-time" class="badge bg-secondary-subtle text-secondary border">--</span>
                            </div>
                            <div class="col-12 col-md-6">
                                <span class="text-muted small d-block">Dịch vụ đã đặt:</span>
                                <div id="reschedule-services-list" class="mt-1"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Form điều chỉnh -->
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-pencil-square text-primary me-1"></i>Thông tin điều chỉnh mới
                    </h6>

                    <div class="row g-3">
                        <!-- Chọn ngày hẹn mới -->
                        <div class="col-12 col-md-6">
                            <label for="reschedule-date" class="form-label small fw-semibold">Ngày hẹn mới <span class="text-danger">*</span></label>
                            <input type="date" id="reschedule-date" class="form-control" required />
                        </div>

                        <!-- Chọn thợ mới -->
                        <div class="col-12 col-md-6">
                            <label for="reschedule-stylist-select" class="form-label small fw-semibold">Thợ phụ trách mới <span class="text-danger">*</span></label>
                            <select id="reschedule-stylist-select" class="form-select" required>
                                <!-- Rendered dynamically with skill badges -->
                            </select>
                            <div id="reschedule-stylist-note"></div>
                        </div>

                        <!-- Giờ bắt đầu mới -->
                        <div class="col-12 col-md-6">
                            <label for="reschedule-start-time" class="form-label small fw-semibold">Giờ bắt đầu mới <span class="text-danger">*</span></label>
                            <input type="time" id="reschedule-start-time" class="form-control" step="900" required />
                            <small class="text-muted" style="font-size: 0.75rem;">Bước nhảy chuẩn 15 phút (vd: 09:00, 09:15, 09:30...)</small>
                        </div>

                        <!-- Giờ kết thúc mới (Tự động tính) -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Giờ kết thúc dự kiến</label>
                            <input type="text" id="reschedule-end-time-display" class="form-control bg-light" readonly />
                            <small class="text-muted" style="font-size: 0.75rem;">Tự động tính = Giờ bắt đầu + Tổng thời lượng</small>
                        </div>

                        <!-- Lý do dời lịch -->
                        <div class="col-12">
                            <label for="reschedule-reason" class="form-label small fw-semibold">Lý do điều chỉnh (Tùy chọn)</label>
                            <input type="text" id="reschedule-reason" class="form-control" placeholder="Ví dụ: Khách báo đến trễ 15 phút, thợ bận ca phát sinh..." />
                        </div>
                    </div>

                    <!-- Lịch sử thay đổi / Audit Log (AC4) -->
                    <div class="mt-4 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold small text-secondary">
                                <i class="bi bi-clock-history me-1 text-info"></i>Lịch sử dời lịch / Đổi thợ
                            </span>
                            <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.75rem;" id="btn-toggle-history">
                                <i class="bi bi-chevron-down me-1"></i>Xem lịch sử (<span id="history-count">0</span>)
                            </button>
                        </div>
                        <div id="reschedule-history-container" class="bg-light p-2 rounded border small" style="max-height: 180px; overflow-y: auto; display: none;">
                            <div class="text-center text-muted py-2" id="reschedule-history-empty">Chưa có lượt thay đổi nào.</div>
                            <div id="reschedule-history-list"></div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" id="btn-submit-reschedule" class="btn btn-primary btn-sm px-3 fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i>Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>

<dialog id="reception-payment-dialog" class="reception-payment-dialog" aria-labelledby="reception-payment-title">
    <form method="dialog" class="reception-payment-card">
        <header><div><span class="reception-panel-kicker payment">POS nhanh</span><h2 id="reception-payment-title">Thanh toán</h2></div><button class="btn-close" value="cancel" aria-label="Đóng"></button></header>
        <div id="reception-payment-summary" class="reception-payment-summary"></div>
        <div class="reception-pos-lines"><div class="reception-pos-lines-heading"><span>Dịch vụ</span><span>Giá</span></div><div id="reception-payment-lines"></div><button id="reception-payment-add-service" class="btn btn-outline-primary btn-sm mt-2" type="button"><i class="bi bi-plus-lg"></i> Thêm dịch vụ phát sinh</button></div>
        <section class="reception-promotion-box" aria-labelledby="reception-promotion-title">
            <label id="reception-promotion-title" class="form-label" for="reception-promotion-code"><i class="bi bi-ticket-perforated"></i> Mã giảm giá</label>
            <div class="input-group"><input id="reception-promotion-code" class="form-control text-uppercase" maxlength="64" autocomplete="off" placeholder="Ví dụ: SUMMER10" /><button id="reception-promotion-apply" class="btn btn-outline-primary" type="button">Áp dụng</button></div>
            <p id="reception-promotion-message" class="small mt-2 mb-0 d-none" role="status"></p>
        </section>
        <div class="reception-pos-totals" aria-label="Tổng kết phiếu tính tiền"><div><span>Tổng tiền gốc</span><strong id="reception-payment-subtotal">0 đ</strong></div><div><span>Giảm giá</span><strong id="reception-payment-discount">−0 đ</strong></div><div class="reception-pos-net"><span>Tổng thực thu</span><strong id="reception-payment-total">0 đ</strong></div></div>
        <label class="form-label" for="reception-payment-method">Phương thức thanh toán</label>
        <select id="reception-payment-method" class="form-select"><option value="Cash">Tiền mặt</option><option value="Transfer">Chuyển khoản</option><option value="Card">Thẻ</option></select>
        <div id="reception-payment-reference-wrap" class="mt-3"><label id="reception-payment-reference-label" class="form-label" for="reception-payment-reference">Mã giao dịch / ghi chú đối soát</label><input id="reception-payment-reference" class="form-control" placeholder="Tự động tạo khi chọn chuyển khoản" /><div id="reception-payment-reference-help" class="form-text">Mã sẽ được tạo tự động khi thanh toán chuyển khoản.</div></div>
        <p id="reception-payment-message" class="small mt-3 mb-0 d-none" role="status"></p>
        <footer><button class="btn btn-light" value="cancel" type="submit">Để sau</button><button id="reception-invoice-save" class="btn btn-outline-primary" type="button"><i class="bi bi-floppy"></i> Lưu hóa đơn</button><button id="reception-payment-submit" class="btn btn-success" type="button"><i class="bi bi-check2-circle"></i> Xác nhận thu tiền</button></footer>
    </form>
</dialog>

<dialog id="reception-payment-confirm-dialog" class="reception-payment-confirm-dialog" aria-labelledby="reception-payment-confirm-title">
    <form method="dialog" class="reception-payment-confirm-card">
        <header><div><span class="reception-panel-kicker payment">Xác nhận cuối</span><h2 id="reception-payment-confirm-title">Xác nhận thanh toán</h2></div><button class="btn-close" value="cancel" aria-label="Đóng"></button></header>
        <p>Vui lòng kiểm tra thông tin trước khi ghi nhận thu tiền.</p>
        <div class="reception-payment-confirm-summary"><div><span>Khách hàng</span><strong data-payment-confirm-customer>—</strong></div><div><span>Phương thức</span><strong data-payment-confirm-method>—</strong></div><div><span>Tổng thực thu</span><strong data-payment-confirm-total>—</strong></div></div>
        <footer><button class="btn btn-light border" value="cancel">Quay lại</button><button id="reception-payment-confirm-submit" class="btn btn-success" type="button"><i class="bi bi-check2-circle"></i> Xác nhận thanh toán</button></footer>
    </form>
</dialog>

<dialog id="reception-counter-dialog" class="reception-counter-dialog" aria-labelledby="reception-counter-title">
    <section class="reception-counter-card">
        <header><div><span class="reception-panel-kicker"><i class="bi bi-person-plus"></i> Tiếp nhận nhanh</span><h2 id="reception-counter-title">Đặt lịch tại quầy</h2></div><button id="reception-counter-close" class="btn-close" type="button" aria-label="Đóng"></button></header>
        <iframe id="reception-counter-frame" title="Đặt lịch tại quầy"></iframe>
    </section>
</dialog>

<!-- Toast thông báo kết quả -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
    <!-- Toast thành công -->
    <div id="reception-toast" class="toast align-items-center text-bg-success border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="reception-toast-message">
                Thao tác thành công.
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
    <!-- Toast lỗi (AC1 Drag & Drop) -->
    <div id="reception-toast-error" class="toast align-items-center text-bg-danger border-0 shadow-lg mt-2" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="reception-toast-error-message">
                Đã xảy ra lỗi khi thực hiện thao tác.
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<style>
    .appointment-card.draggable-card {
        cursor: grab;
        transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.2s ease;
    }
    .appointment-card.draggable-card:hover {
        box-shadow: 0 4px 10px rgba(0,0,0,0.12) !important;
        transform: translateY(-2px);
    }
    .appointment-card.draggable-card:active {
        cursor: grabbing;
    }
    .appointment-card.dragging {
        opacity: 0.35 !important;
        border: 2px dashed #0d6efd !important;
        transform: scale(0.96) !important;
    }
    .drop-zone {
        min-height: 120px;
        transition: background-color 0.2s ease, border-color 0.2s ease;
    }
    .drop-zone.drop-target-valid {
        border: 2px dashed #198754 !important;
        background-color: #f0fdf4 !important;
    }
    .drop-zone.drop-target-invalid {
        border: 2px dashed #dc3545 !important;
        background-color: #fef2f2 !important;
    }
</style>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script src="~/js/reception-calendar.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            SalonAuth.requireSession({
                endpoint: "/api/portal/reception/session",
                contentId: "reception-content"
            });
            ReceptionCalendar.init();
        });
    </script>
}
