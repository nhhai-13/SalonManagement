@{
    ViewData["Title"] = "Không gian lễ tân";
}

<div id="reception-content" class="container d-none py-4">
    <div class="sl-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-5 border-bottom pb-4">
        <div>
            <span class="sl-eyebrow text-uppercase text-muted small fw-semibold">Không gian làm việc</span>
            <h1 class="sl-page-title h2 mb-1 mt-1 text-primary-dark">Lễ tân</h1>
            <p class="text-muted mb-0">Xin chào <strong data-session-email class="text-dark"></strong></p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <section class="card shadow-sm border-warning border-2" aria-labelledby="pending-appointments-title">
                <div class="card-header bg-warning-subtle d-flex flex-wrap align-items-center justify-content-between gap-2 py-3">
                    <div>
                        <span class="text-uppercase small fw-semibold text-warning-emphasis">Cần xử lý</span>
                        <h2 id="pending-appointments-title" class="h4 mb-0">Lịch chờ xác nhận</h2>
                    </div>
                    <span id="pending-appointments-count" class="badge text-bg-warning fs-6">0 lịch</span>
                </div>
                <div class="card-body p-0">
                    <div id="pending-appointments-loading" class="p-4 text-muted">Đang tải lịch chờ xác nhận...</div>
                    <div id="pending-appointments-error" class="alert alert-danger m-3 d-none" role="alert"></div>
                    <div class="table-responsive d-none" id="pending-appointments-table-wrap">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr><th>Khách hàng</th><th>Dịch vụ</th><th>Thợ</th><th>Thời gian</th><th>Trạng thái</th></tr>
                            </thead>
                            <tbody id="pending-appointments-list"></tbody>
                        </table>
                    </div>
                </div>
            </section>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm sl-card border-0 hover-lift">
                <div class="card-body p-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-calendar-check fs-1 text-primary"></i>
                    </div>
                    <h2 class="h5 mt-3 text-dark fw-bold">Lịch hẹn</h2>
                    <p class="text-muted mb-0">Theo dõi và sắp xếp lịch hẹn của khách hàng.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm sl-card border-0 hover-lift">
                <div class="card-body p-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-person-plus fs-1 text-primary"></i>
                    </div>
                    <h2 class="h5 mt-3 text-dark fw-bold">Tiếp nhận khách</h2>
                    <p class="text-muted mb-0">Hỗ trợ khách đến salon và cập nhật trạng thái phục vụ.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm sl-card border-0 hover-lift">
                <div class="card-body p-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-people fs-1 text-primary"></i>
                    </div>
                    <h2 class="h5 mt-3 text-dark fw-bold">Khách hàng</h2>
                    <p class="text-muted mb-0">Tra cứu thông tin và lịch sử đặt lịch.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script src="~/js/reception-pending-appointments.js" asp-append-version="true"></script>
    <script>
        SalonAuth.requireSession({ endpoint: "/api/portal/reception/session", contentId: "reception-content" })
            .then(() => ReceptionPendingAppointments.start());
    </script>
}
