@model IEnumerable<ServiceGroup>
@{ ViewData["Title"] = "Nhóm dịch vụ"; }
<div class="container my-4 sl-body">
    <div class="mb-3">
        <a href="/owner" class="text-decoration-none sl-btn sl-btn-ghost sl-btn-sm">← Về khu vực chủ tiệm</a>
    </div>

    <div class="sl-page-header d-flex justify-content-between align-items-center mb-3">
        <h1 class="sl-page-title">Nhóm dịch vụ</h1>
        <div class="d-flex gap-2">
            <a asp-controller="Services" asp-action="Index" class="btn btn-outline-secondary mb-3 sl-btn sl-btn-outline">Danh sách dịch vụ</a>
            <a asp-action="Create" class="btn btn-primary mb-3 sl-btn sl-btn-primary">Thêm nhóm</a>
        </div>
    </div>

    @if (TempData["Success"] is string success) { <div class="alert alert-success sl-alert sl-alert-success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger sl-alert sl-alert-danger" role="alert">@error</div> }
    
    <p class="text-muted">Nhóm có dịch vụ đang bán không thể xoá. Khi xoá nhóm, dịch vụ ngừng bán được giữ ở mục Chưa phân nhóm.</p>
    
    <div class="card shadow-sm sl-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0 sl-table">
                    <thead class="table-dark">
                        <tr>
                            <th>Tên nhóm</th>
                            <th>Thứ tự</th>
                            <th>Số dịch vụ</th>
                            <th>Đang bán</th>
                            <th style="width: 200px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in Model)
                        {
                            <tr>
                                <td><strong>@group.GroupName</strong></td>
                                <td>@group.DisplayOrder</td>
                                <td>@group.Services.Count</td>
                                <td>@group.Services.Count(s => s.IsActive)</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@group.ServiceGroupId" class="btn btn-sm btn-outline-primary sl-btn sl-btn-outline sl-btn-sm">Sửa</a>
                                    <form asp-action="Delete" asp-route-id="@group.ServiceGroupId" method="post" class="d-inline" onsubmit="return confirm('Xoá nhóm dịch vụ này?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger sl-btn sl-btn-danger sl-btn-sm">Xoá</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any()) { 
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4 sl-table-empty">Chưa có nhóm dịch vụ.</td>
                            </tr> 
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
