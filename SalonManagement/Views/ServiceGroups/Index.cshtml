@model IEnumerable<ServiceGroup>
@{ ViewData["Title"] = "Nhóm dịch vụ"; }
<div class="container my-4">
    <a href="/owner">← Về khu vực chủ tiệm</a>
    <h1>Nhóm dịch vụ</h1>
    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    <a asp-action="Create" class="btn btn-primary mb-3">Thêm nhóm</a>
    <a asp-controller="Services" asp-action="Index" class="btn btn-outline-secondary mb-3">Danh sách dịch vụ</a>
    <p>Nhóm có dịch vụ đang bán không thể xoá. Khi xoá nhóm, dịch vụ ngừng bán được giữ ở mục Chưa phân nhóm.</p>
    <div class="table-responsive"><table class="table table-striped">
        <thead><tr><th>Tên nhóm</th><th>Thứ tự</th><th>Số dịch vụ</th><th>Đang bán</th><th>Thao tác</th></tr></thead>
        <tbody>
        @foreach (var group in Model)
        {
            <tr><td>@group.GroupName</td><td>@group.DisplayOrder</td><td>@group.Services.Count</td><td>@group.Services.Count(s => s.IsActive)</td><td>
                <a asp-action="Edit" asp-route-id="@group.ServiceGroupId" class="btn btn-sm btn-outline-primary">Sửa</a>
                <form asp-action="Delete" asp-route-id="@group.ServiceGroupId" method="post" class="d-inline" onsubmit="return confirm('Xoá nhóm dịch vụ này?');"><button type="submit" class="btn btn-sm btn-outline-danger">Xoá</button></form>
            </td></tr>
        }
        @if (!Model.Any()) { <tr><td colspan="5">Chưa có nhóm dịch vụ.</td></tr> }
        </tbody>
    </table></div>
</div>
