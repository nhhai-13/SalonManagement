@model IReadOnlyList<SalonManagement.Models.StagingEmailMessage>
@{ ViewData["Title"] = "Email mô phỏng"; }
<div class="container py-4"><h1 class="h3">Email mô phỏng</h1><p class="text-secondary">Staging không gửi SMTP; danh sách ghi lại loại email và người nhận để xác nhận luồng.</p><div class="table-responsive"><table class="table"><thead><tr><th>Thời điểm</th><th>Loại</th><th>Người nhận</th><th>Kết quả</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td><td>@item.Template</td><td>@item.Recipient</td><td>@if (item.Template == "review-request" && Uri.IsWellFormedUriString(item.Summary, UriKind.Absolute)) { <a href="@item.Summary">Mở liên kết đánh giá</a> } else { @item.Summary }</td></tr> }@if (Model.Count == 0) { <tr><td colspan="4" class="text-center text-secondary">Chưa có email mô phỏng nào.</td></tr> }</tbody></table></div><a asp-action="Index">Kịch bản demo</a></div>
