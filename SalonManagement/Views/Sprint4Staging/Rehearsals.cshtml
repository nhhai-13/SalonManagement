@model IReadOnlyList<SalonManagement.Models.RehearsalRun>
@{ ViewData["Title"] = "Nhật ký diễn tập"; }
<div class="container py-4"><h1 class="h3">Nhật ký diễn tập</h1><div class="d-flex gap-2 mb-3"><a asp-action="Index">Kịch bản demo</a><a asp-action="Health">Kiểm tra staging</a></div>
    @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
    <form asp-action="CreateRun" method="post" class="d-flex gap-2 mb-4">@Html.AntiForgeryToken()<input type="hidden" name="nextStep" value="@ViewBag.Step" /><input class="form-control" name="notes" maxlength="1000" placeholder="Ghi chú lần diễn tập" /><button class="btn btn-primary" type="submit">Tạo lần diễn tập</button></form>
    @foreach (var run in Model) { var unresolved = run.Issues.Count(issue => issue.Severity == "Blocker" && issue.Status is not ("Retested" or "Accepted")); <section class="card card-body mb-3"><h2 class="h5">Lần diễn tập · @run.PerformedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @run.PerformedBy</h2><p>@run.Notes</p><p class="@(unresolved > 0 ? "text-danger fw-bold" : "text-secondary")">Lỗi chặn demo chưa xử lý: @unresolved · Tổng lỗi: @run.Issues.Count</p><div class="small text-secondary mb-3">Mới: @run.Issues.Count(issue => issue.Status == "New") · Đang sửa: @run.Issues.Count(issue => issue.Status == "InProgress") · Đã sửa: @run.Issues.Count(issue => issue.Status == "Fixed") · Đã xác nhận lại: @run.Issues.Count(issue => issue.Status == "Retested") · Chấp nhận: @run.Issues.Count(issue => issue.Status == "Accepted")</div>
        <form asp-action="AddIssue" method="post" class="row g-2 mb-3">@Html.AntiForgeryToken()<input type="hidden" name="runId" value="@run.RehearsalRunId" /><div class="col-md-2"><input class="form-control" name="step" maxlength="200" value="@ViewBag.Step" required placeholder="Bước kịch bản" /></div><div class="col-md-2"><input class="form-control" name="account" maxlength="128" value="@ViewBag.Account" required placeholder="Tài khoản" /></div><div class="col-md-4"><input class="form-control" name="observation" maxlength="2000" required placeholder="Hiện tượng" /></div><div class="col-md-2"><select class="form-select" name="severity"><option value="Normal">Thường</option><option value="Blocker">Chặn demo</option><option value="Minor">Nhẹ</option></select></div><div class="col-md-1"><input class="form-control" name="assignee" maxlength="256" placeholder="Người xử lý" /></div><div class="col-md-1"><button class="btn btn-outline-primary" type="submit">Thêm</button></div></form>
        @foreach (var issue in run.Issues.OrderBy(issue => issue.RehearsalIssueId)) { <div class="border-top py-2"><strong class="@(issue.Severity == "Blocker" && issue.Status is not ("Retested" or "Accepted") ? "text-danger" : "")">@issue.Step · @issue.Severity</strong> — @issue.Observation <span class="small text-secondary">(@issue.Account · @issue.Assignee · @issue.Status @(issue.LastChangedAt is null ? "" : $"· {issue.LastChangedBy} · {issue.LastChangedAt:dd/MM/yyyy HH:mm}"))</span><form asp-action="ChangeIssueStatus" method="post" class="d-inline-flex ms-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@issue.RehearsalIssueId" /><select class="form-select form-select-sm" name="status"><option value="InProgress">Đang sửa</option><option value="Fixed">Đã sửa</option><option value="Retested">Đã xác nhận lại</option><option value="Accepted">Chấp nhận không sửa</option></select><button class="btn btn-sm btn-outline-secondary" type="submit">Cập nhật</button></form></div> }
    </section> }
    @if (Model.Count == 0) { <p class="text-secondary">Chưa có lần diễn tập nào; tạo lần mới để ghi lỗi theo từng bước.</p> }
</div>
