@model SalonManagement.Controllers.Admin.StagingHealthViewModel
@{ ViewData["Title"] = "Kiểm tra staging"; }
<div class="container py-4"><h1 class="h3">Kiểm tra staging</h1>@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }<div class="alert @(Model.DatabaseConnected ? "alert-success" : "alert-danger")">Cơ sở dữ liệu: @(Model.DatabaseConnected ? "Kết nối được" : "Không kết nối được")</div><p>Phiên bản: <code>@Model.Version</code></p><p>Email: @Model.EmailMode</p><table class="table"><thead><tr><th>Loại dữ liệu</th><th>Số bản ghi</th></tr></thead><tbody>@foreach (var item in Model.Counts) { <tr><td>@item.Key</td><td>@item.Value</td></tr> }</tbody></table><a asp-action="Index">Kịch bản demo</a> · <a asp-action="Emails">Email mô phỏng</a><form asp-action="ResetDemo" method="post" class="mt-4" onsubmit="return confirm('Nạp lại và ghi đè dữ liệu mẫu Sprint 4?')">@Html.AntiForgeryToken()<button class="btn btn-outline-danger" type="submit">Nạp lại dữ liệu mẫu</button></form></div>
