+@using SalonManagement.Models
+@{ ViewData["Title"] = "Tạo lịch tại quầy"; var services = (IReadOnlyList<Service>)ViewBag.Services; var stylists = (IReadOnlyList<Stylist>)ViewBag.Stylists; }
+<div class="container py-4" style="max-width:700px"><h1 class="h3">Tạo lịch tại quầy</h1><div id="message" class="alert d-none"></div><div id="customer-history" class="alert alert-info d-none"></div><form id="counter-form" class="row g-3"><div class="col-md-6"><label class="form-label">Tên khách</label><input id="name" class="form-control" required /></div><div class="col-md-6"><label class="form-label">Số điện thoại</label><input id="phone" class="form-control" required /></div><div class="col-md-6"><label class="form-label">Dịch vụ</label><select id="services" class="form-select" multiple required>@foreach(var service in services){<option value="@service.ServiceId">@service.ServiceName</option>}</select></div><div class="col-md-6"><label class="form-label">Thợ</label><select id="stylist" class="form-select" required><option value="">Chọn thợ</option>@foreach(var stylist in stylists){<option value="@stylist.StylistId">@stylist.FullName</option>}</select></div><div class="col-md-6"><label class="form-label">Ngày</label><input id="date" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div><div class="col-md-6"><label class="form-label">Giờ bắt đầu</label><input id="time" type="time" step="900" class="form-control" required /></div><div class="col-12"><button class="btn btn-primary">Tạo lịch</button></div></form></div>
+@section Scripts {<script>const phoneEl=document.getElementById('phone'),nameEl=document.getElementById('name'),historyEl=document.getElementById('customer-history');if(!document.getElementById('time').value)document.getElementById('time').value=new Date().toTimeString().slice(0,5);phoneEl.addEventListener('change',async()=>{const r=await fetch(`customer?phone=${encodeURIComponent(phoneEl.value)}`),x=await r.json();if(r.ok&&x.found){nameEl.value=x.fullName;historyEl.textContent=`Khách quen: ${x.fullName}. Dịch vụ gần nhất: ${x.history.map(h=>`${h.date} – ${h.services.join(', ')}`).join('; ')}`;historyEl.classList.remove('d-none')}else historyEl.classList.add('d-none')});document.getElementById('counter-form').addEventListener('submit',async e=>{e.preventDefault();const d=document.getElementById('date').value,t=document.getElementById('time').value,m=document.getElementById('message');const body={fullName:name.value,phone:phone.value,serviceIds:[...services.selectedOptions].map(x=>+x.value),stylistId:+stylist.value,date:d,startTime:t+':00'};const r=await fetch('create',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}),x=await r.json();m.textContent=x.error||x.message;m.className='alert '+(r.ok?'alert-success':'alert-danger');if(r.ok)setTimeout(()=>location.href=x.redirect,500)})</script>}
