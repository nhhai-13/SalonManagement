--- /dev/null
+++ b/SalonManagement/Controllers/Stylist/StylistScheduleController.cs
@@ -0,0 +1,41 @@
+using System.Security.Claims;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.EntityFrameworkCore;
+using SalonManagement.Data;
+using SalonManagement.Models;
+
+namespace SalonManagement.Controllers.StylistPortal;
+
+[Authorize(Roles = UserRoles.Stylist)]
+[Route("stylist/schedule")]
+public sealed class StylistScheduleController(ApplicationDbContext db) : Controller
+{
+    [HttpGet("")]
+    public async Task<IActionResult> Index(DateTime? date)
+    {
+        var email = User.FindFirstValue(ClaimTypes.Email) ?? User.Identity?.Name;
+        var stylist = await db.Stylists.AsNoTracking().SingleOrDefaultAsync(item => item.Email == email && item.IsActive);
+        if (stylist is null) return Forbid();
+        var selected = (date ?? DateTime.Today).Date;
+        var appointments = await db.Appointments.AsNoTracking().Include(item => item.Customer).Include(item => item.AppointmentServices).ThenInclude(item => item.Service)
+            .Where(item => item.StylistId == stylist.StylistId && item.AppointmentDate == selected)
+            .OrderBy(item => item.StartTime).ToListAsync();
+        return View((stylist.FullName, selected, appointments));
+    }
+
+    [HttpPost("{appointmentId:int}/start")]
+    public Task<IActionResult> Start(int appointmentId) => ChangeStatus(appointmentId, "Arrived", "InProgress", true);
+    [HttpPost("{appointmentId:int}/complete")]
+    public Task<IActionResult> Complete(int appointmentId) => ChangeStatus(appointmentId, "InProgress", "Completed", false);
+
+    private async Task<IActionResult> ChangeStatus(int appointmentId, string expected, string next, bool starting)
+    {
+        var email = User.FindFirstValue(ClaimTypes.Email) ?? User.Identity?.Name;
+        var stylist = await db.Stylists.SingleOrDefaultAsync(item => item.Email == email && item.IsActive);
+        var appointment = stylist is null ? null : await db.Appointments.SingleOrDefaultAsync(item => item.AppointmentId == appointmentId && item.StylistId == stylist.StylistId);
+        if (appointment is null) return NotFound();
+        if (appointment.Status != expected) return BadRequest(new { error = "Trạng thái lịch hẹn không hợp lệ." });
+        appointment.Status = next;
+        if (starting) appointment.ActualStartedAt = DateTime.Now; else appointment.ActualCompletedAt = DateTime.Now;
+        appointment.UpdatedAt = DateTime.Now;
+        await db.SaveChangesAsync();
+        return Ok(new { appointment.Status });
+    }
+}
diff --git a/SalonManagement/Views/StylistSchedule/Index.cshtml b/SalonManagement/Views/StylistSchedule/Index.cshtml
new file mode 100644
--- /dev/null
+++ b/SalonManagement/Views/StylistSchedule/Index.cshtml
@@ -0,0 +1,25 @@
+@model (string Name, DateTime Date, IReadOnlyList<SalonManagement.Models.Appointment> Appointments)
+@{ ViewData["Title"] = "Lịch làm việc"; }
+<div class="container py-4">
+    <h1 class="h3">Lịch của @Model.Name · @Model.Date.ToString("dd/MM/yyyy")</h1>
+    <div class="list-group">
+    @foreach (var appointment in Model.Appointments)
+    {
+        var standard = appointment.AppointmentServices.Sum(item => item.DurationMinutes);
+        var actual = appointment.ActualStartedAt.HasValue && appointment.ActualCompletedAt.HasValue
+            ? (int?)(appointment.ActualCompletedAt.Value - appointment.ActualStartedAt.Value).TotalMinutes : null;
+        <article class="list-group-item">
+            <strong>@appointment.StartTime.ToString(@"hh\:mm")–@appointment.EndTime.ToString(@"hh\:mm") · @appointment.Customer.FullName</strong><br />
+            <small>@string.Join(", ", appointment.AppointmentServices.Select(item => item.Service.ServiceName)) · @standard phút · @appointment.Status</small>
+            @if (actual.HasValue)
+            {
+                <div class="text-muted">
+                    Bắt đầu: @appointment.ActualStartedAt!.Value.ToString("HH:mm") ·
+                    Hoàn tất: @appointment.ActualCompletedAt!.Value.ToString("HH:mm") ·
+                    Thực tế: @actual phút (@(actual - standard >= 0 ? "+" : "")@(actual - standard) phút)
+                </div>
+            }
+        </article>
+    }
+    </div>
+</div>
