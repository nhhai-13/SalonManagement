<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- NuGet global cache (offline) -->
    <add key="NuGetGlobalCache" value="%USERPROFILE%\.nuget\packages" />
    <!-- Visual Studio offline packages (MSTest, coverlet, Net.Test.Sdk) -->
    <add key="VSOffline" value="C:\Program Files (x86)\Microsoft SDKs\NuGetPackages\" />
  </packageSources>
  <!-- Xóa fallbackPackageFolders để tránh lỗi NU1301 với D:\mmt\NuGetPackages không tồn tại -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSourceMapping>
    <packageSource key="NuGetGlobalCache">
      <package pattern="*" />
    </packageSource>
    <packageSource key="VSOffline">
      <package pattern="coverlet.*" />
      <package pattern="Microsoft.NET.Test.Sdk" />
      <package pattern="Microsoft.TestPlatform.*" />
      <package pattern="Microsoft.CodeCoverage" />
      <package pattern="MSTest.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
