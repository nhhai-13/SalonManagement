<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- NuGet global cache (offline) - chứa các package đã cài qua dotnet/VS -->
    <add key="NuGetGlobalCache" value="%USERPROFILE%\.nuget\packages" />
    <!-- Visual Studio offline packages -->
    <add key="Microsoft Visual Studio Offline Packages" value="C:\Program Files (x86)\Microsoft SDKs\NuGetPackages\" />
  </packageSources>
  <!-- Xóa fallbackPackageFolders để tránh lỗi NU1301 với D:\mmt\NuGetPackages không tồn tại -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSourceMapping>
    <packageSource key="NuGetGlobalCache">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
