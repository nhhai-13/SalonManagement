<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- NuGet global cache (offline) -->
    <add key="NuGetGlobalCache" value="%USERPROFILE%\.nuget\packages" />
    <!-- Visual Studio offline packages (MSTest, coverlet, Net.Test.Sdk) -->
    <add key="VSOffline" value="C:\Program Files (x86)\Microsoft SDKs\NuGetPackages\" />
  </packageSources>
  <!-- Xóa fallbackPackageFolders để tránh lỗi NU1301 với D:\mmt\NuGetPackages không tồn tại -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
